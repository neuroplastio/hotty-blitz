index 00000000..ebaa5e43
--- /dev/null
+++ b/packages/blitz-dom/src/svg_image.rs
@@ -0,0 +1,184 @@
+//! The images an inline `<svg>` draws with `<image href>`: fetched through
+//! the document's `NetProvider`, as an `<img>`'s are, and handed to usvg
+//! when it parses the `<svg>`.
+//!
+//! usvg resolves an `<image>`'s href as it parses, synchronously, and Blitz
+//! parses an inline `<svg>` while it constructs boxes. So an `<image>` is
+//! fetched when it joins the document or its href changes, like an `<img>`;
+//! its bytes are kept by URL; and when they arrive, the `<svg>` it is in is
+//! constructed, and so parsed, again. `data:` URLs are left to usvg.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use markup5ever::ns;
+
+use crate::layout::damage::ALL_DAMAGE;
+use crate::net::{ResourceHandler, SvgImageHandler};
+use crate::{BaseDocument, Node, NodeId};
+
+/// An image `<image>` elements refer to, by its resolved URL.
+#[derive(Default)]
+pub(crate) struct SvgImage {
+    /// Its bytes, once they arrived (empty: it failed).
+    bytes: Option<Arc<Vec<u8>>>,
+    /// The `<image>` elements that showed it, to construct again.
+    users: Vec<NodeId>,
+}
+
+/// Whether `node` is an SVG `<image>`.
+fn is_svg_image(node: &Node) -> bool {
+    node.element_data()
+        .is_some_and(|e| e.name.ns == ns!(svg) && e.name.local.as_ref() == "image")
+}
+
+/// The hrefs of an SVG `<image>` that are fetched: `href` and `xlink:href`,
+/// except `data:` URLs, which usvg decodes itself.
+fn hrefs(node: &Node) -> impl Iterator<Item = &str> {
+    node.attrs()
+        .into_iter()
+        .flatten()
+        .filter(|a| a.name.local.as_ref() == "href")
+        .map(|a| a.value.as_str())
+        .filter(|v| {
+            let v = v.trim_start();
+            !v.is_empty() && !v.get(..5).is_some_and(|s| s.eq_ignore_ascii_case("data:"))
+        })
+}
+
+impl BaseDocument {
+    /// The outermost `<svg>` that `node` is in: the element Blitz parses.
+    fn outermost_svg(&self, node: NodeId) -> Option<NodeId> {
+        let mut found = None;
+        let mut current = Some(node);
+        while let Some(id) = current {
+            let node = self.get_node(id)?;
+            let Some(el) = node.element_data() else {
+                break;
+            };
+            if el.name.ns != ns!(svg) {
+                break;
+            }
+            if el.name.local.as_ref() == "svg" {
+                found = Some(id);
+            }
+            current = node.parent;
+        }
+        found
+    }
+
+    /// Construct the `<svg>` that `<image>` node `image` is in again, so
+    /// that it is parsed with what its images have now.
+    fn reconstruct_svg_of(&mut self, image: NodeId) {
+        if let Some(svg) = self.outermost_svg(image) {
+            let node = &mut self.nodes[svg];
+            node.clear_layout_cache();
+            node.insert_damage(ALL_DAMAGE);
+        }
+    }
+
+    /// `<image>` node `image` joined the document or changed its href:
+    /// fetch what it refers to, unless it is known already.
+    pub(crate) fn load_svg_image(&mut self, image: NodeId) {
+        let Some(node) = self.get_node(image) else {
+            return;
+        };
+        if !is_svg_image(node) {
+            return;
+        }
+        let urls: Vec<url::Url> = hrefs(node)
+            .filter_map(|href| self.url.resolve_relative(href))
+            .collect();
+        let mut known = false;
+        for url in urls {
+            let entry = self.svg_images.entry(url.to_string()).or_default();
+            if !entry.users.contains(&image) {
+                entry.users.push(image);
+            }
+            if entry.users.len() > 1 || entry.bytes.is_some() {
+                // Fetched, or being fetched, for another <image>.
+                known |= entry.bytes.is_some();
+                continue;
+            }
+            self.fetch_svg_image(url);
+        }
+        if known {
+            self.reconstruct_svg_of(image);
+        }
+    }
+
+    fn fetch_svg_image(&mut self, url: url::Url) {
+        self.net_provider.fetch(
+            self.id(),
+            self.build_request(url, blitz_traits::net::Destination::Image),
+            ResourceHandler::boxed(
+                self.tx.clone(),
+                self.id(),
+                None,
+                self.shell_provider.clone(),
+                SvgImageHandler,
+            ),
+        );
+    }
+
+    /// What an `<image>` refers to arrived from `url`: every `<svg>` that
+    /// shows it is constructed again.
+    pub(crate) fn svg_image_loaded(&mut self, url: &str, bytes: Arc<Vec<u8>>) {
+        let Some(entry) = self.svg_images.get_mut(url) else {
+            return;
+        };
+        entry.bytes = Some(bytes);
+        let users = std::mem::take(&mut entry.users);
+        let users: Vec<NodeId> = users
+            .into_iter()
+            .filter(|&id| {
+                self.get_node(id)
+                    .is_some_and(|n| n.flags.is_in_document() && is_svg_image(n))
+            })
+            .collect();
+        for &image in &users {
+            self.reconstruct_svg_of(image);
+        }
+        if let Some(entry) = self.svg_images.get_mut(url) {
+            entry.users = users;
+        }
+    }
+
+    /// `href` was sent again (a resource replaced, say): an image it names
+    /// is fetched again, and shown when it arrives.
+    pub(crate) fn reload_svg_image(&mut self, href: &str) {
+        let Some(url) = self.url.resolve_relative(href) else {
+            return;
+        };
+        if self.svg_images.contains_key(url.as_str()) {
+            self.fetch_svg_image(url);
+        }
+    }
+
+    /// The images the `<image>` elements under `<svg>` node `svg` refer to
+    /// and have, by href as written: what usvg asks for as it parses.
+    pub(crate) fn svg_images_under(&self, svg: NodeId) -> HashMap<String, Arc<Vec<u8>>> {
+        let mut out = HashMap::new();
+        let mut stack = vec![svg];
+        while let Some(id) = stack.pop() {
+            let Some(node) = self.get_node(id) else {
+                continue;
+            };
+            stack.extend(node.children.iter().copied());
+            if !is_svg_image(node) {
+                continue;
+            }
+            for href in hrefs(node) {
+                let bytes = self
+                    .url
+                    .resolve_relative(href)
+                    .and_then(|url| self.svg_images.get(url.as_str())?.bytes.clone())
+                    .filter(|b| !b.is_empty());
+                if let Some(bytes) = bytes {
+                    out.insert(href.to_string(), bytes);
+                }
+            }
+        }
+        out
+    }
+}
