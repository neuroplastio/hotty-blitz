--- /dev/null
+++ b/packages/blitz-dom/src/image_source.rs
@@ -0,0 +1,258 @@
+//! Which URL an `<img>` shows: HTML's "select an image source", for
+//! `srcset`, `sizes` and the `<source>` elements of a `<picture>`.
+//!
+//! <https://html.spec.whatwg.org/multipage/images.html#select-an-image-source>
+
+use cssparser::{Parser, ParserInput};
+use selectors::matching::QuirksMode;
+use style::media_queries::MediaList;
+use style::parser::ParserContext;
+use style::stylesheets::{CssRuleType, CustomMediaEvaluator, Origin};
+use style::values::specified::source_size_list::SourceSizeList;
+use style_traits::ParsingMode;
+
+use crate::{BaseDocument, Node, NodeId, local_name};
+
+/// How a candidate of a `srcset` says what it is for.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Descriptor {
+    /// `2x`: pixels per CSS px.
+    Density(f32),
+    /// `640w`: its width in pixels, against the `sizes` it is shown at.
+    Width(f32),
+}
+
+/// The candidates of a `srcset`: each URL with its descriptor (1x when it
+/// has none). Candidates with a descriptor that does not parse are dropped.
+fn parse_srcset(srcset: &str) -> Vec<(&str, Descriptor)> {
+    let mut out = Vec::new();
+    let mut rest = srcset;
+    loop {
+        rest = rest.trim_start_matches(|c: char| c.is_ascii_whitespace() || c == ',');
+        if rest.is_empty() {
+            return out;
+        }
+        let end = rest
+            .find(|c: char| c.is_ascii_whitespace())
+            .unwrap_or(rest.len());
+        let (mut url, after) = rest.split_at(end);
+        rest = after;
+        let mut descriptors = "";
+        if url.ends_with(',') {
+            url = url.trim_end_matches(',');
+        } else {
+            // Descriptors run to the next comma outside parentheses.
+            let mut depth = 0;
+            let end = rest
+                .char_indices()
+                .find(|&(_, c)| {
+                    match c {
+                        '(' => depth += 1,
+                        ')' => depth -= 1,
+                        _ => {}
+                    }
+                    c == ',' && depth <= 0
+                })
+                .map_or(rest.len(), |(i, _)| i);
+            descriptors = &rest[..end];
+            rest = &rest[end..];
+        }
+        if url.is_empty() {
+            continue;
+        }
+        let mut descriptor = None;
+        let mut valid = true;
+        for d in descriptors.split_ascii_whitespace() {
+            let parsed = if let Some(x) = d.strip_suffix('x') {
+                x.parse()
+                    .ok()
+                    .filter(|x: &f32| *x > 0.0)
+                    .map(Descriptor::Density)
+            } else if let Some(w) = d.strip_suffix('w') {
+                w.parse()
+                    .ok()
+                    .filter(|w: &f32| *w > 0.0)
+                    .map(Descriptor::Width)
+            } else if d
+                .strip_suffix('h')
+                .is_some_and(|h| h.parse::<f32>().is_ok())
+            {
+                // A height descriptor: allowed, and of no use here.
+                continue;
+            } else {
+                None
+            };
+            match parsed {
+                Some(p) if descriptor.is_none() => descriptor = Some(p),
+                _ => valid = false,
+            }
+        }
+        if valid {
+            out.push((url, descriptor.unwrap_or(Descriptor::Density(1.0))));
+        }
+    }
+}
+
+impl BaseDocument {
+    /// The URL `<img>` node `img` shows, as written (unresolved): from the
+    /// first `<source>` of its `<picture>` whose `type` this build decodes
+    /// and whose `media` matches, else from its own `srcset`, else its `src`.
+    /// Of a `srcset`, the candidate with the smallest density at or above
+    /// the device's, else the densest; a `w` candidate's density is its
+    /// width over the size `sizes` gives it.
+    pub fn image_source(&self, img: NodeId) -> Option<String> {
+        let node = self.get_node(img)?;
+        if let Some(parent) = node.parent.and_then(|p| self.get_node(p))
+            && parent
+                .element_data()
+                .is_some_and(|e| e.name.local == local_name!("picture"))
+        {
+            for &child in &parent.children {
+                if child == img {
+                    break;
+                }
+                let Some(source) = self.get_node(child) else {
+                    continue;
+                };
+                if !source
+                    .element_data()
+                    .is_some_and(|e| e.name.local == local_name!("source"))
+                {
+                    continue;
+                }
+                if let Some(t) = source.attr(local_name!("type"))
+                    && !decodes(t)
+                {
+                    continue;
+                }
+                if let Some(media) = source.attr(local_name!("media"))
+                    && !self.media_matches(media)
+                {
+                    continue;
+                }
+                if let Some(url) = self.pick(source, None) {
+                    return Some(url);
+                }
+            }
+        }
+        let src = node.attr(local_name!("src")).filter(|s| !s.is_empty());
+        self.pick(node, src).or_else(|| src.map(str::to_string))
+    }
+
+    /// The candidate of `node`'s `srcset` for this device. `src`, an
+    /// `<img>`'s, counts as a 1x candidate when no other is 1x.
+    fn pick(&self, node: &Node, src: Option<&str>) -> Option<String> {
+        let mut candidates = parse_srcset(node.attr(local_name!("srcset"))?);
+        if candidates.is_empty() {
+            return None;
+        }
+        let size = if candidates
+            .iter()
+            .any(|(_, d)| matches!(d, Descriptor::Width(_)))
+        {
+            self.source_size(node.attr(local_name!("sizes")).unwrap_or(""))
+        } else {
+            0.0
+        };
+        if let Some(src) = src
+            && !candidates
+                .iter()
+                .any(|(_, d)| *d == Descriptor::Density(1.0))
+        {
+            candidates.push((src, Descriptor::Density(1.0)));
+        }
+        let density = |d: Descriptor| match d {
+            Descriptor::Density(x) => x,
+            Descriptor::Width(w) if size > 0.0 => w / size,
+            Descriptor::Width(_) => f32::INFINITY,
+        };
+        let want = self.viewport.hidpi_scale * self.viewport.zoom;
+        let mut best: Option<(&str, f32)> = None;
+        for (url, d) in candidates {
+            let x = density(d);
+            best = match best {
+                None => Some((url, x)),
+                Some((_, b)) if (b < want && x > b) || (x >= want && x < b) => Some((url, x)),
+                keep => keep,
+            };
+        }
+        best.map(|(url, _)| url.to_string())
+    }
+
+    /// The width in CSS px an image is shown at by a `sizes` attribute.
+    fn source_size(&self, sizes: &str) -> f32 {
+        let url_data = self.url.url_extra_data();
+        let context = ParserContext::new(
+            Origin::Author,
+            &url_data,
+            Some(CssRuleType::Style),
+            ParsingMode::DEFAULT,
+            QuirksMode::NoQuirks,
+            Default::default(),
+            None,
+            None,
+            Default::default(),
+        );
+        let mut input = ParserInput::new(sizes);
+        let list = SourceSizeList::parse(&context, &mut Parser::new(&mut input));
+        list.evaluate(self.stylist.device(), QuirksMode::NoQuirks)
+            .to_f32_px()
+    }
+
+    /// Whether a `<source>`'s `media` matches the device.
+    fn media_matches(&self, media: &str) -> bool {
+        let url_data = self.url.url_extra_data();
+        let mut context = ParserContext::new(
+            Origin::Author,
+            &url_data,
+            Some(CssRuleType::Media),
+            ParsingMode::DEFAULT,
+            QuirksMode::NoQuirks,
+            Default::default(),
+            None,
+            None,
+            Default::default(),
+        );
+        let mut input = ParserInput::new(media);
+        let list = MediaList::parse(&mut context, &mut Parser::new(&mut input));
+        list.evaluate(
+            self.stylist.device(),
+            QuirksMode::NoQuirks,
+            &mut CustomMediaEvaluator::none(),
+        )
+    }
+}
+
+/// Whether this build decodes images of MIME type `t`.
+fn decodes(t: &str) -> bool {
+    let t = t.trim().to_ascii_lowercase();
+    if t == "image/svg+xml" {
+        return cfg!(feature = "svg");
+    }
+    image::ImageFormat::from_mime_type(&t).is_some_and(|f| f.reading_enabled())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Descriptor, parse_srcset};
+
+    #[test]
+    fn srcset_candidates() {
+        assert_eq!(
+            parse_srcset("a.png, b.png 2x,c.png 640w , d.png 1.5x 10h, bad.png 2q, e.png,"),
+            vec![
+                ("a.png", Descriptor::Density(1.0)),
+                ("b.png", Descriptor::Density(2.0)),
+                ("c.png", Descriptor::Width(640.0)),
+                ("d.png", Descriptor::Density(1.5)),
+                ("e.png", Descriptor::Density(1.0)),
+            ]
+        );
+        // A comma inside a URL stays in it.
+        assert_eq!(
+            parse_srcset("data:image/png;base64,AAAA 2x"),
+            vec![("data:image/png;base64,AAAA", Descriptor::Density(2.0))]
+        );
+        assert!(parse_srcset("  ,, ").is_empty());
+    }
+}
