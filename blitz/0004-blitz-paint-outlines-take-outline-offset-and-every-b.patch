+    /// Construct a new [`CssBox`] whose border is this box's outline: `offset`
+    /// outside the border box (inside it when negative), `outline_width` wide.
+    ///
+    /// A rounded corner grows by the offset and the width (shrinking to square
+    /// when that is negative); a square corner stays square. The outline can then
+    /// be drawn in any border style.
+    pub fn outline_ring(&self, offset: f64) -> CssBox {
+        let width = self.outline_width;
+        let grow = offset + width;
+        let grow_radius = |radius: Vec2| {
+            if radius.x > 0.0 && radius.y > 0.0 {
+                Vec2::new((radius.x + grow).max(0.0), (radius.y + grow).max(0.0))
+            } else {
+                Vec2::ZERO
+            }
+        };
+        let radii = NonUniformRoundedRectRadii {
+            top_left: grow_radius(self.border_radii.top_left),
+            top_right: grow_radius(self.border_radii.top_right),
+            bottom_right: grow_radius(self.border_radii.bottom_right),
+            bottom_left: grow_radius(self.border_radii.bottom_left),
+        };
 
-        path
+        CssBox::new(
+            self.border_box + Insets::uniform(grow),
+            Insets::uniform(width),
+            Insets::ZERO,
+            0.0,
+            radii,
+        )
     }
 
     /// Construct a bezpath drawing the frame border
@@ -324,7 +337,6 @@ impl CssBox {
 
     fn corner(&self, corner: Corner, css_box: CssBoxKind) -> Point {
         let Rect { x0, y0, x1, y1 } = match css_box {
-            CssBoxKind::OutlineBox => self.outline_box,
             CssBoxKind::BorderBox => self.border_box,
             CssBoxKind::PaddingBox => self.padding_box,
             CssBoxKind::ContentBox => self.content_box,
@@ -506,7 +518,6 @@ impl CssBox {
         }
 
         let css_box: Insets = match side {
-            OutlineBox => return false,
             BorderBox => return false,
             PaddingBox => self.border_width,
             ContentBox => add_insets(self.border_width, self.padding_width),
@@ -565,7 +576,6 @@ impl CssBox {
 
         let radii: Vec2 = match side {
             BorderBox => corner_radii,
-            OutlineBox => corner_radii + Vec2::new(self.outline_width, self.outline_width),
             PaddingBox => corner_radii - get_corner_insets(*border_width, corner),
             ContentBox => {
                 corner_radii - get_corner_insets(add_insets(*border_width, *padding_width), corner)
