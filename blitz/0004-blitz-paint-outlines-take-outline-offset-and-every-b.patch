-                Edge::Left => (&border.border_left_color, border.border_left_style),
-            };
-            let color = color.resolve_to_absolute(&current_color).as_srgb_color();
-
+        for (edge, color, edge_style) in edges {
             if color.components[3] <= 0.0 {
