             }
@@ -608,44 +635,48 @@ impl ElementCx<'_, '_> {
         }
     }
 
-    /// ❌ dotted - Defines a dotted border
-    /// ❌ dashed - Defines a dashed border
-    /// ✅ solid - Defines a solid border
-    /// ❌ double - Defines a double border
-    /// ❌ groove - Defines a 3D grooved border. The effect depends on the border-color value
-    /// ❌ ridge - Defines a 3D ridged border. The effect depends on the border-color value
-    /// ❌ inset - Defines a 3D inset border. The effect depends on the border-color value
-    /// ❌ outset - Defines a 3D outset border. The effect depends on the border-color value
-    /// ✅ none - Defines no border
-    /// ✅ hidden - Defines a hidden border
+    /// Draw the outline: the border of a box `outline-offset` outside the border
+    /// box (inside it when negative), so it takes every border style.
     pub(crate) fn draw_outline(&self, scene: &mut impl PaintScene) {
         let outline = self.style.get_outline();
 
+        let style = match outline.outline_style {
+            OutlineStyle::Auto => return,
+            OutlineStyle::BorderStyle(BorderStyle::None | BorderStyle::Hidden) => return,
+            OutlineStyle::BorderStyle(style) => style,
+        };
+
         let current_color = self.style.clone_color();
         let color = outline
             .outline_color
             .resolve_to_absolute(&current_color)
             .as_srgb_color();
+        if self.frame.outline_width <= 0.0 || color.components[3] <= 0.0 {
+            return;
+        }
 
-        let style = match outline.outline_style {
-            OutlineStyle::Auto => return,
-            OutlineStyle::BorderStyle(style) => style,
-        };
+        let offset = outline.outline_offset.to_f64_px() * self.scale;
+        let ring = self.frame.outline_ring(offset);
+        if ring.border_box.width() <= 0.0 || ring.border_box.height() <= 0.0 {
+            return;
+        }
 
-        let path = match style {
-            BorderStyle::None | BorderStyle::Hidden => return,
-            BorderStyle::Solid => self.frame.outline(),
-
-            // TODO: Implement other border styles
-            BorderStyle::Inset
-            | BorderStyle::Groove
-            | BorderStyle::Outset
-            | BorderStyle::Ridge
-            | BorderStyle::Dotted
-            | BorderStyle::Dashed
-            | BorderStyle::Double => self.frame.outline(),
-        };
+        // A solid outline is the ring in one fill: no seams where edges meet.
+        if style == BorderStyle::Solid {
+            let mut path = ring.border_box_path();
+            path.extend(ring.padding_box_path());
+            scene.fill(Fill::EvenOdd, self.transform, color, None, &path);
+            return;
+        }
 
-        scene.fill(Fill::NonZero, self.transform, color, None, &path);
+        let cx = ElementCx {
+            frame: ring,
+            style: self.style.clone(),
+            ..*self
+        };
+        cx.draw_border_edges(
+            scene,
+            [Edge::Top, Edge::Right, Edge::Bottom, Edge::Left].map(|edge| (edge, color, style)),
+        );
     }
 }
