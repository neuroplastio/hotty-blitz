@@ -2295,6 +2299,39 @@ impl BaseDocument {
         self.nodes.set_viewport_scroll(scroll);
     }
 
+    /// Lock scrolling along an axis, or unlock it. Along a locked axis nothing
+    /// scrolls, whoever asks (the user, a script, a fragment's navigation):
+    /// neither the viewport nor any element, and no scrollbar shows there. A
+    /// text input still scrolls its own text to follow the caret. Locking an
+    /// axis puts every scroll offset along it back to zero.
+    ///
+    /// For embedders that show a document in an area of a fixed size and
+    /// scroll it themselves, if at all, along some axes.
+    pub fn set_scroll_axes(&mut self, horizontal: bool, vertical: bool) {
+        self.scroll_axes = (horizontal, vertical);
+        let keep = |p: crate::Point<f64>| crate::Point {
+            x: if horizontal { p.x } else { 0.0 },
+            y: if vertical { p.y } else { 0.0 },
+        };
+        let viewport = keep(self.viewport_scroll());
+        self.set_viewport_scroll(viewport);
+        for (_, node) in self.nodes.iter_mut() {
+            if node.is_element() {
+                let offset = keep(*node.scroll_offset());
+                *node.scroll_offset_mut() = offset;
+            }
+        }
+        self.nodes.bump_geometry_generation();
+    }
+
+    /// Whether anything scrolls along `axis` ([`BaseDocument::set_scroll_axes`]).
+    pub fn scrolls_along(&self, axis: taffy::AbsoluteAxis) -> bool {
+        match axis {
+            taffy::AbsoluteAxis::Horizontal => self.scroll_axes.0,
+            taffy::AbsoluteAxis::Vertical => self.scroll_axes.1,
+        }
+    }
+
     /// Find the node targeted by a URL fragment (the `#...` part of a URL).
     ///
     /// Per the HTML spec, this is the element whose `id` matches the fragment, falling
diff --git a/packages/blitz-dom/src/scrolling.rs b/packages/blitz-dom/src/scrolling.rs
index 177e9d2e..4169ba89 100644
--- a/packages/blitz-dom/src/scrolling.rs
+++ b/packages/blitz-dom/src/scrolling.rs
@@ -441,6 +441,21 @@ impl BaseDocument {
         &self,
         target: ScrollTarget,
         include_hidden: bool,
+    ) -> (Point<f64>, Point<f64>) {
+        let (current, max) = self.unlocked_scroll_state(target, include_hidden);
+        // Nothing scrolls along a locked axis (`set_scroll_axes`).
+        let (x, y) = self.scroll_axes;
+        let max = Point {
+            x: if x { max.x } else { 0.0 },
+            y: if y { max.y } else { 0.0 },
+        };
+        (current, max)
+    }
