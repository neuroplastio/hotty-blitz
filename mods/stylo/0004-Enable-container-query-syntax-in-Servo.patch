From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Tue, 15 Sep 2026 21:19:03 +0100
Subject: [PATCH 4/9] Enable container query syntax in Servo

---
 style/properties/shorthands.rs      |  5 ++---
 style/properties/shorthands.toml    |  1 -
 style/stylesheets/rule_parser.rs    |  2 +-
 style/values/specified/length.rs    | 12 ++++++------
 stylo_static_prefs/preferences.toml |  2 +-
 5 files changed, 10 insertions(+), 12 deletions(-)

diff --git a/style/properties/shorthands.rs b/style/properties/shorthands.rs
index 0945ffa58..554324773 100644
--- a/style/properties/shorthands.rs
+++ b/style/properties/shorthands.rs
@@ -542,7 +542,6 @@ pub mod border {
     }
 }
 
-#[cfg(feature = "gecko")]
 pub mod container {
     use super::*;
     pub use crate::properties::generated::shorthands::container::*;
@@ -572,9 +571,9 @@ pub mod container {
             W: fmt::Write,
         {
             self.container_name.to_css(dest)?;
-            if !self.container_type.is_normal() {
+            if self.container_type.is_some_and(|value| !value.is_normal()) {
                 dest.write_str(" / ")?;
-                self.container_type.to_css(dest)?;
+                self.container_type.unwrap().to_css(dest)?;
             }
             Ok(())
         }
diff --git a/style/properties/shorthands.toml b/style/properties/shorthands.toml
index 016774da7..64707398c 100644
--- a/style/properties/shorthands.toml
+++ b/style/properties/shorthands.toml
@@ -209,7 +209,6 @@ spec = "https://wicg.github.io/overscroll-behavior/#overscroll-behavior-properti
 kind = "two_properties"
 
 [container]
-engine = "gecko"
 sub_properties = ["container-name", "container-type"]
 spec = "https://drafts.csswg.org/css-contain-3/#container-shorthand"
 
diff --git a/style/stylesheets/rule_parser.rs b/style/stylesheets/rule_parser.rs
index f66271806..36e841443 100644
--- a/style/stylesheets/rule_parser.rs
+++ b/style/stylesheets/rule_parser.rs
@@ -282,7 +282,7 @@ impl AtRuleType {
             "counter-style" if cfg!(feature = "gecko") => Self::CounterStyle,
             "media" => Self::Media,
             "custom-media" if crate::pref!("layout.css.custom-media.enabled") => Self::CustomMedia,
-            "container" if cfg!(feature = "gecko") => Self::Container,
+            "container" => Self::Container,
             "supports" => Self::Supports,
             "keyframes" => Self::Keyframes(None),
             "-webkit-keyframes" => Self::Keyframes(Some(VendorPrefix::WebKit)),
diff --git a/style/values/specified/length.rs b/style/values/specified/length.rs
index 4d547730a..41a0f4bec 100644
--- a/style/values/specified/length.rs
+++ b/style/values/specified/length.rs
@@ -188,12 +188,12 @@ impl LengthUnit {
             "dvi" if !in_page_rule => Self::Dvi,
             // Container query lengths. Inherit the limitation from viewport units since
             // we may fall back to them.
-            "cqw" if !in_page_rule && cfg!(feature = "gecko") => Self::Cqw,
-            "cqh" if !in_page_rule && cfg!(feature = "gecko") => Self::Cqh,
-            "cqi" if !in_page_rule && cfg!(feature = "gecko") => Self::Cqi,
-            "cqb" if !in_page_rule && cfg!(feature = "gecko") => Self::Cqb,
-            "cqmin" if !in_page_rule && cfg!(feature = "gecko") => Self::Cqmin,
-            "cqmax" if !in_page_rule && cfg!(feature = "gecko") => Self::Cqmax,
+            "cqw" if !in_page_rule => Self::Cqw,
+            "cqh" if !in_page_rule => Self::Cqh,
+            "cqi" if !in_page_rule => Self::Cqi,
+            "cqb" if !in_page_rule => Self::Cqb,
+            "cqmin" if !in_page_rule => Self::Cqmin,
+            "cqmax" if !in_page_rule => Self::Cqmax,
             _ => return Err(()),
         })
     }
diff --git a/stylo_static_prefs/preferences.toml b/stylo_static_prefs/preferences.toml
index 8c481f789..70fbd986c 100644
--- a/stylo_static_prefs/preferences.toml
+++ b/stylo_static_prefs/preferences.toml
@@ -14,7 +14,7 @@
 "layout.css.color-mix-multi-color.enabled" = true
 "layout.css.columns.enabled" = false
 "layout.css.contain.enabled" = false
-"layout.css.container-queries.enabled" = false
+"layout.css.container-queries.enabled" = true
 "layout.css.content.alt-text.enabled" = false
 "layout.css.corner-shape.enabled" = false
 "layout.css.counters.enabled" = false
