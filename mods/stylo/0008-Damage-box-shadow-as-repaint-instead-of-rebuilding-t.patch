From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 10 Aug 2026 06:22:54 +0100
Subject: [PATCH 08/10] Damage box-shadow as repaint instead of rebuilding the
 box

box-shadow sets no servo_restyle_damage, so it inherits the
"rebuild_box" default and every change to a shadow reports RELAYOUT. A
shadow is ink: it cannot move a box or change scrollable overflow, so
the box tree it forces a rebuild of is never stale.

This matters for incremental layout. An infinite keyframe animation on
box-shadow re-damages its element every frame, and consumers that gate
on "damage beyond REPAINT" then treat a purely painted change as a
layout change. A page whose canvas container runs an infinite shadow
animation lost every partial frame and dropped from 30 fps to 18 fps.
---
 style/properties/longhands.toml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/style/properties/longhands.toml b/style/properties/longhands.toml
index 9dce3bce7..3a7f8efb6 100644
--- a/style/properties/longhands.toml
+++ b/style/properties/longhands.toml
@@ -463,6 +463,9 @@ affects = "layout"
 [box-shadow]
 type = "BoxShadow"
 struct = "effects"
+# A shadow is ink-only: it cannot move a box or change scrollable overflow,
+# so the default "rebuild_box" bucket over-damages every animated shadow.
+servo_restyle_damage = "repaint"
 vector = { simple_bindings = true, animation_type = "with_zero" }
 extra_prefixes = ["webkit"]
 ignored_when_colors_disabled = true
