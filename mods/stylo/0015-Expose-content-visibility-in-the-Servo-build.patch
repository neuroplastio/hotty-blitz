From df79a8ebb189dc227895fb5d919dedf3d74bd5ab Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Mon, 23 Nov 2026 11:46:16 +0100
Subject: [PATCH] Expose content-visibility in the Servo build

---
 style/properties/helpers/animated_properties.mako.rs | 5 +----
 style/properties/longhands.toml                      | 2 +-
 2 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/style/properties/helpers/animated_properties.mako.rs b/style/properties/helpers/animated_properties.mako.rs
index 58cc9111a..f9a5966b6 100644
--- a/style/properties/helpers/animated_properties.mako.rs
+++ b/style/properties/helpers/animated_properties.mako.rs
@@ -13,6 +13,7 @@
 use crate::properties::{
     longhands::{
         self, display::computed_value::T as Display,
+        content_visibility::computed_value::T as ContentVisibility,
         visibility::computed_value::T as Visibility,
     },
     CSSWideKeyword, LonghandId,
@@ -20,7 +21,6 @@ use crate::properties::{
 };
 #[cfg(feature = "gecko")] use crate::properties::{
     gecko,
-    longhands::content_visibility::computed_value::T as ContentVisibility,
     NonCustomPropertyId,
 };
 use std::ptr;
@@ -689,7 +689,6 @@ impl ToAnimatedZero for Display {
 }
 
 /// <https://drafts.csswg.org/css-contain-3/#content-visibility-animation>
-#[cfg(feature = "gecko")]
 impl Animate for ContentVisibility {
     #[inline]
     fn animate(&self, other: &Self, procedure: Procedure) -> Result<Self, ()> {
@@ -711,7 +710,6 @@ impl Animate for ContentVisibility {
     }
 }
 
-#[cfg(feature = "gecko")]
 impl ComputeSquaredDistance for ContentVisibility {
     #[inline]
     fn compute_squared_distance(&self, other: &Self) -> Result<SquaredDistance, ()> {
@@ -719,7 +717,6 @@ impl ComputeSquaredDistance for ContentVisibility {
     }
 }
 
-#[cfg(feature = "gecko")]
 impl ToAnimatedZero for ContentVisibility {
     #[inline]
     fn to_animated_zero(&self) -> Result<Self, ()> {
diff --git a/style/properties/longhands.toml b/style/properties/longhands.toml
index 3f1721fb7..6f2341275 100644
--- a/style/properties/longhands.toml
+++ b/style/properties/longhands.toml
@@ -703,7 +703,7 @@ affects = "layout"
 type = "ContentVisibility"
 initial = "computed::ContentVisibility::Visible"
 struct = "box"
-engine = "gecko"
+servo_restyle_damage = "rebuild_box"
 spec = "https://drafts.csswg.org/css-contain/#content-visibility"
 affects = "layout"
 
-- 
2.56.0

