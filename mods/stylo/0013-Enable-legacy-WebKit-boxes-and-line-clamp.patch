From 1fa308c1c15fb9cca983612a8481a8ffe065051d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Sat, 14 Nov 2026 17:38:32 +0100
Subject: [PATCH] Enable legacy WebKit boxes and line clamp

Expose the existing box-orient and legacy line-clamp parsing in Servo and flag the adjusted flow-root. The generated XUL style pointer grows ComputedValues from 232 to 240 bytes on this target; the size assertion pins that bound.

Co-authored-by: Rui Figueira <rfigueira@cloudflare.com>

Co-authored-by: Ruskin Constant <ruskin@cloudflare.com>

Co-authored-by: hotty Agent <hotty@neuroplast.io>
---
 style/properties/computed_value_flags.rs | 3 +++
 style/properties/longhands.toml          | 1 -
 style/properties/properties.mako.rs      | 2 +-
 style/properties/shorthands.toml         | 1 -
 style/style_adjuster.rs                  | 3 +--
 style/values/specified/box.rs            | 7 -------
 6 files changed, 5 insertions(+), 12 deletions(-)

diff --git a/style/properties/computed_value_flags.rs b/style/properties/computed_value_flags.rs
index 2dcded887..2480391ba 100644
--- a/style/properties/computed_value_flags.rs
+++ b/style/properties/computed_value_flags.rs
@@ -143,6 +143,9 @@ bitflags! {
 
         /// Whether this style uses an element-scoped `random()`.
         const USES_ELEMENT_SCOPED_RANDOM = 1 << 29;
+
+        /// A legacy WebKit line clamp rewrote this display.
+        const IS_WEBKIT_LINE_CLAMP_CONTEXT = 1 << 30;
     }
 }
 
diff --git a/style/properties/longhands.toml b/style/properties/longhands.toml
index d9e464eda..3f1721fb7 100644
--- a/style/properties/longhands.toml
+++ b/style/properties/longhands.toml
@@ -4283,7 +4283,6 @@ initial = "computed::BoxDirection::Normal"
 
 [-moz-box-orient]
 struct = "xul"
-engine = "gecko"
 spec = "Nonstandard (https://developer.mozilla.org/en-US/docs/Web/CSS/box-orient)"
 animation_type = "discrete"
 affects = "layout"
diff --git a/style/properties/properties.mako.rs b/style/properties/properties.mako.rs
index 7aa338f49..e038d25c2 100644
--- a/style/properties/properties.mako.rs
+++ b/style/properties/properties.mako.rs
@@ -2769,7 +2769,7 @@ macro_rules! longhand_properties_idents {
 #[cfg(feature = "gecko")]
 size_of_test!(ComputedValues, 248);
 #[cfg(feature = "servo")]
-size_of_test!(ComputedValues, 232);
+size_of_test!(ComputedValues, 240);
 
 // FFI relies on this.
 size_of_test!(Option<Arc<ComputedValues>>, 8);
diff --git a/style/properties/shorthands.toml b/style/properties/shorthands.toml
index b9e67e02e..76aed8955 100644
--- a/style/properties/shorthands.toml
+++ b/style/properties/shorthands.toml
@@ -555,7 +555,6 @@ spec = "https://compat.spec.whatwg.org/#the-webkit-text-stroke"
 derive_serialize = true
 
 [-webkit-line-clamp]
-engine = "gecko"
 flags = "IS_LEGACY_SHORTHAND ALLOWS_DISABLED_SUBPROPERTIES"
 sub_properties = ["line-clamp"]
 spec = "https://drafts.csswg.org/css-overflow-4/#webkit-line-clamp"
diff --git a/style/style_adjuster.rs b/style/style_adjuster.rs
index 547a6eee3..f20c843fa 100644
--- a/style/style_adjuster.rs
+++ b/style/style_adjuster.rs
@@ -159,7 +159,6 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
     /// This makes the element not be a flex container, with all that it
     /// implies, but it should be safe. It matches blink, see
     /// https://bugzilla.mozilla.org/show_bug.cgi?id=1786147#c10
-    #[cfg(feature = "gecko")]
     fn adjust_for_webkit_line_clamp(&mut self) {
         use crate::properties::longhands::_moz_box_orient::computed_value::T as BoxOrient;
         use crate::values::specified::box_::{DisplayInside, DisplayOutside};
@@ -184,6 +183,7 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
         self.style
             .mutate_box()
             .set_adjusted_display(new_display, false);
+        self.style.add_flags(ComputedValueFlags::IS_WEBKIT_LINE_CLAMP_CONTEXT);
     }
 
     /// CSS 2.1 section 9.7:
@@ -1069,7 +1069,6 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
         }
         self.adjust_for_top_layer();
         self.blockify_if_necessary(layout_parent_style, element);
-        #[cfg(feature = "gecko")]
         self.adjust_for_webkit_line_clamp();
         self.adjust_for_position();
         self.adjust_for_overflow();
diff --git a/style/values/specified/box.rs b/style/values/specified/box.rs
index eea934f0f..76ca41493 100644
--- a/style/values/specified/box.rs
+++ b/style/values/specified/box.rs
@@ -171,7 +171,6 @@ pub enum DisplayInside {
     RubyText,
     #[cfg(feature = "gecko")]
     RubyTextContainer,
-    #[cfg(feature = "gecko")]
     WebkitBox,
 }
 
@@ -239,7 +238,6 @@ impl Display {
     );
     pub const Block: Self =
         Self(((DisplayOutside::Block as u16) << Self::OUTSIDE_SHIFT) | DisplayInside::Flow as u16);
-    #[cfg(feature = "gecko")]
     pub const FlowRoot: Self = Self(
         ((DisplayOutside::Block as u16) << Self::OUTSIDE_SHIFT) | DisplayInside::FlowRoot as u16,
     );
@@ -268,11 +266,9 @@ impl Display {
     #[cfg(feature = "gecko")]
     pub const Ruby: Self =
         Self(((DisplayOutside::Inline as u16) << Self::OUTSIDE_SHIFT) | DisplayInside::Ruby as u16);
-    #[cfg(feature = "gecko")]
     pub const WebkitBox: Self = Self(
         ((DisplayOutside::Block as u16) << Self::OUTSIDE_SHIFT) | DisplayInside::WebkitBox as u16,
     );
-    #[cfg(feature = "gecko")]
     pub const WebkitInlineBox: Self = Self(
         ((DisplayOutside::Inline as u16) << Self::OUTSIDE_SHIFT) | DisplayInside::WebkitBox as u16,
     );
@@ -525,9 +521,7 @@ impl DisplayKeyword {
             "ruby-text" => Full(Display::RubyText),
             #[cfg(feature = "gecko")]
             "ruby-text-container" => Full(Display::RubyTextContainer),
-            #[cfg(feature = "gecko")]
             "-webkit-box" => Full(Display::WebkitBox),
-            #[cfg(feature = "gecko")]
             "-webkit-inline-box" => Full(Display::WebkitInlineBox),
 
             /// <display-outside> = block | inline | run-in
@@ -561,7 +555,6 @@ impl ToCss for Display {
         match *self {
             Display::Block | Display::Inline => outside.to_css(dest),
             Display::InlineBlock => dest.write_str("inline-block"),
-            #[cfg(feature = "gecko")]
             Display::WebkitInlineBox => dest.write_str("-webkit-inline-box"),
             Display::TableCaption => dest.write_str("table-caption"),
             _ => match (outside, inside) {
