     /// Update the given animation at a given point of progress.
     pub fn calculate_value(&self, time: f64) -> AnimationValue {
         let progress = if time < self.start_time {
@@ -1256,6 +1358,15 @@ impl ElementAnimationSet {
                 .any(|transition| transition.state.needs_to_be_ticked())
     }
 
+    /// When the output of any of its animations or transitions may next
+    /// change, at or after `now`: the earliest of their
+    /// [`Animation::next_change`]s. `None` if none will.
+    pub fn next_change(&self, now: f64) -> Option<f64> {
+        let animations = self.animations.iter().filter_map(|a| a.next_change(now));
+        let transitions = self.transitions.iter().filter_map(|t| t.next_change(now));
+        animations.chain(transitions).min_by(f64::total_cmp)
+    }
