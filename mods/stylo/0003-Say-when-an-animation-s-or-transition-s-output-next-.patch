+/// When an easing over `[start, start + length]` of some progress next jumps
+/// after `at`, if it is a `steps()` easing: every jump position jumps at a
+/// whole number of steps into the interval, and the last at its end. `None`
+/// for an easing that moves continuously.
+fn next_step(timing_function: &TimingFunction, start: f64, length: f64, at: f64) -> Option<f64> {
+    let TimingFunction::Steps(steps, _) = timing_function else {
+        return None;
+    };
+    if length <= 0. {
+        return Some(start);
+    }
+    let steps = (*steps).max(1) as f64;
+    let done = ((at - start) / length * steps).floor() + 1.;
+    Some((start + done / steps * length).clamp(start, start + length))
+}
