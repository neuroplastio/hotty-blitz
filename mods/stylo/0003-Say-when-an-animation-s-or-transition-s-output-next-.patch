+    /// The indices into `computed_steps` of the keyframe before `total_progress`
+    /// (the progress into the current iteration, in [0, 1)) and of the keyframe
+    /// after it, in the current direction.
+    fn keyframes_around(&self, total_progress: f64) -> (usize, Option<usize>) {
+        let next_keyframe_index;
+        let prev_keyframe_index;
+        let num_steps = self.computed_steps.len();
+        match self.current_direction {
+            AnimationDirection::Normal => {
+                next_keyframe_index = self
+                    .computed_steps
+                    .iter()
+                    .position(|step| total_progress < step.start_percentage);
+                prev_keyframe_index = next_keyframe_index
+                    .and_then(|pos| if pos != 0 { Some(pos - 1) } else { None })
+                    .unwrap_or(0);
+            },
+            AnimationDirection::Reverse => {
+                next_keyframe_index = self
+                    .computed_steps
+                    .iter()
+                    .rev()
+                    .position(|step| total_progress <= 1. - step.start_percentage)
+                    .map(|pos| num_steps - pos - 1);
+                prev_keyframe_index = next_keyframe_index
+                    .and_then(|pos| {
+                        if pos != num_steps - 1 {
+                            Some(pos + 1)
+                        } else {
+                            None
+                        }
+                    })
+                    .unwrap_or(num_steps - 1)
+            },
+            _ => unreachable!(),
+        }
+        (prev_keyframe_index, next_keyframe_index)
+    }
+
+    /// When this animation's output may next change, at or after `now`, the
+    /// time `now` is on: `None` if it will not change unless its style does
+    /// (it is paused, finished or canceled); its start while it waits out a
+    /// delay; the next jump of a `steps()` easing, or the end of the keyframe
+    /// segment or of the iteration, whichever comes first; or `now` itself
+    /// while an easing moves continuously. An embedder that ticks animations
+    /// may sleep until then.
+    pub fn next_change(&self, now: f64) -> Option<f64> {
+        match self.state {
+            AnimationState::Pending | AnimationState::Running => {},
+            _ => return None,
+        }
+        if now < self.started_at {
+            return Some(self.started_at);
+        }
+        let end = self.current_iteration_end_progress();
+        let progress = (now - self.started_at) / self.duration;
+        if progress >= end {
+            // It iterates or finishes on the next tick.
+            return Some(now);
+        }
+        let mut next = self.started_at + end * self.duration;
+        let (prev_keyframe_index, next_keyframe_index) = self.keyframes_around(progress);
+        let Some(next_keyframe_index) = next_keyframe_index else {
+            return Some(next);
+        };
+        if prev_keyframe_index == next_keyframe_index {
+            return Some(next);
+        }
+        let reversed = self.current_direction != AnimationDirection::Normal;
+        for property_index in 0..self.number_of_animating_properties {
+            let (Some(from), Some(to)) = (
+                self.next_relevant_keyframe_for_property_in_direction(
+                    property_index,
+                    prev_keyframe_index,
+                    Direction::Backward.relative_to_animation_direction(reversed),
+                ),
+                self.next_relevant_keyframe_for_property_in_direction(
+                    property_index,
+                    next_keyframe_index,
+                    Direction::Forward.relative_to_animation_direction(reversed),
+                ),
+            ) else {
+                continue;
+            };
+            let length = (to.start_percentage - from.start_percentage).abs();
+            let start = if reversed {
+                1. - from.start_percentage
+            } else {
+                from.start_percentage
+            };
+            match next_step(from.timing_function, start, length, progress) {
+                Some(at) => next = next.min(self.started_at + at * self.duration),
+                None => return Some(now),
+            }
+        }
+        Some(next)
+    }
