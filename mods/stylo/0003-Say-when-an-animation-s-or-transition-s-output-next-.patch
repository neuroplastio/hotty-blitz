+    /// When this transition's output may next change, at or after `now`: as
+    /// [`Animation::next_change`] says.
+    pub fn next_change(&self, now: f64) -> Option<f64> {
+        match self.state {
+            AnimationState::Pending | AnimationState::Running => {},
+            _ => return None,
+        }
+        if now < self.start_time {
+            return Some(self.start_time);
+        }
+        let duration = self.property_animation.duration;
+        if now >= self.start_time + duration {
+            // It finishes on the next tick.
+            return Some(now);
+        }
+        let timing_function = &self.property_animation.timing_function;
+        Some(next_step(timing_function, self.start_time, duration, now).unwrap_or(now))
+    }
