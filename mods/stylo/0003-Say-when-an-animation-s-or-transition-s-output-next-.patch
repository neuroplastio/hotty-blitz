+#[cfg(test)]
+mod next_change_tests {
+    use super::*;
+    use crate::values::generics::easing::{StepPosition, TimingKeyword};
+
+    fn steps(n: i32) -> TimingFunction {
+        TimingFunction::Steps(n, StepPosition::End)
+    }
+
+    fn linear() -> TimingFunction {
+        TimingFunction::Keyword(TimingKeyword::Linear)
+    }
+
+    fn keyframe(start_percentage: f64, timing_function: TimingFunction) -> ComputedKeyframe {
+        ComputedKeyframe {
+            timing_function,
+            start_percentage,
+            values: vec![AnimationValueOrReference::AnimationValue(
+                AnimationValue::Opacity(start_percentage as f32),
+            )]
+            .into_boxed_slice(),
+        }
+    }
+
+    /// An animation of opacity over `duration` seconds from `started_at`,
+    /// through keyframes at `stops` (with the easing to the next one).
+    fn animation(started_at: f64, duration: f64, stops: Vec<(f64, TimingFunction)>) -> Animation {
+        Animation {
+            name: Atom::from("a"),
+            properties_changed: PropertyDeclarationIdSet::default(),
+            computed_steps: stops.into_iter().map(|(at, tf)| keyframe(at, tf)).collect(),
+            started_at,
+            duration,
+            delay: 0.,
+            fill_mode: AnimationFillMode::Forwards,
+            iteration_state: KeyframesIterationState::Infinite(0.),
+            state: AnimationState::Running,
+            direction: AnimationDirection::Normal,
+            current_direction: AnimationDirection::Normal,
+            number_of_animating_properties: 1,
+            is_new: false,
+        }
+    }
+
+    fn near(got: Option<f64>, want: f64) {
+        let got = got.expect("a next change");
+        assert!(
+            (got - want).abs() < 1e-9,
+            "next change at {got}, not {want}"
+        );
+    }
+
+    #[test]
+    fn steps_change_on_their_boundaries() {
+        let a = animation(0., 1., vec![(0., steps(10)), (1., linear())]);
+        near(a.next_change(0.), 0.1);
+        near(a.next_change(0.25), 0.3);
+        near(a.next_change(0.95), 1.);
+        // Ten steps over sixty seconds, later in its life.
+        let a = animation(100., 60., vec![(0., steps(600)), (1., linear())]);
+        near(a.next_change(130.05), 130.1);
+    }
+
+    #[test]
+    fn reversed_steps_change_on_their_boundaries() {
+        let mut a = animation(0., 1., vec![(0., steps(4)), (1., steps(4))]);
+        a.direction = AnimationDirection::Reverse;
+        a.current_direction = AnimationDirection::Reverse;
+        // Backwards from the last keyframe, whose easing applies.
+        near(a.next_change(0.3), 0.5);
+    }
+
+    #[test]
+    fn steps_stop_at_their_segment_and_continuous_easings_tick() {
+        let a = animation(
+            0.,
+            1.,
+            vec![(0., steps(2)), (0.5, linear()), (1., linear())],
+        );
+        near(a.next_change(0.1), 0.25);
+        near(a.next_change(0.3), 0.5);
+        near(a.next_change(0.6), 0.6);
+    }
+
+    #[test]
+    fn a_delay_waits_for_the_start_and_the_end_ticks_now() {
+        let a = animation(5., 1., vec![(0., linear()), (1., linear())]);
+        near(a.next_change(1.), 5.);
+        let mut a = animation(0., 1., vec![(0., steps(2)), (1., linear())]);
+        a.iteration_state = KeyframesIterationState::Finite(0., 1.);
+        near(a.next_change(1.5), 1.5);
+    }
+
+    #[test]
+    fn paused_and_finished_never_change() {
+        let mut a = animation(0., 1., vec![(0., linear()), (1., linear())]);
+        a.state = AnimationState::Paused(0.5);
+        assert_eq!(a.next_change(0.5), None);
+        a.state = AnimationState::Finished;
+        assert_eq!(a.next_change(0.5), None);
+    }
+
+    #[test]
+    fn transitions_wait_and_step() {
+        let t = Transition::new(
+            1.,
+            1.,
+            2.,
+            AnimationValue::Opacity(0.),
+            AnimationValue::Opacity(1.),
+            &steps(4),
+        );
+        near(t.next_change(0.5), 1.);
+        near(t.next_change(1.6), 2.);
+        near(t.next_change(3.5), 3.5);
+        let t = Transition::new(
+            0.,
+            0.,
+            2.,
+            AnimationValue::Opacity(0.),
+            AnimationValue::Opacity(1.),
+            &linear(),
+        );
+        near(t.next_change(0.7), 0.7);
+        let mut set = ElementAnimationSet::default();
+        set.transitions.push(t);
+        set.animations
+            .push(animation(0., 1., vec![(0., steps(10)), (1., linear())]));
+        near(set.next_change(0.25), 0.25);
+        set.transitions.clear();
+        near(set.next_change(0.25), 0.3);
+    }
+}
