From 20222e9db146ec10dfb8ed9132c5a68a71375483 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Mon, 16 Nov 2026 00:25:00 +0100
Subject: [PATCH] Share an auto-layout table's spare width in proportion to its
 columns' sizes

A grid shares free width equally between its auto tracks, in "maximise
tracks" and again in "stretch auto tracks". An auto-layout table does not:
CSS 2.1 section 17.5.2.2 leaves it to the user agent, and Chromium and Firefox
give a column that would be narrower than its content between the sum of the
columns' minimum content widths and the sum of their maximum a share of the
spare width in proportion to maximum less minimum, and beyond the sum of
maximum a share in proportion to maximum. Two columns of 100px and 300px
content in a 1000px table are 250px and 750px wide, not 400px and 600px.

Let an embedder that lays a table out as a grid say so with
GridContainerStyle::is_table_grid (Style's item_is_table), and share the
inline axis's free space that way. A grid that is not a table, and the block
axis, are as before.
---
 src/compute/grid/mod.rs          |  5 ++++
 src/compute/grid/track_sizing.rs | 43 ++++++++++++++++++++++++++------
 src/style/grid.rs                |  7 ++++++
 src/style/mod.rs                 | 10 ++++++++
 4 files changed, 57 insertions(+), 8 deletions(-)

diff --git a/src/compute/grid/mod.rs b/src/compute/grid/mod.rs
index f0109c6e..74cc1394 100644
--- a/src/compute/grid/mod.rs
+++ b/src/compute/grid/mod.rs
@@ -258,6 +258,7 @@ pub fn compute_grid_layout<Tree: LayoutGridContainer>(
     let grid_template_rows = style.grid_template_rows();
     let grid_auto_columns = style.grid_auto_columns();
     let grid_auto_rows = style.grid_auto_rows();
+    let is_table = style.is_table_grid();
 
     debug_log!("parent_size", dbg:inputs.parent_size);
     debug_log!("outer_node_size", dbg:outer_node_size);
@@ -434,6 +435,7 @@ pub fn compute_grid_layout<Tree: LayoutGridContainer>(
             track.max_track_sizing_function.definite_value(parent_size, |val, basis| tree.calc(val, basis))
         },
         has_baseline_aligned_item,
+        is_table,
     );
     let initial_column_sum = columns.iter().map(|track| track.base_size).sum::<f32>();
     inner_node_size.width = inner_node_size.width.or_else(|| initial_column_sum.into());
@@ -465,6 +467,7 @@ pub fn compute_grid_layout<Tree: LayoutGridContainer>(
         &mut items,
         |track: &GridTrack, _, _| Some(track.base_size),
         false, // TODO: Support baseline alignment in the vertical axis
+        false,
     );
     let initial_row_sum = rows.iter().map(|track| track.base_size).sum::<f32>();
 
@@ -583,6 +586,7 @@ pub fn compute_grid_layout<Tree: LayoutGridContainer>(
             &mut items,
             |track: &GridTrack, _, _| Some(track.base_size),
             has_baseline_aligned_item,
+            is_table,
         );
 
         // The column widths may have changed, so the items' intrinsic height contributions need to be recomputed
@@ -632,6 +636,7 @@ pub fn compute_grid_layout<Tree: LayoutGridContainer>(
             &mut items,
             |track: &GridTrack, _, _| Some(track.base_size),
             false, // TODO: Support baseline alignment in the vertical axis
+            false,
         );
     }
 
diff --git a/src/compute/grid/track_sizing.rs b/src/compute/grid/track_sizing.rs
index 18063621..9be4435a 100644
--- a/src/compute/grid/track_sizing.rs
+++ b/src/compute/grid/track_sizing.rs
@@ -269,6 +269,7 @@ pub(super) fn track_sizing_algorithm<Tree: LayoutPartialTree>(
     items: &mut [GridItem],
     get_track_size_estimate: fn(&GridTrack, Option<f32>, &Tree) -> Option<f32>,
     has_baseline_aligned_item: bool,
+    table_columns: bool,
 ) {
     // 11.4 Initialise Track sizes
     // Initialize each track’s base size and growth limit.
@@ -332,7 +333,7 @@ pub(super) fn track_sizing_algorithm<Tree: LayoutPartialTree>(
 
     // 11.6. Maximise Tracks
     // Distributes free space (if any) to tracks with FINITE growth limits, up to their limits.
-    maximise_tracks(axis_tracks, available_grid_space.get(axis));
+    maximise_tracks(axis_tracks, available_grid_space.get(axis), table_columns);
 
     // For the purpose of the final two expansion steps ("Expand Flexible Tracks" and "Stretch auto Tracks"), we only want to expand
     // into space generated by the grid container's size (as defined by either it's preferred size style or by it's parent node through
@@ -366,7 +367,7 @@ pub(super) fn track_sizing_algorithm<Tree: LayoutPartialTree>(
     // 11.8. Stretch auto Tracks
     // This step expands tracks that have an auto max track sizing function by dividing any remaining positive, definite free space equally amongst them.
     if axis_alignment == AlignContent::STRETCH {
-        stretch_auto_tracks(axis_tracks, axis_min_size, axis_available_space_for_expansion);
+        stretch_auto_tracks(axis_tracks, axis_min_size, axis_available_space_for_expansion, table_columns);
     }
 }
 
@@ -1213,8 +1214,11 @@ fn distribute_item_space_to_growth_limit(
 
 /// 11.6 Maximise Tracks
 /// Distributes free space (if any) to tracks with FINITE growth limits, up to their limits.
+///
+/// The columns of a table share it in proportion to how far each is from its limit (its max-content width less
+/// its min-content width), as an auto-layout table's do (CSS 2.1 section 17.5.2.2), instead of equally.
 #[inline(always)]
-fn maximise_tracks(axis_tracks: &mut [GridTrack], axis_available_grid_space: AvailableSpace) {
+fn maximise_tracks(axis_tracks: &mut [GridTrack], axis_available_grid_space: AvailableSpace, table_columns: bool) {
     let used_space: f32 = axis_tracks.iter().map(|track| track.base_size).sum();
     let free_space = axis_available_grid_space.compute_free_space(used_space);
     if free_space == f32::INFINITY {
@@ -1224,7 +1228,14 @@ fn maximise_tracks(axis_tracks: &mut [GridTrack], axis_available_grid_space: Ava
             free_space,
             axis_tracks,
             |_| true,
-            |_| 1.0,
+            |track| {
+                let limit = track.fit_content_limited_growth_limit();
+                if table_columns && limit.is_finite() {
+                    f32_max(limit - track.base_size, 0.0)
+                } else {
+                    1.0
+                }
+            },
             |track| track.base_size,
             move |track: &GridTrack| track.fit_content_limited_growth_limit(),
         );
@@ -1408,11 +1419,15 @@ fn find_size_of_fr(tracks: &[GridTrack], space_to_fill: f32) -> f32 {
 
 /// 11.8. Stretch auto Tracks
 /// This step expands tracks that have an auto max track sizing function by dividing any remaining positive, definite free space equally amongst them.
+///
+/// The columns of a table share it in proportion to their widths (their max-content widths, after the step
+/// above), as an auto-layout table's do, unless they are all zero wide.
 #[inline(always)]
 fn stretch_auto_tracks(
     axis_tracks: &mut [GridTrack],
     axis_min_size: Option<f32>,
     axis_available_space_for_expansion: AvailableSpace,
+    table_columns: bool,
 ) {
     let num_auto_tracks = axis_tracks.iter().filter(|track| track.max_track_sizing_function.is_auto()).count();
     if num_auto_tracks > 0 {
@@ -1429,11 +1444,23 @@ fn stretch_auto_tracks(
             }
         };
         if free_space > 0.0 {
-            let extra_space_per_auto_track = free_space / num_auto_tracks as f32;
-            axis_tracks
-                .iter_mut()
+            let auto_size_sum: f32 = axis_tracks
+                .iter()
                 .filter(|track| track.max_track_sizing_function.is_auto())
-                .for_each(|track| track.base_size += extra_space_per_auto_track);
+                .map(|track| track.base_size)
+                .sum();
+            if table_columns && auto_size_sum > 0.0 {
+                axis_tracks
+                    .iter_mut()
+                    .filter(|track| track.max_track_sizing_function.is_auto())
+                    .for_each(|track| track.base_size += free_space * track.base_size / auto_size_sum);
+            } else {
+                let extra_space_per_auto_track = free_space / num_auto_tracks as f32;
+                axis_tracks
+                    .iter_mut()
+                    .filter(|track| track.max_track_sizing_function.is_auto())
+                    .for_each(|track| track.base_size += extra_space_per_auto_track);
+            }
         }
     }
 }
diff --git a/src/style/grid.rs b/src/style/grid.rs
index c181acbc..2ecd4d2a 100644
--- a/src/style/grid.rs
+++ b/src/style/grid.rs
@@ -159,6 +159,13 @@ pub trait GridContainerStyle: CoreStyle {
     where
         Self: 'a;
 
+    /// Whether the grid is a CSS table's: its `auto` columns share the free width the way an auto-layout
+    /// table's do, in proportion to their sizes, not equally. A table is laid out as a grid by its embedder.
+    #[inline(always)]
+    fn is_table_grid(&self) -> bool {
+        false
+    }
+
     /// The type returned by grid_template_rows and grid_template_columns
     type TemplateTrackList<'a>: Iterator<Item = GenericGridTemplateComponent<Self::CustomIdent, Self::Repetition<'a>>>
         + ExactSizeIterator
diff --git a/src/style/mod.rs b/src/style/mod.rs
index d3fe8ad8..cef8684d 100644
--- a/src/style/mod.rs
+++ b/src/style/mod.rs
@@ -1384,6 +1384,11 @@ impl<T: FlexboxItemStyle> FlexboxItemStyle for &'_ T {
 
 #[cfg(feature = "grid")]
 impl<S: CheapCloneStr> GridContainerStyle for Style<S> {
+    #[inline(always)]
+    fn is_table_grid(&self) -> bool {
+        self.item_is_table
+    }
+
     type Repetition<'a>
         = &'a GridTemplateRepetition<S>
     where
@@ -1485,6 +1490,11 @@ impl<S: CheapCloneStr> GridContainerStyle for Style<S> {
 
 #[cfg(feature = "grid")]
 impl<T: GridContainerStyle> GridContainerStyle for &'_ T {
+    #[inline(always)]
+    fn is_table_grid(&self) -> bool {
+        (*self).is_table_grid()
+    }
+
     type Repetition<'a>
         = T::Repetition<'a>
     where
