From 3ab8c7c2656a3f3d94fe003ea9ecceb9764a0f12 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Mon, 16 Nov 2026 11:13:10 +0100
Subject: [PATCH] Clamp an item's size in a flex container's intrinsic main
 size

css-flexbox-1 section 9.9.1 sums, for each item on a line, its flex base
size plus its share of the chosen flex fraction, "then clamp that result by
the max main size floored by the min main size". The clamp was missing.
For most items the content contribution was already clamped, so the sum
came out within bounds anyway. A scroll container's content contribution is
its flex base size, though (#728), and a base size is not clamped. So an
`overflow: hidden` item with a `max-width` added its whole content to its
container's min- and max-content size.

Tailwind's `truncate` (a `max-width` span with `overflow: hidden` and
`white-space: nowrap`) beside a badge in a `flex` cell is what shadcn's
data table puts in its title column: the column took the whole title's
width, where Chrome and Firefox give it the span's `max-width`.

The min and max main sizes are now computed by one closure, used both for
the content contribution and for the final clamp.
---
 src/compute/flexbox.rs | 67 +++++++++++++++++++++++++-----------------
 1 file changed, 40 insertions(+), 27 deletions(-)

diff --git a/src/compute/flexbox.rs b/src/compute/flexbox.rs
index ea9fe123..9be8b79a 100644
--- a/src/compute/flexbox.rs
+++ b/src/compute/flexbox.rs
@@ -1604,38 +1604,46 @@ fn determine_container_main_size(
                 //   "The flex container’s max-content size is the largest sum of the afore-calculated sizes of all items within a single line."
                 let mut main_size = 0.0;
 
+                // The min and max main sizes that clamp an item's contribution, both the content
+                // contribution and the item's size in the container's max-content size.
+                let is_row = constants.is_row;
+                let main_size_bounds = |item: &FlexItem| -> (f32, f32) {
+                    let style_min = item.min_size.main(dir);
+                    let style_preferred = item.size.main(dir);
+                    let style_max = item.max_size.main(dir);
+
+                    // The spec seems a bit unclear on this point (my initial reading was that the `.maybe_max(style_preferred)` should
+                    // not be included here), however for row containers this matches both Chrome and Firefox as of 9th March 2023.
+                    // For column containers the flex base size alone is the clamping basis (as the spec says): a column item's
+                    // `height` must not inflate the container's max-content size beyond the item's flex-basis.
+                    //
+                    // Spec: https://www.w3.org/TR/css-flexbox-1/#intrinsic-item-contributions
+                    // Spec modification: https://www.w3.org/TR/css-flexbox-1/#change-2016-max-contribution
+                    // Issue: https://github.com/w3c/csswg-drafts/issues/1435
+                    // Gentest: padding_border_overrides_size_flex_basis_0.html
+                    // Gentest: blockflex_min_content_ignores_own_height_as_percentage_basis.html
+                    let clamping_basis =
+                        if is_row { Some(item.flex_basis).maybe_max(style_preferred) } else { Some(item.flex_basis) };
+                    let flex_basis_min = clamping_basis.filter(|_| item.flex_shrink == 0.0);
+                    let flex_basis_max = clamping_basis.filter(|_| item.flex_grow == 0.0);
+
+                    let min_main_size = style_min
+                        .maybe_max(flex_basis_min)
+                        .or(flex_basis_min)
+                        .unwrap_or(item.resolved_minimum_main_size)
+                        .max(item.resolved_minimum_main_size);
+                    let max_main_size =
+                        style_max.maybe_min(flex_basis_max).or(flex_basis_max).unwrap_or(f32::INFINITY);
+                    (min_main_size, max_main_size)
+                };
+
                 for line in lines.iter_mut() {
                     for item in line.items.iter_mut() {
                         let style_min = item.min_size.main(constants.dir);
                         let margin_sum = item.margin.main_axis_sum(constants.dir);
                         let style_preferred = item.size.main(constants.dir);
                         let style_max = item.max_size.main(constants.dir);
-
-                        // The spec seems a bit unclear on this point (my initial reading was that the `.maybe_max(style_preferred)` should
-                        // not be included here), however for row containers this matches both Chrome and Firefox as of 9th March 2023.
-                        // For column containers the flex base size alone is the clamping basis (as the spec says): a column item's
-                        // `height` must not inflate the container's max-content size beyond the item's flex-basis.
-                        //
-                        // Spec: https://www.w3.org/TR/css-flexbox-1/#intrinsic-item-contributions
-                        // Spec modification: https://www.w3.org/TR/css-flexbox-1/#change-2016-max-contribution
-                        // Issue: https://github.com/w3c/csswg-drafts/issues/1435
-                        // Gentest: padding_border_overrides_size_flex_basis_0.html
-                        // Gentest: blockflex_min_content_ignores_own_height_as_percentage_basis.html
-                        let clamping_basis = if constants.is_row {
-                            Some(item.flex_basis).maybe_max(style_preferred)
-                        } else {
-                            Some(item.flex_basis)
-                        };
-                        let flex_basis_min = clamping_basis.filter(|_| item.flex_shrink == 0.0);
-                        let flex_basis_max = clamping_basis.filter(|_| item.flex_grow == 0.0);
-
-                        let min_main_size = style_min
-                            .maybe_max(flex_basis_min)
-                            .or(flex_basis_min)
-                            .unwrap_or(item.resolved_minimum_main_size)
-                            .max(item.resolved_minimum_main_size);
-                        let max_main_size =
-                            style_max.maybe_min(flex_basis_max).or(flex_basis_max).unwrap_or(f32::INFINITY);
+                        let (min_main_size, max_main_size) = main_size_bounds(item);
 
                         let content_contribution = match (min_main_size, style_preferred, max_main_size) {
                             // If the clamping values are such that max <= min, then we can avoid the expensive step of computing the content size
@@ -1800,7 +1808,12 @@ fn determine_container_main_size(
                             } else {
                                 0.0
                             };
-                            let size = item.flex_basis + flex_contribution + item.margin.main_axis_sum(constants.dir);
+                            // A scroll container's content contribution is its flex base size, which its
+                            // max main size does not clamp: without this, a `max-width` item with
+                            // `overflow: hidden` would add all of its content to the container's size.
+                            let (min_main_size, max_main_size) = main_size_bounds(item);
+                            let size = (item.flex_basis + flex_contribution).min(max_main_size).max(min_main_size)
+                                + item.margin.main_axis_sum(constants.dir);
                             if floor_by_largest_item {
                                 largest_item_size = f32_max(largest_item_size, size);
                             }
