From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 3 Oct 2026 16:53:55 +0100
Subject: [PATCH 15/61] Honour visibility:hidden on inline text

render.rs skips a box whose visibility is not visible, but inline text
paints from the inline root, run by run, with no visibility check. A
hidden <span> or ::after still painted its glyphs, text decorations and
span background. For example, a math editor that sizes an empty cursor
with a hidden ::after "c" showed a stray c in every empty expression.

visibility inherits, so each run checks its own node. A hidden run
keeps its advance and paints nothing. A visible child inside a hidden
span still paints.
---
 packages/blitz-paint/src/text.rs | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-paint/src/text.rs b/packages/blitz-paint/src/text.rs
index 9f647fdb1..90a0bbfb9 100644
--- a/packages/blitz-paint/src/text.rs
+++ b/packages/blitz-paint/src/text.rs
@@ -5,6 +5,7 @@ use kurbo::{Affine, Rect};
 use parley::{Affinity, Cursor, GlyphRun, Layout, Line, PositionedLayoutItem, Selection};
 use peniko::Fill;
 use std::sync::Arc;
+use style::properties::generated::longhands::visibility::computed_value::T as Visibility;
 
 use crate::color::{Color, ToColorColor as _};
 use crate::text_decorations::{
@@ -45,6 +46,9 @@ pub(crate) fn draw_inline_backgrounds<'a>(
             };
 
             let current_color = styles.clone_color();
+            if styles.get_inherited_box().visibility != Visibility::Visible {
+                continue;
+            }
             let bg_color = styles
                 .get_background()
                 .background_color
@@ -70,6 +74,7 @@ pub(crate) fn draw_inline_backgrounds<'a>(
 /// Per glyph run values recorded while walking a line, so the line can be painted in
 /// passes (shadows beneath, then glyphs) without re-resolving styles.
 pub(crate) struct RunRecord {
+    pub(crate) visible: bool,
     pub(crate) fill_color: Color,
     pub(crate) shadows: Option<Arc<[ResolvedTextShadow]>>,
 }
@@ -181,13 +186,20 @@ pub(crate) fn stroke_text<'a>(
                 .last()
                 .map(|e| (e.fill_color, e.text_shadows.clone()))
                 .unwrap_or((Color::BLACK, None));
+            let visible = doc.get_node(style.brush.id)
+                .and_then(|node| node.primary_styles())
+                .is_none_or(|styles| styles.get_inherited_box().visibility == Visibility::Visible);
             let fill_color = brush_override.unwrap_or(fill_color);
-            let shadows = shadows.filter(|_| brush_override.is_none());
+            let shadows = shadows.filter(|_| visible && brush_override.is_none());
             line_has_shadows |= shadows.is_some();
             run_records.push(RunRecord {
+                visible,
                 fill_color,
                 shadows,
             });
+            if !visible {
+                continue;
+            }
 
             // Accumulate this run's contribution to each decorating box on its ancestor
             // path. The decoration is drawn once per box after the whole line has been
@@ -256,7 +268,9 @@ pub(crate) fn stroke_text<'a>(
 
         // Pass 3: the glyphs themselves.
         for (glyph_run, record) in glyph_runs(&line).zip(run_records.iter()) {
-            draw_glyph_run(scene, &glyph_run, record.fill_color, transform);
+            if record.visible {
+                draw_glyph_run(scene, &glyph_run, record.fill_color, transform);
+            }
         }
 
         // Pass 4: decorations, on top of the glyphs.
