+    /// The image at `href` changed where it is fetched from: every `<img>`,
+    /// `background-image` layer and `mask-image` layer that shows it gets it
+    /// again, and an `<img>` is laid out again at its new size. An image
+    /// still on its way is left to arrive.
+    fn reload_image(&mut self, href: &str) {
+        let Some(url) = self.resolve_url(href) else {
+            return;
+        };
+        let key = url.as_str();
+        // Whether or not it loaded last time: one that failed is shown by
+        // no node, which waits for it again all the same.
+        self.image_cache.remove(key);
+        if self.pending_images.contains_key(key) {
+            return;
+        }
+        let mut waiting = Vec::new();
+        for (id, node) in self.nodes.iter() {
+            let Some(el) = node.element_data() else {
+                continue;
+            };
+            if el.name.local == local_name!("img")
+                && self
+                    .image_source(id)
+                    .and_then(|src| self.resolve_url(&src))
+                    .is_some_and(|src| src.as_str() == key)
+            {
+                waiting.push((id, ImageType::Image));
+            }
+            let layers = |images: &[Option<ImageResourceData>]| {
+                images
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, l)| l.as_ref().is_some_and(|l| l.url.as_str() == key))
+                    .map(|(i, _)| i)
+                    .collect::<Vec<_>>()
+            };
+            for i in layers(&el.background_images) {
+                waiting.push((id, ImageType::Background(i)));
+            }
+            for i in layers(&el.mask_images) {
+                waiting.push((id, ImageType::Mask(i)));
+            }
+        }
+        if waiting.is_empty() {
+            return;
+        }
+        self.pending_images.insert(key.to_string(), waiting);
+        self.net_provider.fetch(
+            self.id(),
+            self.build_request(url, blitz_traits::net::Destination::Image),
+            ResourceHandler::boxed(
+                self.tx.clone(),
+                self.id(),
+                None,
+                self.shell_provider.clone(),
+                ImageHandler::new(ImageType::Image),
+            ),
+        );
+    }
+
     /// Parse the latest text of registered style elements once per resolve.
     pub(crate) fn process_pending_style_elements(&mut self) {
         for id in std::mem::take(&mut self.pending_style_nodes) {
@@ -1657,6 +1721,11 @@ impl BaseDocument {
             Err(err) => {
                 if let Some(url) = res.resolved_url.as_ref() {
                     let waiting_nodes = self.pending_images.remove(url).unwrap_or_default();
+                    // What failed is shown by none of them, as on a first
+                    // load: one fetched again drops the image it showed.
+                    for &(node_id, image_type) in &waiting_nodes {
