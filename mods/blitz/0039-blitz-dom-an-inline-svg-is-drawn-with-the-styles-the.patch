diff --git a/packages/blitz-dom/src/node/svg_source.rs b/packages/blitz-dom/src/node/svg_source.rs
new file mode 100644
index 000000000..18fea5990
--- /dev/null
+++ b/packages/blitz-dom/src/node/svg_source.rs
@@ -0,0 +1,219 @@
+//! The markup an inline `<svg>` is drawn from. usvg reads markup alone, not
+//! the document's cascade, so each element of the svg carries in its `style`
+//! attribute the painting properties the cascade computed for it: what the
+//! document's rules, custom properties, presentation attributes and
+//! inheritance gave it, as values usvg parses.
+
+use super::serialize::write_attr_name;
+use super::{Node, NodeData};
+use html_escape::{encode_quoted_attribute_to_string, encode_text_minimal_to_string};
+use markup5ever::{QualName, local_name, ns};
+use style::properties::ComputedValues;
+use style::values::computed::url::ComputedUrl;
+use style::values::computed::{LengthPercentage, SVGPaint};
+use style::values::generics::svg::{SVGLength, SVGOpacity, SVGPaintKind, SVGStrokeDashArray};
+use style_traits::values::ToCss;
+use stylo_taffy::CopyStyleGetters as _;
+
+const XLINK_NS: &str = "http://www.w3.org/1999/xlink";
+
+fn is_xlink_ns_decl(name: &QualName) -> bool {
+    (name.ns == ns!(xmlns) && name.local.as_str() == "xlink")
+        || name.local.as_str() == "xmlns:xlink"
+}
+
+/// The properties written, all inherited.
+const NAMES: [&str; 11] = [
+    "fill",
+    "fill-opacity",
+    "fill-rule",
+    "stroke",
+    "stroke-width",
+    "stroke-opacity",
+    "stroke-linecap",
+    "stroke-linejoin",
+    "stroke-miterlimit",
+    "stroke-dasharray",
+    "stroke-dashoffset",
+];
+
+/// Their initial values, as [`values`] writes them: what usvg takes for the
+/// svg's root when it is given nothing.
+const INITIAL: [&str; 11] = [
+    "rgb(0, 0, 0)",
+    "1",
+    "nonzero",
+    "none",
+    "1px",
+    "1",
+    "butt",
+    "miter",
+    "4",
+    "none",
+    "0px",
+];
+
+/// An element's values of [`NAMES`]; `None` where usvg has nothing to read
+/// for it (`context-fill`, a `calc()` of a length and a percentage).
+type Values = [Option<String>; 11];
+
+fn values(style: &ComputedValues) -> Values {
+    let current = style.clone_color();
+    let paint = |paint: SVGPaint| match paint.kind {
+        SVGPaintKind::None => Some("none".to_string()),
+        SVGPaintKind::Color(color) => Some(
+            color
+                .resolve_to_absolute(&current)
+                .into_srgb_legacy()
+                .to_css_string(),
+        ),
+        // A paint server is an element of this svg: usvg finds it by its id.
+        SVGPaintKind::PaintServer(url) => fragment(&url).map(|id| format!("url(#{id})")),
+        SVGPaintKind::ContextFill | SVGPaintKind::ContextStroke => None,
+    };
+    let opacity = |opacity: SVGOpacity<style::values::computed::Opacity>| match opacity {
+        SVGOpacity::Opacity(o) => Some(o.to_css_string()),
+        _ => None,
+    };
+    let length = |l: &LengthPercentage| Some(l.to_css_string()).filter(|s| !s.contains('('));
+    [
+        paint(style.slow_clone_fill()),
+        opacity(style.slow_clone_fill_opacity()),
+        Some(style.slow_clone_fill_rule().to_css_string()),
+        paint(style.slow_clone_stroke()),
+        match style.slow_clone_stroke_width() {
+            SVGLength::LengthPercentage(l) => length(&l.0),
+            SVGLength::ContextValue => None,
+        },
+        opacity(style.slow_clone_stroke_opacity()),
+        Some(style.slow_clone_stroke_linecap().to_css_string()),
+        Some(style.slow_clone_stroke_linejoin().to_css_string()),
+        Some(style.slow_clone_stroke_miterlimit().to_css_string()),
+        match style.slow_clone_stroke_dasharray() {
+            SVGStrokeDashArray::Values(dashes) if dashes.is_empty() => Some("none".to_string()),
+            SVGStrokeDashArray::Values(dashes) => dashes
+                .iter()
+                .map(|l| length(&l.0))
+                .collect::<Option<Vec<_>>>()
+                .map(|v| v.join(", ")),
+            SVGStrokeDashArray::ContextValue => None,
+        },
+        match style.slow_clone_stroke_dashoffset() {
+            SVGLength::LengthPercentage(l) => length(&l),
+            SVGLength::ContextValue => None,
+        },
+    ]
+}
+
+/// The id a `url()` points at in this document.
+fn fragment(url: &ComputedUrl) -> Option<String> {
+    match url {
+        ComputedUrl::Valid(url) => url.fragment().map(str::to_string),
+        ComputedUrl::Invalid(s) => s.strip_prefix('#').map(str::to_string),
+    }
+}
+
+impl Node {
+    /// This `svg`'s markup as usvg is to draw it ([the module](self)).
+    pub(crate) fn svg_source(&self) -> String {
+        let mut out = String::new();
+        self.write_svg_source(&mut out, None);
+        out
+    }
+
+    /// `inherited` is what the parent's values are, `None` for the root.
+    fn write_svg_source(&self, out: &mut String, inherited: Option<&Values>) {
+        let data = match &self.data {
+            NodeData::Text(text) => {
+                encode_text_minimal_to_string(&text.content, out);
+                return;
+            }
+            NodeData::Element(data) => data,
+            _ => return,
+        };
+        let styles = self.primary_styles();
+        let own = styles.as_ref().map(|s| values(s));
+        // currentColor in an attribute usvg reads as is (`stop-color`), as
+        // rgb(): usvg doesn't parse color(srgb …).
+        let current_color = styles
+            .as_ref()
+            .map(|s| s.clone_color().into_srgb_legacy().to_css_string());
+
+        out.push('<');
+        out.push_str(&data.name.local);
+        // usvg reads XML: the root declares the prefix of an xlink:href.
+        if inherited.is_none() && !data.attrs().iter().any(|a| is_xlink_ns_decl(&a.name)) {
+            out.push_str(" xmlns:xlink=\"");
+            out.push_str(XLINK_NS);
+            out.push('"');
+        }
+        for attr in data.attrs() {
+            if attr.name.local == local_name!("style") {
+                continue;
+            }
+            out.push(' ');
+            write_attr_name(&attr.name, out);
+            out.push_str("=\"");
+            match &current_color {
+                Some(c) if attr.value.contains("currentColor") => {
+                    encode_quoted_attribute_to_string(attr.value.replace("currentColor", c), out);
+                }
+                _ => {
+                    encode_quoted_attribute_to_string(&attr.value, out);
+                }
+            }
+            out.push('"');
+        }
+
+        // The element's own style first: what it says that is written below
+        // is overridden, the rest (a transform, a font) usvg still reads.
+        let own_style = data.attr(local_name!("style")).unwrap_or_default();
+        let mut style = own_style.to_string();
+        // A property the element sets (by attribute or style) is written
+        // whatever its value; one it inherits only when it differs from
+        // its parent's, so that a `<use>`'s values still reach a symbol's
+        // shapes that set nothing.
+        let sets = |name: &str| {
+            data.attrs().iter().any(|a| &*a.name.local == name) || own_style.contains(name)
+        };
+        if let Some(own) = &own {
+            for (i, name) in NAMES.iter().enumerate() {
+                let Some(value) = &own[i] else { continue };
+                let parent = match inherited {
+                    Some(values) => values[i].as_deref(),
+                    None => Some(INITIAL[i]),
+                };
+                if sets(name) || parent != Some(value.as_str()) {
+                    style.push_str(&format!(";{name}:{value}"));
+                }
+            }
+        }
+        // `opacity` is not inherited. The svg's own is the box's, which
+        // Blitz paints: usvg is not to apply it again.
+        match (inherited, &styles) {
+            (None, _) if sets("opacity") => style.push_str(";opacity:1"),
+            (Some(_), Some(s)) if sets("opacity") || s.clone_opacity() != 1.0 => {
+                style.push_str(&format!(";opacity:{}", s.clone_opacity()))
+            }
+            _ => {}
+        }
+        if !style.is_empty() {
+            out.push_str(" style=\"");
+            encode_quoted_attribute_to_string(style.trim_start_matches(';'), out);
+            out.push('"');
+        }
+
+        if self.children.is_empty() {
+            out.push_str(" />");
+            return;
+        }
+        out.push('>');
+        let inherited = own.as_ref().or(inherited);
+        for &child in &self.children {
+            self.tree()[child].write_svg_source(out, inherited);
+        }
+        out.push_str("</");
+        out.push_str(&data.name.local);
+        out.push('>');
+    }
+}
