+pub(crate) fn is_svg_presentation_attribute(name: &LocalName) -> bool {
+    matches!(
+        name.as_ref(),
+        "color"
+            | "fill"
+            | "fill-opacity"
+            | "fill-rule"
+            | "opacity"
+            | "stroke"
+            | "stroke-dasharray"
+            | "stroke-dashoffset"
+            | "stroke-linecap"
