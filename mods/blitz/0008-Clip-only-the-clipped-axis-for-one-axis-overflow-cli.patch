+    /// Clip a single `clip` axis without clipping the visible axis.
+    fn overflow_clip_path(
+        &self,
+        node: &Node,
+        styles: &ComputedValues,
+        frame: &CssBox,
+    ) -> kurbo::BezPath {
+        let element = node.element_data();
+        if element.and_then(|e| e.text_input_data()).is_some() {
+            return frame.text_input_clip_shape().to_path(0.1);
+        }
+        let box_style = styles.get_box();
+        let display = styles.clone_display();
+        let is_internal_table_box_other_than_cell = display.outside()
+            == DisplayOutside::InternalTable
+            && display.inside() != DisplayInside::TableCell;
+        let contain_paint = box_style.slow_clone_contain().contains(Contain::PAINT)
+            && !display.is_inline_flow()
+            && !is_internal_table_box_other_than_cell;
+        let forced = contain_paint
+            || element.and_then(|e| e.raster_image_data()).is_some()
+            || element.and_then(|e| e.sub_doc_data()).is_some();
+        let open_x = !forced && box_style.overflow_x == Overflow::Visible;
+        let open_y = !forced && box_style.overflow_y == Overflow::Visible;
+        if !open_x && !open_y {
+            return frame.padding_box_path();
+        }
+        let mut rect = frame.padding_box_path().bounding_box();
+        const REACH: f64 = 1.0e6;
+        if open_x {
+            rect.x0 -= REACH;
+            rect.x1 += REACH;
+        }
+        if open_y {
+            rect.y0 -= REACH;
+            rect.y1 += REACH;
+        }
+        rect.to_path(0.1)
+    }
+
