+    /// Reflect a plain-text edit back into the host's DOM so it survives a
+    /// loss of editability. Replace the changed range across existing text
+    /// nodes without removing elements or changing their identities.
+    pub fn commit_editing_host_text(&mut self, id: NodeId, new: &str) {
+        let old = self.nodes[id].text_content();
+        if old == new {
+            return;
+        }
+        let start: usize = old
+            .chars()
+            .zip(new.chars())
+            .take_while(|(a, b)| a == b)
+            .map(|(c, _)| c.len_utf8())
+            .sum();
+        let suffix: usize = old[start..]
+            .chars()
+            .rev()
+            .zip(new[start..].chars().rev())
+            .take_while(|(a, b)| a == b)
+            .map(|(c, _)| c.len_utf8())
+            .sum();
+        let end = old.len() - suffix;
+        let insert = &new[start..new.len() - suffix];
+        let mut stack = vec![id];
+        let mut offset = 0;
+        let mut wrote = false;
+        let mut changes = Vec::new();
+        while let Some(n) = stack.pop() {
+            let node = &self.nodes[n];
+            match &node.data {
+                NodeData::Text(text) => {
+                    let limit = offset + text.content.len();
+                    if limit >= start && offset <= end {
+                        let lo = start.saturating_sub(offset);
+                        let hi = end.min(limit) - offset;
+                        let mut content = text.content.clone();
+                        content.replace_range(lo..hi, if wrote { "" } else { insert });
+                        changes.push((n, content));
+                        wrote = true;
+                    }
+                    offset = limit;
+                }
+                NodeData::Element(_) | NodeData::AnonymousBlock(_) => {
+                    stack.extend(node.children.iter().rev().copied());
+                }
+                _ => {}
+            }
+        }
+        let mut m = self.mutate();
+        for (node, text) in changes {
+            m.set_node_text(node, &text);
+        }
+        if !wrote {
+            let text = m.create_text_node(insert);
+            m.append_children(id, &[text]);
+        }
+    }
