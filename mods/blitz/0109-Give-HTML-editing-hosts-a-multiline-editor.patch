diff --git a/packages/blitz-dom/src/editing.rs b/packages/blitz-dom/src/editing.rs
new file mode 100644
index 000000000..e899e2bfc
--- /dev/null
+++ b/packages/blitz-dom/src/editing.rs
@@ -0,0 +1,338 @@
+//! The plain-text keyboard editor of an HTML editing host. Descendants
+//! keep their own layout. Only visible, editable text and hard breaks
+//! are represented in the editor and eligible for write-back.
+
+use std::ops::Range;
+
+use markup5ever::local_name;
+use style::computed_values::visibility::T as Visibility;
+use stylo_taffy::CopyStyleGetters;
+
+use crate::layout::construct::set_text_style;
+use crate::layout::replaced::is_replaced_element;
+use crate::node::{NodeData, TextInputData};
+use crate::{BaseDocument, DocumentMutator, Node, NodeId, qual_name, stylo_to_parley};
+
+struct Run {
+    node: NodeId,
+    bytes: Range<usize>,
+    line_break: bool,
+}
+
+#[derive(Default)]
+struct EditableText {
+    value: String,
+    runs: Vec<Run>,
+}
+
+fn visible(node: &Node) -> bool {
+    node.primary_styles()
+        .is_some_and(|s| s.get_inherited_box().visibility == Visibility::Visible)
+}
+
+impl EditableText {
+    fn from_host(host: &Node) -> Self {
+        let mut text = Self::default();
+        text.collect(host, host.id);
+        text
+    }
+
+    fn collect(&mut self, node: &Node, host: NodeId) {
+        match &node.data {
+            NodeData::Text(text) => {
+                if !text.content.is_empty() && node.parent_node().is_some_and(visible) {
+                    self.push(node.id, &text.content, false);
+                }
+            }
+            NodeData::Element(el) => {
+                if node
+                    .primary_styles()
+                    .is_none_or(|s| s.get_box().display.is_none())
+                    || node.skips_contents()
+                    || (node.id != host && node.content_editability() == Some(false))
+                    || is_replaced_element(&el.name.local)
+                    || matches!(el.name.local.as_ref(), "textarea" | "select" | "input")
+                {
+                    return;
+                }
+                if el.name.local == local_name!("br") {
+                    if visible(node) {
+                        self.push(node.id, "\n", true);
+                    }
+                } else if el.name.local == local_name!("details")
+                    && el.attr(local_name!("open")).is_none()
+                {
+                    if let Some(summary) =
+                        node.children.iter().map(|&id| node.with(id)).find(|child| {
+                            child.data.is_element_with_tag_name(&local_name!("summary"))
+                        })
+                    {
+                        self.collect(summary, host);
+                    }
+                } else {
+                    for &id in &node.children {
+                        self.collect(node.with(id), host);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn push(&mut self, node: NodeId, text: &str, line_break: bool) {
+        let start = self.value.len();
+        self.value.push_str(text);
+        self.runs.push(Run {
+            node,
+            bytes: start..self.value.len(),
+            line_break,
+        });
+    }
+}
+
+/// The focused editing host's selection in the rendered inline layouts.
+#[derive(Default)]
+pub struct EditingSelection {
+    pub ranges: Vec<(NodeId, Range<usize>)>,
+    pub caret: Option<(NodeId, usize)>,
+}
+
+impl Run {
+    fn inline_range<'a>(
+        &self,
+        doc: &'a BaseDocument,
+    ) -> Option<(NodeId, &'a crate::node::TextLayout, Range<usize>)> {
+        let node = doc.get_node(self.node)?;
+        let root = node.inline_root_ancestor()?;
+        let layout = root.element_data()?.inline_layout_data.as_deref()?;
+        let (_, range) = layout
+            .editing_ranges
+            .iter()
+            .find(|(id, _)| *id == self.node)?;
+        Some((root.id, layout, range.clone()))
+    }
+}
+
+// Layout may collapse whitespace or transform case. Keep cursor offsets on
+// character boundaries in both strings, including their ends.
+fn offset_between(source: &str, target: &str, offset: usize) -> usize {
+    if source == target || offset == 0 {
+        return offset;
+    }
+    if offset >= source.len() {
+        return target.len();
+    }
+    let chars = source
+        .char_indices()
+        .take_while(|(i, _)| *i < offset)
+        .count();
+    target
+        .char_indices()
+        .nth(chars)
+        .map_or(target.len(), |(i, _)| i)
+}
+
+impl BaseDocument {
+    pub(crate) fn sync_editing_host(&mut self, id: NodeId) {
+        let Some(node) = self.get_node(id) else {
+            return;
+        };
+        if !node.is_editing_host() {
+            if let Some(el) = self.nodes[id].element_data_mut() {
+                el.editing_input = None;
+            }
+            return;
+        }
+        let Some(style) = node.primary_styles() else {
+            return;
+        };
+        if !visible(node) || node.skips_contents() || style.get_box().display.is_none() {
+            return;
+        }
+        let text = EditableText::from_host(node).value;
+        let css = stylo_to_parley::style(id, &style);
+        let align = stylo_to_parley::text_align(style.clone_text_align());
+        let direction =
+            stylo_to_parley::base_direction(style.clone_direction(), style.clone_unicode_bidi());
+        let scale = self.viewport.scale();
+        let width = node.final_layout().content_box_width() * scale;
+        drop(style);
+
+        let el = self.nodes[id].element_data_mut().unwrap();
+        let input = el
+            .editing_input
+            .get_or_insert_with(|| Box::new(TextInputData::new(true)));
+        if input.editor.is_composing() {
+            return;
+        }
+        let mut fonts = self.font_ctx.lock().unwrap();
+        input.editor.set_scale(scale);
+        input.editor.set_width((width > 0.0).then_some(width));
+        set_text_style(&mut input.editor, css, align, direction);
+        input.set_text(&mut fonts, &mut self.layout_ctx, &text);
+        input
+            .editor
+            .refresh_layout(&mut fonts, &mut self.layout_ctx);
+    }
+
+    /// Map the keyboard selection into the descendant layouts for paint.
+    pub fn editing_selection(&self) -> EditingSelection {
+        let Some(host) = self
+            .focus_node_id
+            .and_then(|id| self.get_node(id))
+            .filter(|node| node.is_editing_host())
+        else {
+            return EditingSelection::default();
+        };
+        let Some(input) = host
+            .element_data()
+            .and_then(|el| el.editing_input.as_deref())
+        else {
+            return EditingSelection::default();
+        };
+        let (anchor, focus) = input.value_selection();
+        let (lo, hi) = (anchor.min(focus), anchor.max(focus));
+        let source = EditableText::from_host(host);
+        let mut result = EditingSelection::default();
+        for run in &source.runs {
+            let Some((root, layout, rendered)) = run.inline_range(self) else {
+                continue;
+            };
+            let from = &source.value[run.bytes.clone()];
+            let to = &layout.text[rendered.clone()];
+            let map = |i| rendered.start + offset_between(from, to, i - run.bytes.start);
+            if lo == hi && run.bytes.start <= focus && focus <= run.bytes.end {
+                result.caret = Some((root, map(focus)));
+            } else if lo != hi && lo < run.bytes.end && hi > run.bytes.start {
+                let start = map(lo.max(run.bytes.start));
+                let end = map(hi.min(run.bytes.end));
+                if start < end {
+                    result.ranges.push((root, start..end));
+                }
+            }
+        }
+        result
+    }
+
+    /// Move or extend the plain-text selection at a rendered location.
+    pub fn select_editing_host_at(&mut self, id: NodeId, x: f32, y: f32, extend: bool) -> bool {
+        let Some(host) = self.get_node(id).filter(|node| node.is_editing_host()) else {
+            return false;
+        };
+        let hovered = self.find_text_position(x, y);
+        let source = EditableText::from_host(host);
+        let caret = hovered.and_then(|(inline_root, offset)| {
+            source
+                .runs
+                .iter()
+                .filter_map(|run| {
+                    let (root, layout, rendered) = run.inline_range(self)?;
+                    if root != inline_root {
+                        return None;
+                    }
+                    let clamped = offset.clamp(rendered.start, rendered.end);
+                    let rendered_start = rendered.start;
+                    let from = &layout.text[rendered];
+                    let to = &source.value[run.bytes.clone()];
+                    let caret =
+                        run.bytes.start + offset_between(from, to, clamped - rendered_start);
+                    Some((offset.abs_diff(clamped), caret))
+                })
+                .min_by_key(|&(distance, _)| distance)
+                .map(|(_, caret)| caret)
+        });
+        self.clear_text_selection();
+        if let Some(caret) = caret
+            && let Some((value, anchor, _)) = self.text_input_selection(id)
+        {
+            self.set_text_input(id, &value, if extend { anchor } else { caret }, caret);
+        }
+        true
+    }
+
+    /// Write the editor's changed range back into its visible, editable
+    /// sources. Hidden nodes and protected subtrees never enter the map.
+    pub fn commit_editing_host_text(&mut self, id: NodeId, new: &str) {
+        let Some(node) = self.get_node(id).filter(|n| n.is_editing_host()) else {
+            return;
+        };
+        let EditableText { value: old, runs } = EditableText::from_host(node);
+        if old == new {
+            return;
+        }
+        let start: usize = old
+            .chars()
+            .zip(new.chars())
+            .take_while(|(a, b)| a == b)
+            .map(|(c, _)| c.len_utf8())
+            .sum();
+        let suffix: usize = old[start..]
+            .chars()
+            .rev()
+            .zip(new[start..].chars().rev())
+            .take_while(|(a, b)| a == b)
+            .map(|(c, _)| c.len_utf8())
+            .sum();
+        let end = old.len() - suffix;
+        let replacement = &new[start..new.len() - suffix];
+
+        let mut m = self.mutate();
+        let mut wrote = false;
+        for run in runs {
+            let Run {
+                node,
+                bytes,
+                line_break,
+            } = run;
+            if bytes.end < start || bytes.start > end {
+                continue;
+            }
+            let insert = if wrote { "" } else { replacement };
+            if line_break {
+                if !insert.is_empty() {
+                    let nodes = new_lines(&mut m, insert);
+                    if start == bytes.end {
+                        m.insert_nodes_after(node, &nodes);
+                    } else {
+                        m.insert_nodes_before(node, &nodes);
+                    }
+                }
+                if start < bytes.end && end > bytes.start {
+                    m.remove_and_drop_node(node);
+                }
+            } else {
+                let lo = start.saturating_sub(bytes.start);
+                let hi = end.min(bytes.end) - bytes.start;
+                let text = &old[bytes];
+                let updated = format!("{}{insert}{}", &text[..lo], &text[hi..]);
+                if let Some((first, rest)) = updated.split_once('\n') {
+                    m.set_node_text(node, first);
+                    let br = m.create_element(qual_name!("br", html), Vec::new());
+                    let mut nodes = vec![br];
+                    nodes.extend(new_lines(&mut m, rest));
+                    m.insert_nodes_after(node, &nodes);
+                } else {
+                    m.set_node_text(node, &updated);
+                }
+            }
+            wrote = true;
+        }
+        if !wrote && !replacement.is_empty() {
+            let nodes = new_lines(&mut m, replacement);
+            m.append_children(id, &nodes);
+        }
+    }
+}
+
+fn new_lines(m: &mut DocumentMutator<'_>, value: &str) -> Vec<NodeId> {
+    let mut nodes = Vec::new();
+    for (i, text) in value.split('\n').enumerate() {
+        if i > 0 {
+            nodes.push(m.create_element(qual_name!("br", html), Vec::new()));
+        }
+        if !text.is_empty() {
+            nodes.push(m.create_text_node(text));
+        }
+    }
+    nodes
+}
