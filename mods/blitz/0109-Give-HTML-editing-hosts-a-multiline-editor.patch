+    /// An explicitly editable element whose parent does not inherit editability.
+    pub fn is_editing_host(&self) -> bool {
+        self.content_editability() == Some(true)
+            && std::iter::successors(self.parent_node(), |n| n.parent_node())
+                .find_map(Node::content_editability)
+                != Some(true)
+    }
+
+    fn content_editability(&self) -> Option<bool> {
+        let value = self.attr(LocalName::from("contenteditable"))?;
+        if value.is_empty()
+            || value.eq_ignore_ascii_case("true")
+            || value.eq_ignore_ascii_case("plaintext-only")
+        {
+            Some(true)
+        } else if value.eq_ignore_ascii_case("false") {
+            Some(false)
+        } else {
+            None
+        }
+    }
+
     pub fn is_focussable(&self) -> bool {
         self.data
             .downcast_element()
             .map(|el| el.is_focussable)
             .unwrap_or(false)
+            || self.is_editing_host()
