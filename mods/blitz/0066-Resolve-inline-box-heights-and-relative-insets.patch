 }
+
+#[cfg(test)]
+mod inline_height_tests {
+    use super::*;
+    use crate::qual_name;
+
+    #[test]
+    fn inline_block_stretch_height_fills_available_content_height() {
+        let mut doc = BaseDocument::new(DocumentConfig::default());
+        let document = doc.root_node().id;
+        let mut m = doc.mutate();
+        let html = m.create_element(qual_name!("html", html), vec![]);
+        let body = m.create_element(qual_name!("body", html), vec![]);
+        let container = m.create_element(qual_name!("div", html), vec![]);
+        let inline = m.create_element(qual_name!("span", html), vec![]);
+        m.append_children(document, &[html]);
+        m.append_children(html, &[body]);
+        m.append_children(body, &[container]);
+        m.append_children(container, &[inline]);
+        m.set_attribute(container, qual_name!("style"), "height: 100px");
+        m.set_attribute(
+            inline,
+            qual_name!("style"),
+            "display: inline-block; width: 20px; height: stretch",
+        );
+        drop(m);
+        doc.resolve(0.0);
+        assert_eq!(doc.nodes[inline].final_layout().size.height, 100.0);
+    }
+}
+
+#[cfg(all(test, feature = "floats"))]
+mod inline_relative_float_tests {
+    use super::*;
+    use crate::qual_name;
+
+    #[test]
+    fn relative_float_moves_by_its_insets() {
+        let mut doc = BaseDocument::new(DocumentConfig::default());
+        let document = doc.root_node().id;
+        let mut m = doc.mutate();
+        let html = m.create_element(qual_name!("html", html), vec![]);
+        let body = m.create_element(qual_name!("body", html), vec![]);
+        let container = m.create_element(qual_name!("div", html), vec![]);
+        let float = m.create_element(qual_name!("span", html), vec![]);
+        let text = m.create_text_node("text before float");
+        m.append_children(document, &[html]);
+        m.append_children(html, &[body]);
+        m.append_children(body, &[container]);
+        m.append_children(container, &[text, float]);
+        m.set_attribute(
+            float,
+            qual_name!("style"),
+            "float: left; width: 20px; height: 20px",
+        );
+        drop(m);
+        doc.resolve(0.0);
+        let before = doc.get_client_bounding_rect(float).unwrap();
+        doc.mutate().set_attribute(
+            float,
+            qual_name!("style"),
+            "float: left; width: 20px; height: 20px; position: relative; left: 10px; top: 5px",
+        );
+        doc.resolve(0.0);
+        let after = doc.get_client_bounding_rect(float).unwrap();
+        assert_eq!(after.x - before.x, 10.0);
+        assert_eq!(after.y - before.y, 5.0);
+    }
+}
diff --git a/packages/blitz-dom/src/layout/inline/layout.rs b/packages/blitz-dom/src/layout/inline/layout.rs
