+    /// Adds a stylesheet of the user origin: its rules win over the user
+    /// agent's and lose to the document's own, whatever their specificity.
+    pub fn add_user_stylesheet(&mut self, css: &str) {
+        let sheet = self.make_stylesheet(css, Origin::User);
+        self.user_stylesheets.insert(css.to_string(), sheet.clone());
+        self.stylist.append_stylesheet(sheet, &self.guard.read());
+    }
+
+    pub fn remove_user_stylesheet(&mut self, contents: &str) {
+        if let Some(sheet) = self.user_stylesheets.remove(contents) {
+            self.stylist.remove_stylesheet(sheet, &self.guard.read());
+        }
+    }
+
+    /// Iterate over the user stylesheets currently associated with this document
+    pub fn user_stylesheets(&self) -> impl Iterator<Item = &DocumentStyleSheet> {
+        self.user_stylesheets.values()
+    }
