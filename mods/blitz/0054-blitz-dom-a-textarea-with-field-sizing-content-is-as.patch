From 05b9be475d6f6c888663fb336efc7bcc3858e252 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Tue, 10 Nov 2026 00:16:43 +0100
Subject: [PATCH] blitz-dom: a textarea with `field-sizing: content` is as tall
 as its text

A textarea was always `rows` lines tall. With `field-sizing: content` it
is now as tall as its text wrapped at the width it gets, bounded by
min-height and max-height as any box is, and its text scrolls inside it
past the most. An edit that changes the text's height lays it out again.

The pref `layout.css.field-sizing.enabled` is set, as Stylo (in Servo
mode) parses the property only behind it.
---
 packages/blitz-dom/src/document.rs   |  1 +
 packages/blitz-dom/src/layout/mod.rs | 56 +++++++++++++++++++++++-----
 packages/blitz-dom/src/node/text.rs  | 12 ++++--
 3 files changed, 57 insertions(+), 12 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index e8fe598d6..764e0d154 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -96,6 +96,7 @@ pub(crate) fn init_stylo_prefs() {
         style_config::set_pref!("layout.css.text-indent-keywords.enabled", true);
         style_config::set_pref!("layout.css.word-break.break-word.enabled", true);
         style_config::set_pref!("layout.css.scroll-snap.enabled", true);
+        style_config::set_pref!("layout.css.field-sizing.enabled", true);
         #[cfg(feature = "writing-mode")]
         {
             style_config::set_pref!("layout.css.writing-mode.enabled", true);
diff --git a/packages/blitz-dom/src/layout/mod.rs b/packages/blitz-dom/src/layout/mod.rs
index e2c81e736..8b9be5cf2 100644
--- a/packages/blitz-dom/src/layout/mod.rs
+++ b/packages/blitz-dom/src/layout/mod.rs
@@ -326,6 +326,52 @@ impl LayoutPassState<'_> {
                         },
                     };
 
+                    let pb = {
+                        let style = node.layout_style();
+                        style
+                            .padding()
+                            .resolve_or_zero(inputs.parent_size.width, resolve_calc_value)
+                            + style
+                                .border()
+                                .resolve_or_zero(inputs.parent_size.width, resolve_calc_value)
+                    };
+                    let mut size = size;
+                    // `field-sizing: content`: the control is as tall as its text
+                    // wrapped at the width it gets, which a first pass finds;
+                    // min-height and max-height then bound it as for any box
+                    // (https://drafts.csswg.org/css-ui-4/#field-sizing).
+                    let content_sized = node.primary_styles().is_some_and(|s| {
+                        s.get_ui().slow_clone_field_sizing() == style::values::computed::FieldSizing::Content
+                    });
+                    if content_sized {
+                        let first = compute_leaf_layout(
+                            inputs,
+                            &node.layout_style(),
+                            resolve_calc_value,
+                            |_known_size, _available_space| size,
+                        );
+                        let content_width = (first.size.width - pb.horizontal_axis_sum()).max(0.0);
+                        let doc = &mut *self.doc;
+                        let scale = doc.viewport.scale();
+                        let text_height = doc.nodes[dom_node_id(node_id)]
+                            .data
+                            .downcast_element_mut()
+                            .and_then(|el| el.text_input_data_mut())
+                            .and_then(|input| {
+                                input.sizes_to_text = true;
+                                input.editor.set_width(Some(content_width * scale));
+                                input.editor.refresh_layout(
+                                    &mut doc.font_ctx.lock().unwrap(),
+                                    &mut doc.layout_ctx,
+                                );
+                                Some(input.editor.try_layout()?.height() / scale)
+                            });
+                        if let Some(h) = text_height {
+                            size.height = h;
+                        }
+                    }
+
+                    let node = &self.doc.nodes[dom_node_id(node_id)];
                     let output = compute_leaf_layout(
                         inputs,
                         &node.layout_style(),
@@ -333,15 +379,6 @@ impl LayoutPassState<'_> {
                         |_known_size, _available_space| size,
                     );
                     if inputs.run_mode == RunMode::PerformLayout {
-                        let pb = {
-                            let style = node.layout_style();
-                            style
-                                .padding()
-                                .resolve_or_zero(inputs.parent_size.width, resolve_calc_value)
-                                + style
-                                    .border()
-                                    .resolve_or_zero(inputs.parent_size.width, resolve_calc_value)
-                        };
                         let content_width = (output.size.width - pb.horizontal_axis_sum()).max(0.0);
                         let doc = &mut *self.doc;
                         let scale = doc.viewport.scale();
@@ -351,6 +388,7 @@ impl LayoutPassState<'_> {
                             .downcast_element_mut()
                             .and_then(|el| el.text_input_data_mut())
                         {
+                            input.sizes_to_text = content_sized;
                             input.editor.set_width(Some(content_width * scale));
                             input.editor.refresh_layout(
                                 &mut doc.font_ctx.lock().unwrap(),
diff --git a/packages/blitz-dom/src/node/text.rs b/packages/blitz-dom/src/node/text.rs
index 9b33275ba..36eb95135 100644
--- a/packages/blitz-dom/src/node/text.rs
+++ b/packages/blitz-dom/src/node/text.rs
@@ -82,6 +82,10 @@ pub struct TextInputData {
     password: Option<String>,
     /// What the field shows while it is empty, if it has a `placeholder`.
     pub placeholder: Option<Placeholder>,
+    /// Whether layout sizes the field to its text (`field-sizing: content`
+    /// on a textarea), set by layout. An edit that changes the text's
+    /// height then lays the field out again.
+    pub sizes_to_text: bool,
 }
 
 /// A text field's `placeholder`, laid out in the field's `::placeholder`
@@ -131,6 +135,7 @@ impl TextInputData {
             scroll_offset: 0.0,
             password: None,
             placeholder: None,
+            sizes_to_text: false,
         }
     }
 
@@ -220,10 +225,11 @@ impl TextInputData {
     /// The height of a single-line field's text and the baseline of its
     /// line, as laid out, in device pixels: what the field's baseline is
     /// worked out from, so an edit that changes them (a fallback font's
-    /// taller line) lays the field out again. `None` for a multi-line
-    /// field, or one not laid out.
+    /// taller line) lays the field out again. For a multi-line field, only
+    /// one that [`sizes_to_text`](Self::sizes_to_text): the height of all
+    /// its lines. `None` for any other, or one not laid out.
     pub fn line_metrics(&self) -> Option<(f32, f32)> {
-        if self.is_multiline {
+        if self.is_multiline && !self.sizes_to_text {
             return None;
         }
         let layout = self.editor.try_layout()?;
