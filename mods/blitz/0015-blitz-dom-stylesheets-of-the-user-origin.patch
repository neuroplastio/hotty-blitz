+#[cfg(test)]
+mod user_stylesheet_tests {
+    use super::*;
+    use crate::{Attribute, qual_name};
+    use blitz_traits::shell::ColorScheme;
+
+    const USER: &str = "div, p { color: rgb(2, 2, 2); }";
+
+    /// `<div class="a">` and `<p class="a">`: the user agent's rule is more
+    /// specific than the user's, and the document's less specific, for both.
+    fn make_doc() -> (BaseDocument, NodeId, NodeId) {
+        let mut doc = BaseDocument::new(DocumentConfig {
+            viewport: Some(Viewport::new(400, 300, 1.0, ColorScheme::Light)),
+            ua_stylesheets: vec![UserAgentStylesheet::parse(".a { color: rgb(1, 1, 1); }")],
+            user_stylesheets: vec![USER.to_string()],
+            ..Default::default()
+        });
+        let root_id = doc.root_node().id;
+        let class = || Attribute {
+            name: qual_name!("class"),
+            value: "a".to_string(),
+        };
+        let mut mutator = doc.mutate();
+        let html = mutator.create_element(qual_name!("html"), vec![]);
+        let body = mutator.create_element(qual_name!("body"), vec![]);
+        let style = mutator.create_element(qual_name!("style"), vec![]);
+        let css = mutator.create_text_node(":where(p) { color: rgb(3, 3, 3); }");
+        let div = mutator.create_element(qual_name!("div"), vec![class()]);
+        let p = mutator.create_element(qual_name!("p"), vec![class()]);
+        mutator.append_children(style, &[css]);
+        mutator.append_children(body, &[style, div, p]);
+        mutator.append_children(html, &[body]);
+        mutator.append_children(root_id, &[html]);
+        drop(mutator);
+        doc.resolve(0.0);
+        (doc, div, p)
+    }
+
+    /// The red channel, in 0..=255.
+    fn red(doc: &BaseDocument, id: NodeId) -> u8 {
+        let c = doc.nodes[id].primary_styles().unwrap().clone_color();
+        (c.components.0 * 255.0).round() as u8
+    }
+
+    #[test]
+    fn a_user_rule_wins_over_the_user_agents_and_loses_to_the_documents() {
+        let (mut doc, div, p) = make_doc();
+        assert_eq!(
+            red(&doc, div),
+            2,
+            "the user's div wins over the user agent's .a"
+        );
+        assert_eq!(
+            red(&doc, p),
+            3,
+            "the document's :where(p) wins over the user's p"
+        );
+
+        doc.remove_user_stylesheet(USER);
+        doc.resolve(0.0);
+        assert_eq!(red(&doc, div), 1, "without it, the user agent's .a applies");
+        doc.add_user_stylesheet(USER);
+        doc.resolve(0.0);
+        assert_eq!(red(&doc, div), 2);
+    }
+}
