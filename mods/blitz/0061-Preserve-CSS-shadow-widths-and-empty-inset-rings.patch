From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Sat, 14 Nov 2026 12:55:57 +0100
Subject: [PATCH 61/61] Preserve CSS shadow widths and empty inset rings
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The new backend still needs the established Gaussian width correction. Skip coincident unblurred inset rings with nonpositive spread to avoid painting an antialiased seam.

Co-authored-by: Luís Duarte <lduarte@cloudflare.com>

Co-authored-by: bpereira <bpereira@cloudflare.com>
---
 packages/blitz-paint/src/render/box_shadow.rs | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-paint/src/render/box_shadow.rs b/packages/blitz-paint/src/render/box_shadow.rs
index 2eaa6c0e3..5b9e1941b 100644
--- a/packages/blitz-paint/src/render/box_shadow.rs
+++ b/packages/blitz-paint/src/render/box_shadow.rs
@@ -53,6 +53,15 @@ impl ElementCx<'_, '_> {
 
         let padding_box = self.frame.padding_box_shape();
         for shadow in box_shadow.iter().filter(|s| s.inset).rev() {
+            // An unblurred, unshifted inset with no positive spread has no
+            // visible ring. Avoid rasterizing a coincident clipping boundary.
+            if shadow.base.blur.px() == 0.0
+                && shadow.base.horizontal.px() == 0.0
+                && shadow.base.vertical.px() == 0.0
+                && shadow.spread.px() <= 0.0
+            {
+                continue;
+            }
             self.draw_box_shadow(scene, shadow, &padding_box, BoxShadowKind::Inset);
         }
     }
@@ -79,11 +88,16 @@ impl ElementCx<'_, '_> {
             shadow.base.vertical.px() as f64,
         ) * self.scale;
         let mut spread = shadow.spread.px() as f64 * self.scale;
-        if matches!(kind, BoxShadowKind::Inset) && shadow.base.blur.px() == 0.0 && offset == Vec2::ZERO && spread > 0.0 && matches!(self.transform.as_coeffs(), [1.0, 0.0, 0.0, 1.0, _, _]) {
+        if matches!(kind, BoxShadowKind::Inset)
+            && shadow.base.blur.px() == 0.0
+            && offset == Vec2::ZERO
+            && spread > 0.0
+            && matches!(self.transform.as_coeffs(), [1.0, 0.0, 0.0, 1.0, _, _])
+        {
             spread = spread.floor().max(1.0);
         }
         // The standard deviation of a CSS shadow's blur is half of its blur radius
-        let std_dev = shadow.base.blur.px() as f64 * self.scale / 2.0;
+        let std_dev = shadow.base.blur.px() as f64 * self.scale * std::f64::consts::FRAC_1_SQRT_2;
 
         scene.draw_box_shadow(
             self.transform,
