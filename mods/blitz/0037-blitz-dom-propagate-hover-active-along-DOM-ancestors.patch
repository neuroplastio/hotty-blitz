From 2bcae725a594d3d2abfffa5d1d5f125916a07572 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Fri, 23 Oct 2026 09:13:43 +0200
Subject: [PATCH] blitz-dom: propagate :hover/:active along DOM ancestors
 (backport of #985)

This is upstream's 8ea8bd6b, "Propagate :hover/:active along DOM
ancestors instead of layout ancestors (#985)" by Nico Burns, on
674d7d21, plus a test for a table row.

set_hover_to, clear_hover, active_node and unactive_node set and cleared
the HOVER and ACTIVE states along the target's layout ancestors. The
layout tree skips elements that those selectors must match: a table's
cells are the table's layout children, so tr:hover and tbody:hover never
matched, and neither did :hover on an element with display: contents or
on the inline ancestors of an inline box. The states now follow the
target's ancestor elements in the DOM (node_element_ancestors), which is
where :hover and :active match. Hit testing still uses layout.

The added test, hover_and_active_propagate_to_table_row_of_cell, hovers
and presses a cell, then checks its row and row group.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/blitz-dom/src/document.rs            |  10 +-
 packages/blitz-dom/src/traversal.rs           |  14 +-
 .../blitz-tests/tests/hover_dom_ancestors.rs  | 127 ++++++++++++++++++
 3 files changed, 142 insertions(+), 9 deletions(-)
 create mode 100644 tests/blitz-tests/tests/hover_dom_ancestors.rs

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index d16dc5b3..ae82eef5 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -1851,7 +1851,7 @@ impl BaseDocument {
         );
         let active_node_id = Some(hover_node_id);
 
-        let node_path = self.maybe_node_layout_ancestors(active_node_id);
+        let node_path = self.maybe_node_element_ancestors(active_node_id);
         for &id in node_path.iter() {
             self.snapshot_node_and(id, ElementState::ACTIVE, |node| node.active());
         }
@@ -1866,7 +1866,7 @@ impl BaseDocument {
             return false;
         };
 
-        let node_path = self.maybe_node_layout_ancestors(Some(active_node_id));
+        let node_path = self.maybe_node_element_ancestors(Some(active_node_id));
         for &id in node_path.iter() {
             self.snapshot_node_and(id, ElementState::ACTIVE, |node| node.unactive());
         }
@@ -2000,8 +2000,8 @@ impl BaseDocument {
             return scrollbar_changed;
         }
 
-        let old_node_path = self.maybe_node_layout_ancestors(self.hover_node_id);
-        let new_node_path = self.maybe_node_layout_ancestors(hover_node_id);
+        let old_node_path = self.maybe_node_element_ancestors(self.hover_node_id);
+        let new_node_path = self.maybe_node_element_ancestors(hover_node_id);
         let same_count = old_node_path
             .iter()
             .zip(&new_node_path)
@@ -2035,7 +2035,7 @@ impl BaseDocument {
             return false;
         };
 
-        let old_node_path = self.maybe_node_layout_ancestors(Some(hover_node_id));
+        let old_node_path = self.maybe_node_element_ancestors(Some(hover_node_id));
         for &id in old_node_path.iter() {
             self.snapshot_node_and(id, ElementState::HOVER, |node| node.unhover());
         }
diff --git a/packages/blitz-dom/src/traversal.rs b/packages/blitz-dom/src/traversal.rs
index 40719159..bbab9315 100644
--- a/packages/blitz-dom/src/traversal.rs
+++ b/packages/blitz-dom/src/traversal.rs
@@ -281,20 +281,26 @@ impl BaseDocument {
         }
     }
 
-    pub fn node_layout_ancestors(&self, node_id: NodeId) -> Vec<NodeId> {
+    /// `node_id` and its ancestor elements in the DOM, root first. These are
+    /// the elements that match `:hover`/`:active` when `node_id` does.
+    pub fn node_element_ancestors(&self, node_id: NodeId) -> Vec<NodeId> {
         let mut ancestors = Vec::with_capacity(12);
         let mut maybe_id = Some(node_id);
         while let Some(id) = maybe_id {
+            let node = &self.nodes[id];
+            if !node.is_element() {
+                break;
+            }
             ancestors.push(id);
-            maybe_id = self.nodes[id].layout_parent.get();
+            maybe_id = node.parent;
         }
         ancestors.reverse();
         ancestors
     }
 
-    pub fn maybe_node_layout_ancestors(&self, node_id: Option<NodeId>) -> Vec<NodeId> {
+    pub fn maybe_node_element_ancestors(&self, node_id: Option<NodeId>) -> Vec<NodeId> {
         node_id
-            .map(|id| self.node_layout_ancestors(id))
+            .map(|id| self.node_element_ancestors(id))
             .unwrap_or_default()
     }
 
diff --git a/tests/blitz-tests/tests/hover_dom_ancestors.rs b/tests/blitz-tests/tests/hover_dom_ancestors.rs
new file mode 100644
index 00000000..d28d53a6
--- /dev/null
+++ b/tests/blitz-tests/tests/hover_dom_ancestors.rs
@@ -0,0 +1,127 @@
+//! `:hover` and `:active` propagate along DOM ancestors, not the box tree, so
+//! elements that the box tree skips (e.g. `display:contents` wrappers, inline
+//! ancestors of an atomic inline box) still match.
+
+use blitz_dom::{DocumentConfig, NodeId};
+use blitz_html::{HtmlDocument, HtmlProvider};
+use blitz_traits::shell::{ColorScheme, Viewport};
+use std::sync::Arc;
+
+fn make_doc(html: &str) -> HtmlDocument {
+    let mut doc = HtmlDocument::from_html(
+        html,
+        DocumentConfig {
+            viewport: Some(Viewport::new(400, 300, 1.0, ColorScheme::Light)),
+            html_parser_provider: Some(Arc::new(HtmlProvider) as _),
+            ..Default::default()
+        },
+    );
+    doc.resolve(0.0);
+    doc
+}
+
+fn node_id(doc: &HtmlDocument, selector: &str) -> NodeId {
+    doc.query_selector(selector).unwrap().expect(selector)
+}
+
+fn is_hovered(doc: &HtmlDocument, id: NodeId) -> bool {
+    doc.get_node(id).unwrap().is_hovered()
+}
+
+fn is_active(doc: &HtmlDocument, id: NodeId) -> bool {
+    doc.get_node(id).unwrap().is_active()
+}
+
+#[test]
+fn hover_propagates_to_display_contents_ancestor() {
+    let mut doc = make_doc(
+        r#"<!DOCTYPE html><html><body style="margin:0">
+        <div id="wrapper" style="display:contents"><div id="inner" style="height:50px"></div></div>
+        </body></html>"#,
+    );
+    let wrapper = node_id(&doc, "#wrapper");
+    let inner = node_id(&doc, "#inner");
+
+    doc.set_hover_to(10.0, 10.0);
+    assert_eq!(doc.get_hover_node_id(), Some(inner));
+    assert!(is_hovered(&doc, inner));
+    assert!(is_hovered(&doc, wrapper));
+
+    doc.set_hover_to(10.0, 200.0);
+    assert!(!is_hovered(&doc, inner));
+    assert!(!is_hovered(&doc, wrapper));
+}
+
+#[test]
+fn hover_and_active_propagate_to_inline_ancestors_of_inline_box() {
+    let mut doc = make_doc(
+        r#"<!DOCTYPE html><html><body style="margin:0">
+        <p id="p" style="margin:0"><a id="a" href="/link"><span id="icon" style="display:inline-block;width:30px;height:30px"></span></a></p>
+        </body></html>"#,
+    );
+    let ids = [
+        node_id(&doc, "#p"),
+        node_id(&doc, "#a"),
+        node_id(&doc, "#icon"),
+    ];
+
+    doc.set_hover_to(10.0, 10.0);
+    assert_eq!(doc.get_hover_node_id(), Some(ids[2]));
+    for id in ids {
+        assert!(is_hovered(&doc, id));
+    }
+
+    doc.active_node();
+    for id in ids {
+        assert!(is_active(&doc, id));
+    }
+    doc.unactive_node();
+    for id in ids {
+        assert!(!is_active(&doc, id));
+    }
+
+    doc.set_hover_to(10.0, 200.0);
+    for id in ids {
+        assert!(!is_hovered(&doc, id));
+    }
+}
+
+#[test]
+fn hover_and_active_propagate_to_table_row_of_cell() {
+    // A table's cells are the table's own boxes: its rows and row groups
+    // are skipped by the box tree.
+    let mut doc = make_doc(
+        r#"<!DOCTYPE html><html><body style="margin:0">
+        <table style="border-spacing:0"><tbody id="tbody">
+        <tr id="first"><td id="cell" style="width:100px;height:50px;padding:0"></td></tr>
+        <tr id="second"><td style="width:100px;height:50px;padding:0"></td></tr>
+        </tbody></table>
+        </body></html>"#,
+    );
+    let tbody = node_id(&doc, "#tbody");
+    let first = node_id(&doc, "#first");
+    let second = node_id(&doc, "#second");
+    let cell = node_id(&doc, "#cell");
+
+    doc.set_hover_to(10.0, 10.0);
+    assert_eq!(doc.get_hover_node_id(), Some(cell));
+    for id in [cell, first, tbody] {
+        assert!(is_hovered(&doc, id));
+    }
+    assert!(!is_hovered(&doc, second));
+
+    doc.active_node();
+    assert!(is_active(&doc, first));
+    doc.unactive_node();
+    assert!(!is_active(&doc, first));
+
+    doc.set_hover_to(10.0, 60.0);
+    assert!(!is_hovered(&doc, first));
+    assert!(is_hovered(&doc, second));
+    assert!(is_hovered(&doc, tbody));
+
+    doc.set_hover_to(10.0, 200.0);
+    for id in [first, second, tbody] {
+        assert!(!is_hovered(&doc, id));
+    }
+}
