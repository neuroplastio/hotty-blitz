From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ruskin Constant <ruskin@cloudflare.com>
Date: Wed, 16 Sep 2026 12:34:44 +0100
Subject: [PATCH] Preserve explicit font feature overrides

---
 packages/blitz-dom/src/stylo_to_parley.rs | 24 +++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/packages/blitz-dom/src/stylo_to_parley.rs b/packages/blitz-dom/src/stylo_to_parley.rs
index eff4c9e21..ad79deac2 100644
--- a/packages/blitz-dom/src/stylo_to_parley.rs
+++ b/packages/blitz-dom/src/stylo_to_parley.rs
@@ -307,9 +307,8 @@ pub(crate) fn font_variant_east_asian(
 /// high-level `font-variant-*` properties are applied first, and the low-level
 /// `font-feature-settings` property is applied last so that it takes precedence.
 ///
-/// Parley stably sorts the feature list by tag and HarfBuzz applies the last of any
-/// duplicate tags, so appending `font-feature-settings` after the `font-variant-*`
-/// features gives it the higher precedence required by the spec.
+/// After appending explicit settings, deduplicate by tag while keeping the
+/// final value so those settings take precedence over variants.
 pub(crate) fn font_features(font_styles: &stylo::Font) -> Vec<parley::FontFeature> {
     let mut features = Vec::new();
 
@@ -321,9 +320,15 @@ pub(crate) fn font_features(font_styles: &stylo::Font) -> Vec<parley::FontFeatur
 
     self::font_feature_settings(&font_styles.font_feature_settings, &mut features);
 
+    dedup_features(features)
+}
+
+fn dedup_features(mut features: Vec<parley::FontFeature>) -> Vec<parley::FontFeature> {
+    // The explicit settings were appended last and take precedence. Reversing
+    // before the stable sort makes dedup retain the last entry for each tag.
+    features.reverse();
     features.sort_by_key(|feature| feature.tag);
     features.dedup_by_key(|feature| feature.tag);
-
     features
 }
 
@@ -711,4 +716,15 @@ mod tests {
         let last_tnum = flat.iter().rev().find(|(tag, _)| tag == b"tnum").unwrap();
         assert_eq!(last_tnum.1, 0);
     }
+
+    #[test]
+    fn dedup_preserves_explicit_feature_over_variant() {
+        let mut out = Vec::new();
+        font_variant_caps(stylo::FontVariantCaps::AllSmallCaps, &mut out);
+        font_feature_settings(&feature_settings(&[(b"smcp", 0)]), &mut out);
+        assert_eq!(
+            pairs(&dedup_features(out)),
+            vec![(*b"c2sc", 1), (*b"smcp", 0)]
+        );
+    }
 }
