From 30f62c724831a666eddbbe693edfa3a91bdcb936 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Thu, 22 Oct 2026 11:05:22 +0200
Subject: [PATCH] blitz-dom: a text input's baseline is its text's

A single-line text input is a leaf with no baseline, so a flex line
with `align-items: baseline` put its bottom edge on the line's
baseline, and so did an inline formatting context: the input's text sat
higher than the text beside it. A browser aligns the input's text.

The input's first and last baselines are now its line's baseline,
placed as blitz-paint draws the text: centred in the content box
(Node::text_input_v_centering_offset). TextInputData::line_metrics gives
the line's height and baseline.

Those depend on the text: a fallback font (CJK, say) can make the line
taller and move its baseline, as it does in a browser. An edit that
changes them, by a key, IME, the value attribute, set_text_input or
with_text_input, marks the input ONLY_RELAYOUT, so what is aligned with
it moves with it. An edit that does not costs no layout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/blitz-dom/src/document.rs        | 12 +++++++--
 packages/blitz-dom/src/events/ime.rs      |  5 ++++
 packages/blitz-dom/src/events/keyboard.rs |  5 ++++
 packages/blitz-dom/src/layout/mod.rs      | 32 ++++++++++++++++++++++-
 packages/blitz-dom/src/mutator.rs         | 11 +++++++-
 packages/blitz-dom/src/node/text.rs       | 13 +++++++++
 6 files changed, 74 insertions(+), 4 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index 2d0f489f..b5fc36c5 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -1,7 +1,7 @@
 use crate::NodeTree;
 use crate::events::{DragMode, handle_dom_event};
 use crate::layout::construct::ConstructionTask;
-use crate::layout::damage::ALL_DAMAGE;
+use crate::layout::damage::{ALL_DAMAGE, ONLY_RELAYOUT};
 use crate::layout::inline::{InlineBoxId, inline_edge_size};
 use crate::mutator::ViewportMut;
 use crate::net::{
@@ -2650,10 +2650,14 @@ impl BaseDocument {
             .element_data_mut()
             .and_then(|el| el.text_input_data_mut())
         {
+            let before = text_input.line_metrics();
             let mut font_ctx = self.font_ctx.lock().unwrap();
             let layout_ctx = &mut self.layout_ctx;
             let driver = text_input.editor.driver(&mut font_ctx, layout_ctx);
-            cb(driver)
+            cb(driver);
+            if text_input.line_metrics() != before {
+                node.insert_damage(ONLY_RELAYOUT);
+            }
         }
     }
 
@@ -2677,9 +2681,13 @@ impl BaseDocument {
         else {
             return;
         };
+        let before = input.line_metrics();
         let mut font_ctx = self.font_ctx.lock().unwrap();
         input.set_value_selection(&mut font_ctx, &mut self.layout_ctx, value, anchor, focus);
         drop(font_ctx);
+        if input.line_metrics() != before {
+            self.nodes[node_id].insert_damage(ONLY_RELAYOUT);
+        }
         self.clamp_text_input_scroll(node_id);
         self.shell_provider.request_redraw();
     }
diff --git a/packages/blitz-dom/src/events/ime.rs b/packages/blitz-dom/src/events/ime.rs
index 6338a279..a7993892 100644
--- a/packages/blitz-dom/src/events/ime.rs
+++ b/packages/blitz-dom/src/events/ime.rs
@@ -1,6 +1,7 @@
 use blitz_traits::events::{BlitzImeEvent, DomEvent};
 
 use crate::BaseDocument;
+use crate::layout::damage::ONLY_RELAYOUT;
 
 pub(crate) fn handle_ime_event<F: FnMut(DomEvent)>(
     doc: &mut BaseDocument,
@@ -14,11 +15,15 @@ pub(crate) fn handle_ime_event<F: FnMut(DomEvent)>(
             .downcast_element_mut()
             .and_then(|el| el.text_input_data_mut());
         if let Some(input_data) = text_input_data {
+            let before = input_data.line_metrics();
             let generated_event = input_data.apply_ime_event(
                 &mut doc.font_ctx.lock().unwrap(),
                 &mut doc.layout_ctx,
                 event,
             );
+            if input_data.line_metrics() != before {
+                node.insert_damage(ONLY_RELAYOUT);
+            }
 
             if let Some(generated_event) = generated_event {
                 doc.apply_generated_text_input_event(node_id, generated_event, dispatch_event);
diff --git a/packages/blitz-dom/src/events/keyboard.rs b/packages/blitz-dom/src/events/keyboard.rs
index 6c7aefb9..4e25bf81 100644
--- a/packages/blitz-dom/src/events/keyboard.rs
+++ b/packages/blitz-dom/src/events/keyboard.rs
@@ -1,4 +1,5 @@
 use crate::events::focus::generate_focus_events;
+use crate::layout::damage::ONLY_RELAYOUT;
 use crate::{BaseDocument, node::GeneratedTextInputEvent, util::ACTION_MOD};
 use blitz_traits::node_id::NodeId;
 use blitz_traits::{
@@ -76,6 +77,7 @@ pub(crate) fn handle_key_or_input_event<F: FnMut(DomEvent)>(
         };
 
         if let Some(input_data) = element_data.text_input_data_mut() {
+            let before = input_data.line_metrics();
             let generated_event = match event {
                 KeyboardOrTextInputEvent::KeyPress(blitz_key_event) => input_data
                     .apply_keypress_event(
@@ -92,6 +94,9 @@ pub(crate) fn handle_key_or_input_event<F: FnMut(DomEvent)>(
                         &command,
                     ),
             };
+            if input_data.line_metrics() != before {
+                node.insert_damage(ONLY_RELAYOUT);
+            }
 
             if let Some(generated_event) = generated_event {
                 doc.apply_generated_text_input_event(node_id, generated_event, dispatch_event);
diff --git a/packages/blitz-dom/src/layout/mod.rs b/packages/blitz-dom/src/layout/mod.rs
index d7e13364..901483de 100644
--- a/packages/blitz-dom/src/layout/mod.rs
+++ b/packages/blitz-dom/src/layout/mod.rs
@@ -284,12 +284,42 @@ impl BaseDocument {
                                     height: 16.0,
                                 },
                             };
-                            return compute_leaf_layout(
+                            let mut output = compute_leaf_layout(
                                 inputs,
                                 &node.layout_style(),
                                 resolve_calc_value,
                                 |_known_size, _available_space| size,
                             );
+
+                            // The input's baseline is its text's, where blitz-paint draws it:
+                            // centred in the content box (`Node::text_input_v_centering_offset`).
+                            // An edit that changes the text's line metrics lays the input out
+                            // again (`TextInputData::line_metrics`).
+                            let scale = self.viewport.scale();
+                            let text = node
+                                .element_data()
+                                .and_then(|el| el.text_input_data())
+                                .and_then(|input| input.line_metrics())
+                                .map(|(height, baseline)| (height / scale, baseline / scale));
+                            if let Some((text_height, text_baseline)) = text {
+                                let style = node.layout_style();
+                                let padding = style
+                                    .padding()
+                                    .resolve_or_zero(inputs.parent_size.width, resolve_calc_value);
+                                let border = style
+                                    .border()
+                                    .resolve_or_zero(inputs.parent_size.width, resolve_calc_value);
+                                let content_box_height = output.size.height
+                                    - padding.vertical_axis_sum()
+                                    - border.vertical_axis_sum();
+                                let offset = ((content_box_height - text_height) / 2.0).max(0.0);
+                                let baseline = border.top + padding.top + offset + text_baseline;
+                                output.baselines = taffy::Baselines {
+                                    first: Some(baseline),
+                                    last: Some(baseline),
+                                };
+                            }
+                            return output;
                         }
                         _ => {}
                     }
diff --git a/packages/blitz-dom/src/mutator.rs b/packages/blitz-dom/src/mutator.rs
index fe85c1fa..cdcb5271 100644
--- a/packages/blitz-dom/src/mutator.rs
+++ b/packages/blitz-dom/src/mutator.rs
@@ -3,7 +3,7 @@ use std::collections::HashSet;
 use std::mem;
 use std::ops::{Deref, DerefMut};
 
-use crate::layout::damage::ALL_DAMAGE;
+use crate::layout::damage::{ALL_DAMAGE, ONLY_RELAYOUT};
 use crate::net::{ImageHandler, ResourceHandler, StylesheetHandler};
 use crate::node::{CanvasData, NodeFlags, SpecialElementData};
 use crate::stylo_device::DeviceChanges;
@@ -364,11 +364,15 @@ impl DocumentMutator<'_> {
         if *attr == local_name!("value") {
             if let Some(input_data) = element.text_input_data_mut() {
                 // Update text input value
+                let before = input_data.line_metrics();
                 input_data.set_text(
                     &mut self.doc.font_ctx.lock().unwrap(),
                     &mut self.doc.layout_ctx,
                     value,
                 );
+                if input_data.line_metrics() != before {
+                    node.insert_damage(ONLY_RELAYOUT);
+                }
             }
             return;
         }
@@ -510,12 +514,17 @@ impl DocumentMutator<'_> {
         // Update text input value
         if name.local == local_name!("value") {
             if let Some(input_data) = element.text_input_data_mut() {
+                let before = input_data.line_metrics();
                 input_data.set_text(
                     &mut self.doc.font_ctx.lock().unwrap(),
                     &mut self.doc.layout_ctx,
                     "",
                 );
+                if input_data.line_metrics() != before {
+                    node.insert_damage(ONLY_RELAYOUT);
+                }
             }
+            return;
         }
 
         let tag = &element.name.local;
diff --git a/packages/blitz-dom/src/node/text.rs b/packages/blitz-dom/src/node/text.rs
index 97e26a92..2bc19161 100644
--- a/packages/blitz-dom/src/node/text.rs
+++ b/packages/blitz-dom/src/node/text.rs
@@ -196,6 +196,19 @@ impl TextInputData {
             .move_to_byte(byte_at(&masked, caret));
     }
 
+    /// The height of a single-line field's text and the baseline of its
+    /// line, as laid out, in device pixels: what the field's baseline is
+    /// worked out from, so an edit that changes them (a fallback font's
+    /// taller line) lays the field out again. `None` for a multi-line
+    /// field, or one not laid out.
+    pub fn line_metrics(&self) -> Option<(f32, f32)> {
+        if self.is_multiline {
+            return None;
+        }
+        let layout = self.editor.try_layout()?;
+        Some((layout.height(), layout.lines().next()?.metrics().baseline))
+    }
+
     pub fn set_text(
         &mut self,
         font_ctx: &mut FontContext,
