new file mode 100644
index 000000000..a3c444afa
--- /dev/null
+++ b/packages/blitz-dom/src/layout/cache.rs
@@ -0,0 +1,245 @@
+//! A layout cache that grows to the number of measurements a node receives.
+//!
+//! Taffy's `Cache` keeps 9 measure entries per node. A content-sized
+//! container nested k levels deep is measured under about 3 + 5k distinct
+//! constraints in one layout pass (each ancestor's intrinsic sizing pass adds
+//! its own set). Past the second level those entries evict each other in a
+//! cycle, so an incremental relayout misses on every unchanged sibling of the
+//! changed path, and the misses cascade down the siblings' subtrees: a change
+//! to one cell costs O(N).
+//!
+//! This cache matches entries exactly as Taffy's does (the key and the mode
+//! below are Taffy's `CacheKey` and `CacheMode`, taffy c256056
+//! `src/tree/cache.rs`) and differs only in capacity: measure entries grow
+//! as a node needs them, up to `MAX_ENTRIES`, and a node measured once costs
+//! no allocation.
+//!
+//! It also keeps each request's full input, so that `speculate` can ask a
+//! changed node everything its parent asked it last time.
+
+// The float bit patterns below are grouped as sign, exponent, mantissa.
+#![allow(clippy::unusual_byte_groupings)]
+
+use taffy::{AvailableSpace, CollapsibleMarginSet, LayoutInput, LayoutOutput, RequestedAxis};
+use taffy::{RunMode, Size, SizingMode};
+
+/// Past this many entries, the oldest entry is replaced.
+const MAX_ENTRIES: usize = 64;
+
+const INFINITY_BITS: u32 = 0b_0_11111111_00000000000000000000000_u32;
+const NEG_INFINITY_BITS: u32 = 0b_1_11111111_00000000000000000000000_u32;
+const SIGN_BIT_1: u64 = 1u64 << 63;
+const SIGN_BIT_2: u64 = 1u64 << 31;
+const BOTH_SIGN_BITS_MASK: u64 = SIGN_BIT_1 | SIGN_BIT_2;
+const NON_SIGN_BITS_MASK: u64 = !BOTH_SIGN_BITS_MASK;
+const X_AXIS_VALUE_MASK: u64 = (u32::MAX as u64) << 32;
+
+fn option_key(input: Option<f32>) -> u32 {
+    input.map(f32::to_bits).unwrap_or(INFINITY_BITS)
+}
+
+fn available_space_key(input: AvailableSpace) -> u32 {
+    match input {
+        AvailableSpace::Definite(value) => (-value).to_bits(),
+        AvailableSpace::MinContent => NEG_INFINITY_BITS,
+        AvailableSpace::MaxContent => INFINITY_BITS,
+    }
+}
+
+fn mixed_key(kd: Option<f32>, avs: AvailableSpace) -> u32 {
+    kd.map(f32::to_bits)
+        .unwrap_or_else(|| available_space_key(avs))
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct Key {
+    kd_available_space: u64,
+    parent_size: u64,
+    known_dimensions_are_definite: Size<bool>,
+}
+
+impl Key {
+    fn new(input: &LayoutInput) -> Self {
+        let axis_bits = match input.axis {
+            RequestedAxis::Horizontal => SIGN_BIT_1,
+            RequestedAxis::Vertical => SIGN_BIT_2,
+            RequestedAxis::Both => SIGN_BIT_1 | SIGN_BIT_2,
+        };
+        let kd = input.known_dimensions;
+        let avs = input.available_space;
+        let parent = (option_key(input.parent_size.width) as u64) << 32
+            | option_key(input.parent_size.height) as u64;
+        Self {
+            kd_available_space: (mixed_key(kd.width, avs.width) as u64) << 32
+                | mixed_key(kd.height, avs.height) as u64,
+            parent_size: (parent & NON_SIGN_BITS_MASK) | axis_bits,
+            known_dimensions_are_definite: input
+                .known_dimensions_are_definite
+                .zip_map(kd, |is_definite, kd| is_definite || kd.is_none()),
+        }
+    }
+
+    fn x_axis_parent_size(&self) -> u64 {
+        self.parent_size & (X_AXIS_VALUE_MASK & NON_SIGN_BITS_MASK)
+    }
+
+    fn axis_bits(&self) -> u64 {
+        self.parent_size & BOTH_SIGN_BITS_MASK
+    }
+
+    /// Whether an entry stored under `self` answers a lookup for `other`.
+    fn measures(&self, other: &Key) -> bool {
+        self.kd_available_space == other.kd_available_space
+            && self.known_dimensions_are_definite == other.known_dimensions_are_definite
+            && self.x_axis_parent_size() == other.x_axis_parent_size()
+            && (self.axis_bits() == BOTH_SIGN_BITS_MASK || self.axis_bits() == other.axis_bits())
+    }
+}
+
+/// The inputs that Taffy keeps out of the key and records once per cache:
+/// the sizing mode and which vertical margins collapse. A node's parent
+/// algorithm and its own style decide them, so a lookup in another mode
+/// misses, and a store in another mode drops every entry first.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct Mode(u8);
+
+impl Mode {
+    const INITIAL: Self = Self(0);
+
+    fn new(input: &LayoutInput) -> Self {
+        let inherent = matches!(input.sizing_mode, SizingMode::InherentSize) as u8;
+        let margins = input.vertical_margins_are_collapsible;
+        Self(inherent | (margins.start as u8) << 1 | (margins.end as u8) << 2)
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct LayoutCache {
+    mode: Mode,
+    final_layout: Option<(Key, LayoutInput, LayoutOutput)>,
+    measures: Vec<(Key, LayoutInput, Size<f32>)>,
+    /// The entry to replace next once `measures` is full.
+    next: usize,
+    /// A request was answered but not kept (the cache was full, or the
+    /// result carried margin-collapse metadata), so the entries are not
+    /// everything the node was asked.
+    incomplete: bool,
+}
+
+impl Default for LayoutCache {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl LayoutCache {
+    pub const fn new() -> Self {
+        Self {
+            mode: Mode::INITIAL,
+            final_layout: None,
+            measures: Vec::new(),
+            next: 0,
+            incomplete: false,
+        }
+    }
+
+    pub fn get(&self, input: &LayoutInput) -> Option<LayoutOutput> {
+        if self.mode != Mode::new(input) {
+            return None;
+        }
+        let key = Key::new(input);
+        match input.run_mode {
+            RunMode::PerformLayout => self
+                .final_layout
+                .as_ref()
+                .filter(|(k, _, _)| *k == key)
+                .map(|(_, _, output)| output.clone()),
+            RunMode::ComputeSize => self
+                .measures
+                .iter()
+                .find(|(k, _, _)| k.measures(&key))
+                .map(|(_, _, size)| LayoutOutput::from_outer_size(*size)),
+            RunMode::PerformHiddenLayout => None,
+        }
+    }
+
+    pub fn store(&mut self, input: &LayoutInput, output: LayoutOutput) {
+        if input.run_mode == RunMode::PerformHiddenLayout {
+            return;
+        }
+        let mode = Mode::new(input);
+        if self.mode != mode {
+            // What the node was asked before is gone, so `requests` no
+            // longer covers it.
+            let dropped = self.final_layout.is_some() || !self.measures.is_empty();
+            self.clear();
+            self.mode = mode;
+            self.incomplete = dropped;
+        }
+        let key = Key::new(input);
+        match input.run_mode {
+            RunMode::PerformLayout => self.final_layout = Some((key, *input, output)),
+            RunMode::ComputeSize => {
+                // A hit is rebuilt from the size alone, which drops the
+                // margin-collapse metadata, so results carrying it are not
+                // cached (as in Taffy).
+                if output.margins_can_collapse_through
+                    || output.top_margin != CollapsibleMarginSet::ZERO
+                    || output.bottom_margin != CollapsibleMarginSet::ZERO
+                {
+                    self.incomplete = true;
+                    return;
+                }
+                if let Some(entry) = self.measures.iter_mut().find(|(k, _, _)| *k == key) {
+                    entry.2 = output.size;
+                } else if self.measures.len() < MAX_ENTRIES {
+                    self.measures.push((key, *input, output.size));
+                } else {
+                    self.measures[self.next] = (key, *input, output.size);
+                    self.next = (self.next + 1) % MAX_ENTRIES;
+                    self.incomplete = true;
+                }
+            }
+            RunMode::PerformHiddenLayout => {}
+        }
+    }
+
+    pub fn clear(&mut self) {
+        self.final_layout = None;
+        self.measures.clear();
+        self.next = 0;
+        self.incomplete = false;
+    }
+
+    /// Every request kept, with its answer: measurements first, then the
+    /// final layout. `None` when the cache is empty or incomplete.
+    pub(crate) fn requests(&self) -> Option<Vec<(LayoutInput, Answer)>> {
+        if self.incomplete || (self.final_layout.is_none() && self.measures.is_empty()) {
+            return None;
+        }
+        let measures = self
+            .measures
+            .iter()
+            .map(|(_, input, size)| (*input, Answer::Size(*size)));
+        let layout = self
+            .final_layout
+            .iter()
+            .map(|(_, input, output)| (*input, Answer::Layout(output.clone())));
+        Some(measures.chain(layout).collect())
+    }
+}
+
+/// What a node answered to one request.
+pub(crate) enum Answer {
+    Size(Size<f32>),
+    Layout(LayoutOutput),
+}
+
+impl Answer {
+    pub(crate) fn matches(&self, output: &LayoutOutput) -> bool {
+        match self {
+            Answer::Size(size) => output.size == *size,
+            Answer::Layout(old) => output == old,
+        }
+    }
+}
