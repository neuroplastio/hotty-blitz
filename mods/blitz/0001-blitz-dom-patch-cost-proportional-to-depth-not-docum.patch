index 000000000..8eab052a9
--- /dev/null
+++ b/packages/blitz-dom/src/layout/round.rs
@@ -0,0 +1,206 @@
+//! Incremental layout rounding.
+//!
+//! `taffy::round_layout` rewrites the final layout of every node on every
+//! resolve, which makes a change to one node cost O(N). A node's final layout
+//! depends only on its own unrounded layout and the cumulative (unrounded)
+//! position of its rounding parent. So after an incremental relayout, only two
+//! kinds of node need rounding again:
+//!
+//! - nodes whose unrounded layout changed (recorded by `set_unrounded_layout`),
+//! - every descendant of a node whose location changed, because their
+//!   cumulative position moved with it.
+//!
+//! Inline layout writes the layouts of its boxes directly, so an inline root
+//! that was laid out is recorded as moved and its subtree is rounded again.
+//!
+//! The pass walks from the root down the paths to recorded nodes only, in the
+//! same order as `taffy::round_layout` (in-flow children, then the out-of-flow
+//! boxes hoisted to their containing block), and produces the same result.
+
+use std::collections::HashMap;
+
+use blitz_traits::node_id::NodeId;
+use taffy::{Layout, Rect, RoundTree as _, ScrollableOverflow, TraversePartialTree as _};
+
+use super::LayoutPassState;
+use crate::dom_node_id;
+#[cfg(debug_assertions)]
+use crate::node::NodeData;
+
+/// The node's own layout changed.
+const NODE: u8 = 1;
+/// The node moved: round its whole subtree.
+const SUBTREE: u8 = 2;
+/// A recorded node lies below this one.
+const PATH: u8 = 4;
+
+impl LayoutPassState<'_> {
+    /// Round the layout of the tree at `root` after `compute_root_layout`.
+    pub(crate) fn round_layout(&mut self, root: taffy::NodeId) {
+        let dirty = std::mem::take(&mut self.round_dirty);
+        // A first layout, or a relayout that touched a large share of the
+        // tree (a resize), is cheaper to round in one plain pass.
+        if !self.rounded_once || dirty.len() * 4 > self.nodes.len() {
+            self.rounded_once = true;
+            taffy::round_layout(self, root);
+            return;
+        }
+        if dirty.is_empty() {
+            return;
+        }
+
+        let mut marks: HashMap<NodeId, u8> = HashMap::with_capacity(dirty.len() * 4);
+        for (id, moved) in dirty {
+            *marks.entry(id).or_default() |= if moved { SUBTREE } else { NODE };
+            // Walk up the layout tree. An out-of-flow box is rounded from its
+            // containing block, which is an ancestor on this chain, so the
+            // walk marks the containing block's path too.
+            let mut parent = self.nodes.get(id).and_then(|n| n.layout_parent.get());
+            while let Some(p) = parent {
+                let mark = marks.entry(p).or_default();
+                if *mark & PATH != 0 {
+                    break;
+                }
+                *mark |= PATH;
+                parent = self.nodes.get(p).and_then(|n| n.layout_parent.get());
+            }
+        }
+
+        round_marked(self, root, 0.0, 0.0, &marks);
+
+        #[cfg(debug_assertions)]
+        self.assert_rounding_complete(root);
+    }
+
+    /// Check the incremental result against a plain rounding pass.
+    #[cfg(debug_assertions)]
+    fn assert_rounding_complete(&mut self, root: taffy::NodeId) {
+        let incremental: Vec<(NodeId, Layout)> = self
+            .nodes
+            .iter()
+            .filter(|(_, n)| {
+                matches!(
+                    n.data,
+                    NodeData::Element(_) | NodeData::AnonymousBlock(_) | NodeData::Document(_)
+                )
+            })
+            .map(|(id, n)| (id, *n.final_layout()))
+            .collect();
+        taffy::round_layout(self, root);
+        for (id, layout) in incremental {
+            let full = self.nodes[id].final_layout();
+            assert!(
+                *full == layout,
+                "incremental rounding diverged at {id:?}: {layout:?} vs {full:?}"
+            );
+        }
+    }
+}
+
+fn round_marked(
+    doc: &mut LayoutPassState<'_>,
+    node: taffy::NodeId,
+    parent_x: f32,
+    parent_y: f32,
+    marks: &HashMap<NodeId, u8>,
+) {
+    let mark = marks.get(&dom_node_id(node)).copied().unwrap_or(0);
+    if mark & SUBTREE != 0 {
+        round_subtree(doc, node, parent_x, parent_y);
+        return;
+    }
+    let unrounded = doc.get_unrounded_layout(node);
+    if mark & NODE != 0 {
+        round_one(doc, node, &unrounded, parent_x, parent_y);
+    }
+    if mark & PATH == 0 {
+        return;
+    }
+    let x = parent_x + unrounded.location.x;
+    let y = parent_y + unrounded.location.y;
+    let marked = |child: taffy::NodeId| marks.contains_key(&dom_node_id(child));
+    for index in 0..doc.child_count(node) {
+        let child = doc.get_child_id(node, index);
+        if marked(child) && !doc.is_out_of_flow(child) {
+            round_marked(doc, child, x, y, marks);
+        }
+    }
+    for index in 0..doc.hoisted_child_count(node) {
+        let child = doc.get_hoisted_child_id(node, index);
+        if marked(child) {
+            round_marked(doc, child, x, y, marks);
+        }
+    }
+}
+
+/// What `taffy::round_layout` does, from a node whose rounding parent sits at
+/// the given cumulative position.
+fn round_subtree(doc: &mut LayoutPassState<'_>, node: taffy::NodeId, parent_x: f32, parent_y: f32) {
+    let unrounded = doc.get_unrounded_layout(node);
+    round_one(doc, node, &unrounded, parent_x, parent_y);
+    let x = parent_x + unrounded.location.x;
+    let y = parent_y + unrounded.location.y;
+    for index in 0..doc.child_count(node) {
+        let child = doc.get_child_id(node, index);
+        if !doc.is_out_of_flow(child) {
+            round_subtree(doc, child, x, y);
+        }
+    }
+    for index in 0..doc.hoisted_child_count(node) {
+        let child = doc.get_hoisted_child_id(node, index);
+        round_subtree(doc, child, x, y);
+    }
+}
+
+#[inline(always)]
+fn round(value: f32) -> f32 {
+    (value + 0.5).floor()
+}
+
+/// Taffy's rounding of one node (`taffy::compute::round_layout`, c256056).
+fn round_one(
+    doc: &mut LayoutPassState<'_>,
+    node: taffy::NodeId,
+    u: &Layout,
+    parent_x: f32,
+    parent_y: f32,
+) {
+    let mut layout = *u;
+    let x = parent_x + u.location.x;
+    let y = parent_y + u.location.y;
+    layout.location.x = round(x) - round(parent_x);
+    layout.location.y = round(y) - round(parent_y);
+    layout.size.width = round(x + u.size.width) - round(x);
+    layout.size.height = round(y + u.size.height) - round(y);
+    layout.scrollbar_size.width = round(u.scrollbar_size.width);
+    layout.scrollbar_size.height = round(u.scrollbar_size.height);
+    layout.border.left = round(x + u.border.left) - round(x);
+    layout.border.right = round(x + u.size.width) - round(x + u.size.width - u.border.right);
+    layout.border.top = round(y + u.border.top) - round(y);
+    layout.border.bottom = round(y + u.size.height) - round(y + u.size.height - u.border.bottom);
+    layout.padding.left = round(x + u.padding.left) - round(x);
+    layout.padding.right = round(x + u.size.width) - round(x + u.size.width - u.padding.right);
+    layout.padding.top = round(y + u.padding.top) - round(y);
+    layout.padding.bottom = round(y + u.size.height) - round(y + u.size.height - u.padding.bottom);
+    let o = u.scrollable_overflow_rect;
+    let edge = |offset: f32, edge: f32| {
+        let rounded = round(offset + edge) - round(offset);
+        // A zero edge keeps its sign, which marks a reversed scroll origin.
+        if rounded == 0.0 {
+            rounded.copysign(edge)
+        } else {
+            rounded
+        }
+    };
+    let rect = o.rect();
+    layout.scrollable_overflow_rect = ScrollableOverflow::new(
+        Rect {
+            left: edge(x, rect.left),
+            right: edge(x, rect.right),
+            top: edge(y, rect.top),
+            bottom: edge(y, rect.bottom),
+        },
+        o.is_reversed(),
+    );
+    doc.set_final_layout(node, &layout);
+}
