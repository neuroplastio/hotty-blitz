+++ b/packages/blitz-dom/src/layout/speculate.rs
@@ -0,0 +1,172 @@
+//! Speculative relayout boundaries.
+//!
+//! Damage clears the layout cache of every ancestor of a changed node, so the
+//! ancestors all lay out again. Each one runs its algorithm over all its
+//! children (cached, but a flex container with N items still does N items'
+//! work), and one changed cell in a long list costs O(N).
+//!
+//! A flex or grid item is an independent formatting context: its container
+//! sees it only through what it answers to the inputs the container passes.
+//! So when a changed item, asked again every question its container asked it
+//! last time, gives the same answers, the container's layout cannot have
+//! changed either. The container keeps its old cache, and the same test
+//! applies one level up. The result is identical to a full relayout; the
+//! work stops where answers stop changing.
+//!
+//! A container keeps its old cache when:
+//! - it is a flex or grid container (whose children are independent items),
+//! - its own content and style did not need relayout, only a child's,
+//! - construction left its layout children as they were,
+//! - every child whose cache was cleared gave the same answers.
+
+use std::collections::HashSet;
+
+use blitz_traits::node_id::NodeId;
+use style::values::specified::box_::DisplayInside;
+use stylo_taffy::CopyStyleGetters as _;
+use taffy::{CoreStyle as _, LayoutOutput, LayoutPartialTree as _};
+
+use super::LayoutPassState;
+use super::cache::Answer;
+use super::replaced::is_replaced_element;
+use crate::{BaseDocument, taffy_node_id};
+
+impl BaseDocument {
+    /// Run before `compute_root_layout`, after construction.
+    pub(crate) fn speculate_layout(&mut self) {
+        let mut evicted = std::mem::take(&mut self.evicted_caches);
+        let invalidated = std::mem::take(&mut self.invalidated);
+        let own = std::mem::take(&mut self.own_relayout);
+        let restructured = std::mem::take(&mut self.restructured);
+        if evicted.is_empty() {
+            return;
+        }
+        // A changed out-of-flow box is laid out by its containing block, not
+        // by its parent, which this reasoning does not follow. (Unchanged
+        // ones are safe: an item passes their static positions up in its
+        // output, which is compared.)
+        let out_of_flow = invalidated
+            .iter()
+            .any(|&id| self.nodes.get(id).is_some_and(|n| n.is_out_of_flow()));
+        if out_of_flow {
+            return;
+        }
+
+        let mut order: Vec<(usize, NodeId)> = invalidated
+            .iter()
+            .filter(|&&id| self.nodes.contains_key(id))
+            .map(|&id| (self.box_depth(id), id))
+            .collect();
+        // Children before their containers.
+        order.sort_unstable_by(|a, b| b.cmp(a));
+        order.dedup();
+
+        // Containers with a child that answers differently (or unknowably).
+        let mut unsettled: HashSet<NodeId> = HashSet::new();
+        for (_, id) in order {
+            let settled = match evicted.remove(&id) {
+                Some(old)
+                    if !own.contains(&id)
+                        && !restructured.contains(&id)
+                        && !unsettled.contains(&id)
+                        && old.requests().is_some()
+                        && self.is_flex_or_grid(id) =>
+                {
+                    // Nothing that feeds this container's layout changed.
+                    *self.nodes[id].cache_mut() = old;
+                    true
+                }
+                Some(old) if self.is_item(id) => self.answers_as_before(id, &old),
+                _ => false,
+            };
+            if !settled {
+                let node = &self.nodes[id];
+                unsettled.extend(node.layout_parent.get());
+                unsettled.extend(node.parent);
+            }
+        }
+    }
+
+    /// Ask a node every question it was asked last time; true when every
+    /// answer is the same. The final layout goes last, so the subtree ends up
+    /// laid out as its container expects.
+    fn answers_as_before(&mut self, id: NodeId, old: &super::cache::LayoutCache) -> bool {
+        let Some(requests) = old.requests() else {
+            return false;
+        };
+        let node = taffy_node_id(id);
+        let mut state = LayoutPassState::new(self);
+        for (input, answer) in requests {
+            let output = state.compute_child_layout(node, input);
+            if answer.matches(&output) {
+                continue;
+            }
+            // A container ignores the content overflow of a child that
+            // clips or contains it, apart from copying it into the child's
+            // own layout, which is done here instead.
+            let Answer::Layout(old) = &answer else {
+                return false;
+            };
+            let same_box = LayoutOutput {
+                scrollable_overflow_rect: old.scrollable_overflow_rect,
+                ..output.clone()
+            } == *old;
+            if !same_box || !state.overflow_is_private(id) {
+                return false;
+            }
+            let layout = state.nodes[id].unrounded_layout_mut();
+            layout.scrollable_overflow_rect = output.scrollable_overflow_rect;
+            state.round_dirty.push((id, false));
+        }
+        true
+    }
+
+    /// Whether a node's content overflow stays out of its container's
+    /// (taffy's `compute_scrollable_overflow_contribution`).
+    fn overflow_is_private(&self, id: NodeId) -> bool {
+        let style = self.nodes[id].layout_style();
+        let overflow = style.overflow();
+        overflow.x.is_scroll_container()
+            || overflow.y.is_scroll_container()
+            || style.contain().contains_scrollable_overflow()
+    }
+
+    /// A container that lays its children out as independent items.
+    fn is_flex_or_grid(&self, id: NodeId) -> bool {
+        let node = &self.nodes[id];
+        let Some(element) = node.element_data() else {
+            return false;
+        };
+        !node.flags.is_inline_root()
+            && !node.flags.is_table_root()
+            && !is_replaced_element(&element.name.local)
+            && !matches!(&*element.name.local, "input" | "textarea" | "select")
+            && node.primary_styles().is_some_and(|s| {
+                matches!(
+                    s.clone_display().inside(),
+                    DisplayInside::Flex | DisplayInside::Grid
+                )
+            })
+    }
+
+    /// A flex or grid item: laid out alone by `compute_child_layout`.
+    fn is_item(&self, id: NodeId) -> bool {
+        let node = &self.nodes[id];
+        !node.is_anonymous()
+            && node.element_data().is_some()
+            && node
+                .layout_parent
+                .get()
+                .is_some_and(|p| !self.nodes[p].is_anonymous() && self.is_flex_or_grid(p))
+    }
+
+    fn box_depth(&self, id: NodeId) -> usize {
+        let mut depth = 0;
+        let mut current = Some(id);
+        while let Some(n) = current.and_then(|id| self.nodes.get(id)) {
+            depth += 1;
+            current = n.layout_parent.get().or(n.parent);
+        }
+        depth
+    }
+}
