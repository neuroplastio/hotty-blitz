 use super::ElementCx;
 use crate::color::{Color, ToColorColor as _};
+use crate::kurbo_css::{CssBox, NonUniformRoundedRectRadii};
 use anyrender::PaintScene;
 use blitz_dom::CopyStyleGetters;
-use kurbo::{Rect, RoundedRect, Shape as _, Vec2};
+use kurbo::{Affine, Insets, Rect, RoundedRect, Shape as _, Vec2};
 use peniko::{Compose, Fill, Mix};
 
+/// The corner radii of an outset shadow's spread shape (css-backgrounds-4 "shadow shape"): a
+/// radius grows by the spread, less so when it is small next to both the spread and its box.
+fn spread_radii(
+    border_box: Rect,
+    radii: &NonUniformRoundedRectRadii,
+    spread: f64,
+) -> NonUniformRoundedRectRadii {
+    let adjust = |radius: Vec2| {
+        let coverage =
+            (2.0 * radius.x / border_box.width()).min(2.0 * radius.y / border_box.height());
+        let coverage = if coverage.is_finite() { coverage } else { 0.0 };
+        let grow = |r: f64| {
+            if spread <= 0.0 {
+                (r + spread).max(0.0)
+            } else if r > spread || coverage > 1.0 {
+                r + spread
+            } else {
+                r + spread * (1.0 - (1.0 - r / spread).powi(3) * (1.0 - coverage.powi(3)))
+            }
+        };
+        Vec2::new(grow(radius.x), grow(radius.y))
+    };
+    NonUniformRoundedRectRadii {
+        top_left: adjust(radii.top_left),
+        top_right: adjust(radii.top_right),
+        bottom_right: adjust(radii.bottom_right),
+        bottom_left: adjust(radii.bottom_left),
+    }
+}
+
+/// The radius when all four corners share one circular radius, which is all the analytic
+/// box-shadow blur can draw.
+fn uniform_radius(radii: &NonUniformRoundedRectRadii) -> Option<f64> {
+    let r = radii.top_left.x;
+    [
+        radii.top_left,
+        radii.top_right,
+        radii.bottom_right,
+        radii.bottom_left,
+    ]
+    .iter()
+    .all(|c| c.x == r && c.y == r)
+    .then_some(r)
+}
+
+/// Where the device pixel grid sits in `transform`'s space, if it only translates: clips that
+/// abut on the grid cover each pixel once instead of leaving a faint antialiased seam.
+fn pixel_grid(transform: Affine) -> Option<Vec2> {
+    let [a, b, c, d, e, f] = transform.as_coeffs();
+    (a == 1.0 && b == 0.0 && c == 0.0 && d == 1.0).then_some(Vec2::new(e, f))
+}
+
+/// `rect` grown outward to the device pixel grid at `grid`.
+fn snap_out(rect: Rect, grid: Vec2) -> Rect {
+    Rect::new(
+        (rect.x0 + grid.x).floor() - grid.x,
+        (rect.y0 + grid.y).floor() - grid.y,
+        (rect.x1 + grid.x).ceil() - grid.x,
+        (rect.y1 + grid.y).ceil() - grid.y,
+    )
+}
+
+/// CSS uses a Gaussian deviation of half the blur radius; vello's erf(d / std_dev)
+/// requires that deviation multiplied by sqrt(2) (css-backgrounds-3, "Blurring Shadow Edges").
+fn vello_std_dev(blur_radius: f64) -> f64 {
+    blur_radius * 0.5 * std::f64::consts::SQRT_2
+}
+
