             });
 
             scene.push_layer(
                 Fill::NonZero,
                 Mix::Normal,
-                1.0,
+                super::ALMOST_OPAQUE,
                 self.transform,
                 &padding_box,
                 None,
@@ -191,7 +339,7 @@ impl ElementCx<'_, '_> {
                 hole,
