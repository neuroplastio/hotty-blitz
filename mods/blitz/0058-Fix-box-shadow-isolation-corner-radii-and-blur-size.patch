+    /// One outset shadow: the border box grown by `spread`, each corner keeping its own
+    /// radii rather than sharing the average of all eight radii.
+    fn draw_outset_shadow_shape(
+        &self,
+        scene: &mut impl PaintScene,
+        transform: Affine,
+        color: Color,
+        spread: f64,
+        std_dev: f64,
+    ) {
+        let rect = self.frame.border_box.inflate(spread, spread);
+        let radii = spread_radii(self.frame.border_box, &self.frame.border_radii, spread);
+        if std_dev == 0.0 {
+            let shape = CssBox::new(rect, Insets::ZERO, Insets::ZERO, 0.0, radii).border_box_path();
+            scene.fill(Fill::NonZero, transform, color, None, &shape);
+            return;
+        }
+        if let Some(radius) = uniform_radius(&radii) {
+            scene.draw_box_shadow(transform, rect, color, radius, std_dev);
+            return;
+        }
+
+        // The analytic blur takes one circular radius, so blur each corner's quadrant with that
+        // corner's own; the quadrants meet on straight edges, where every radius blurs alike.
+        let grid = pixel_grid(transform);
+        let straight = |a0: f64, a1: f64, b0: f64, b1: f64, offset: Option<f64>| {
+            let (lo, hi) = (a0.max(b0), a1.min(b1));
+            let mid = if lo <= hi {
+                (lo + hi) / 2.0
+            } else {
+                (a0 + a1 + b0 + b1) / 4.0
+            };
+            offset.map_or(mid, |o| (mid + o).round() - o)
+        };
+        let r = &radii;
+        let split_x = straight(
+            rect.x0 + r.top_left.x,
+            rect.x1 - r.top_right.x,
+            rect.x0 + r.bottom_left.x,
+            rect.x1 - r.bottom_right.x,
+            grid.map(|g| g.x),
+        );
+        let split_y = straight(
+            rect.y0 + r.top_left.y,
+            rect.y1 - r.bottom_left.y,
+            rect.y0 + r.top_right.y,
+            rect.y1 - r.bottom_right.y,
+            grid.map(|g| g.y),
+        );
+        let bounds = rect.inflate(4.0 * std_dev + 1.0, 4.0 * std_dev + 1.0);
+        // The splits already sit on the grid; putting the outer edges there too makes each
+        // quadrant a whole-pixel rect, which vello can clip per draw instead of shading the
+        // whole blur under a clip layer. Those edges lie past anything a blur can reach.
+        let bounds = grid.map_or(bounds, |g| snap_out(bounds, g));
+        let quadrants = [
+            (
+                Rect::new(bounds.x0, bounds.y0, split_x, split_y),
+                r.top_left,
+            ),
+            (
+                Rect::new(split_x, bounds.y0, bounds.x1, split_y),
+                r.top_right,
+            ),
+            (
+                Rect::new(split_x, split_y, bounds.x1, bounds.y1),
+                r.bottom_right,
+            ),
+            (
+                Rect::new(bounds.x0, split_y, split_x, bounds.y1),
+                r.bottom_left,
+            ),
+        ];
+        for (quadrant, radius) in quadrants {
+            let radius = (radius.x + radius.y) / 2.0;
+            // vello shades a blur's whole rect before the clip drops most of it; cut to what can
+            // reach the quadrant, it blurs the same there, its new corners beyond the kernel.
+            let reach = radius + 3.0 * std_dev + 1.0;
+            let local = rect.intersect(quadrant.inflate(reach, reach));
+            self.context.layer_manager.maybe_with_layer(
+                scene,
+                true,
+                Mix::Normal.into(),
+                1.0,
+                transform,
+                &quadrant,
+                None,
+                None,
+                |scene| scene.draw_box_shadow(transform, local, color, radius, std_dev),
+            );
+        }
+    }
+
     pub(super) fn draw_inset_box_shadow(&self, scene: &mut impl PaintScene) {
         let current_color = self.style.clone_color();
         let box_shadow = &self.style.get_effects().box_shadow.0;
@@ -155,14 +303,14 @@ impl ElementCx<'_, '_> {
             }
 
             let transform = self.transform.then_translate(Vec2 {
-                x: shadow.base.horizontal.px() as f64,
-                y: shadow.base.vertical.px() as f64,
