index 000000000..41b9a7f60
--- /dev/null
+++ b/packages/blitz-dom/src/date_time.rs
@@ -0,0 +1,172 @@
+//! Date and time inputs (`date`, `time`, `datetime-local`, `month`, `week`).
+//!
+//! Blitz has no picker for them. It lays each out as a one-line field showing
+//! its value in the form HTML gives it (ISO 8601, which needs no locale), and,
+//! while it is empty, its format as the placeholder. The value is sanitized as
+//! HTML sanitizes it: a string that is not a valid one of the type's is empty.
+//! <https://html.spec.whatwg.org/multipage/input.html#date-state-(type=date)>
+
+/// The input types this module covers, lowercase.
+pub const TYPES: [&str; 5] = ["date", "time", "datetime-local", "month", "week"];
+
+/// The type of a date or time input, lowercase, for a `type` attribute value.
+pub fn date_time_type(ty: Option<&str>) -> Option<&'static str> {
+    let ty = ty?.trim();
+    TYPES.into_iter().find(|t| t.eq_ignore_ascii_case(ty))
+}
+
+/// The format an empty field of type `ty` shows: its value's form, with
+/// letters (or `--` for a time) for the numbers.
+pub fn placeholder(ty: &str) -> &'static str {
+    match ty {
+        "date" => "yyyy-mm-dd",
+        "time" => "--:--",
+        "datetime-local" => "yyyy-mm-ddT--:--",
+        "month" => "yyyy-mm",
+        "week" => "yyyy-Www",
+        _ => "",
+    }
+}
+
+/// `v` as HTML's value sanitization leaves it for an input of type `ty`: the
+/// value, if it is a valid one of the type's, and otherwise empty. A
+/// `datetime-local` may have a space for its `T`.
+pub fn sanitize(ty: &str, v: &str) -> String {
+    match ty {
+        "date" if date(v) => v.to_string(),
+        "month" if month(v).is_some() => v.to_string(),
+        "week" if week(v) => v.to_string(),
+        "time" if time(v) => v.to_string(),
+        "datetime-local" => match v.split_once(['T', ' ']) {
+            Some((d, t)) if date(d) && time(t) => format!("{d}T{t}"),
+            _ => String::new(),
+        },
+        _ => String::new(),
+    }
+}
+
+/// `YYYY-MM`, its year four digits or more and above 0: (year, month).
+pub fn month(s: &str) -> Option<(u32, u32)> {
+    let (y, m) = s.rsplit_once('-')?;
+    let year = (y.len() >= 4 && y.bytes().all(|b| b.is_ascii_digit()))
+        .then(|| y.parse::<u32>().ok())
+        .flatten()
+        .filter(|&y| y > 0)?;
+    let month = (m.len() == 2 && m.bytes().all(|b| b.is_ascii_digit()))
+        .then(|| m.parse::<u32>().ok())
+        .flatten()
+        .filter(|m| (1..=12).contains(m))?;
+    Some((year, month))
+}
+
+fn leap(y: u32) -> bool {
+    y.is_multiple_of(4) && (!y.is_multiple_of(100) || y.is_multiple_of(400))
+}
+
+/// The number of days month `m` (1 to 12) has in year `y`.
+pub fn days_in_month(y: u32, m: u32) -> u32 {
+    match m {
+        2 if leap(y) => 29,
+        2 => 28,
+        4 | 6 | 9 | 11 => 30,
+        _ => 31,
+    }
+}
+
+/// The number of ISO weeks year `y` has: 53 in a year that starts on a
+/// Thursday, or a leap year that starts on a Wednesday, and otherwise 52.
+pub fn weeks_in_year(y: u32) -> u32 {
+    // The day of the week of 1 January, 0 for Sunday.
+    let p = y.saturating_sub(1);
+    let jan1 = (1 + 5 * (p % 4) + 4 * (p % 100) + 6 * (p % 400)) % 7;
+    if jan1 == 4 || (leap(y) && jan1 == 3) {
+        53
+    } else {
+        52
+    }
+}
+
+/// `YYYY-MM-DD`, a day the month has.
+pub fn date(s: &str) -> bool {
+    let Some((ym, d)) = s.rsplit_once('-') else {
+        return false;
+    };
+    let Some((y, m)) = month(ym) else {
+        return false;
+    };
+    d.len() == 2
+        && d.bytes().all(|b| b.is_ascii_digit())
+        && d.parse::<u32>()
+            .is_ok_and(|d| (1..=days_in_month(y, m)).contains(&d))
+}
+
+/// `YYYY-Www`, a week the year has.
+pub fn week(s: &str) -> bool {
+    let Some((y, w)) = s.split_once("-W") else {
+        return false;
+    };
+    let Some(year) = (y.len() >= 4 && y.bytes().all(|b| b.is_ascii_digit()))
+        .then(|| y.parse::<u32>().ok())
+        .flatten()
+        .filter(|&y| y > 0)
+    else {
+        return false;
+    };
+    w.len() == 2
+        && w.bytes().all(|b| b.is_ascii_digit())
+        && w.parse::<u32>()
+            .is_ok_and(|w| (1..=weeks_in_year(year)).contains(&w))
+}
+
+/// `HH:MM`, with `:SS` and a fraction of up to three digits.
+pub fn time(s: &str) -> bool {
+    let two = |p: &str, max: u32| {
+        p.len() == 2
+            && p.bytes().all(|b| b.is_ascii_digit())
+            && p.parse::<u32>().is_ok_and(|n| n <= max)
+    };
+    let mut parts = s.split(':');
+    let (Some(h), Some(m)) = (parts.next(), parts.next()) else {
+        return false;
+    };
+    let sec = parts.next();
+    if parts.next().is_some() || !two(h, 23) || !two(m, 59) {
+        return false;
+    }
+    sec.is_none_or(|sec| match sec.split_once('.') {
+        Some((s, f)) => {
+            two(s, 59) && (1..=3).contains(&f.len()) && f.bytes().all(|b| b.is_ascii_digit())
+        }
+        None => two(sec, 59),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sanitizes() {
+        assert_eq!(sanitize("date", "2026-11-17"), "2026-11-17");
+        assert_eq!(sanitize("date", "2026-02-29"), "");
+        assert_eq!(sanitize("date", "2024-02-29"), "2024-02-29");
+        assert_eq!(sanitize("time", "09:30"), "09:30");
+        assert_eq!(sanitize("time", "9:30"), "");
+        assert_eq!(sanitize("time", "23:59:59.999"), "23:59:59.999");
+        assert_eq!(
+            sanitize("datetime-local", "2026-11-17 09:30"),
+            "2026-11-17T09:30"
+        );
+        assert_eq!(sanitize("month", "2026-11"), "2026-11");
+        assert_eq!(sanitize("month", "2026-13"), "");
+        assert_eq!(sanitize("week", "2026-W53"), "2026-W53");
+        assert_eq!(sanitize("week", "2025-W53"), "");
+    }
+
+    #[test]
+    fn types() {
+        assert_eq!(date_time_type(Some("Date")), Some("date"));
+        assert_eq!(date_time_type(Some("text")), None);
+        assert_eq!(date_time_type(None), None);
+    }
+}
