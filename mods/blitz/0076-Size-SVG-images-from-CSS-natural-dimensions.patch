 packages/blitz-dom/src/node/element.rs |  10 +
 packages/blitz-dom/src/node/svg.rs     | 247 ++++++++++++++++++++++---
 packages/blitz-dom/src/util.rs         |  26 +++
 4 files changed, 270 insertions(+), 23 deletions(-)

