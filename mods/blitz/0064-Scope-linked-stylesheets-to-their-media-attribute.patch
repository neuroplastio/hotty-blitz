From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 5 Aug 2026 14:31:03 +0100
Subject: [PATCH] Scope linked stylesheets to their media attribute

External sheets were parsed with MediaList::empty(), so a media="print"
sheet cascaded on screen: sigarra.up.pt's print CSS (#cabecalho /
#colunaprincipal / #colunaextra display:none) erased the whole page
chrome from screen renders. Parse the owning link's media attribute into
the sheet's MediaList (via a helper shared with the <style media> path)
so stylo re-evaluates it against the device on every cascade.

The media attribute was only snapshotted at fetch time
(StylesheetHandler.media_attr), so a post-load mutation never
re-evaluated the installed sheet. The async-CSS pattern of beasties,
critters and loadCSS (<link media="print" onload="this.media='all'">)
therefore left the full sheet print-scoped forever and pages rendered
with critical CSS only (Angular TodoMVC's whole app CSS was inert).

set_attribute/clear_attribute on (link, media) now rewrite the installed
sheet's MediaList in place through the shared lock and force the
affected origin set dirty (or rebuild the shadow scope), which is enough
for stylo to re-evaluate scoping on the next resolve. When no sheet is
installed yet (fetch in flight), the load is re-fired so the handler
snapshots the new media value; the embedder coalesces the duplicate
fetch.
---
 packages/blitz-dom/src/document.rs | 51 +++++++++++++++++++++++++-----
 packages/blitz-dom/src/mutator.rs  |  8 +++++
 2 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index 469bb1d1f..2f4312ca1 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -1426,17 +1426,38 @@ impl BaseDocument {
         self.make_stylesheet_with_media(css, origin, None)
     }
 
-    fn make_stylesheet_with_media(&self, css: impl AsRef<str>, origin: Origin, media: Option<&str>) -> DocumentStyleSheet {
+    fn parse_stylesheet_media(&self, origin: Origin, media: Option<&str>) -> MediaList {
         let url_data = self.url.url_extra_data();
-        let list = media.map(str::trim).filter(|m| !m.is_empty()).map(|media| {
-            let mut context = style::parser::ParserContext::new(origin, &url_data,
-                Some(style::stylesheets::CssRuleType::Media), style_traits::ParsingMode::DEFAULT,
-                QuirksMode::NoQuirks, Default::default(), None, None, Default::default());
-            MediaList::parse(&mut context, &mut cssparser::Parser::new(media))
-        }).unwrap_or_else(MediaList::empty);
+        media
+            .map(str::trim)
+            .filter(|m| !m.is_empty())
+            .map(|media| {
+                let mut context = style::parser::ParserContext::new(
+                    origin,
+                    &url_data,
+                    Some(style::stylesheets::CssRuleType::Media),
+                    style_traits::ParsingMode::DEFAULT,
+                    QuirksMode::NoQuirks,
+                    Default::default(),
+                    None,
+                    None,
+                    Default::default(),
+                );
+                MediaList::parse(&mut context, &mut cssparser::Parser::new(media))
+            })
+            .unwrap_or_else(MediaList::empty)
+    }
+
+    fn make_stylesheet_with_media(
+        &self,
+        css: impl AsRef<str>,
+        origin: Origin,
+        media: Option<&str>,
+    ) -> DocumentStyleSheet {
+        let list = self.parse_stylesheet_media(origin, media);
         let data = Stylesheet::from_str(
             css.as_ref(),
-            url_data,
+            self.url.url_extra_data(),
             origin,
             ServoArc::new(self.guard.wrap(list)),
             self.guard.clone(),
@@ -1506,6 +1527,17 @@ impl BaseDocument {
         }
     }
 
+    pub(crate) fn update_stylesheet_media(&mut self, node_id: NodeId) {
+        let Some(sheet) = self.nodes_to_stylesheet.get(&node_id) else {
+            return;
+        };
+        let media = self.nodes[node_id].attr(local_name!("media"));
+        let list = self.parse_stylesheet_media(Origin::Author, media);
+        *sheet.0.media.write_with(&mut self.guard.write()) = list;
+        self.stylist
+            .force_stylesheet_origins_dirty(style::stylesheets::OriginSet::all());
+    }
+
     pub fn handle_messages(&mut self) {
         // Remove event Reciever from the Document so that we can process events
         // without holding a borrow to the Document
@@ -1562,6 +1594,9 @@ impl BaseDocument {
             Resource::Css(css) => {
                 let node_id = res.node_id.unwrap();
                 self.add_stylesheet_for_node(css, node_id);
+                // Read the current attribute after the fetch, including changes
+                // made while the request was in flight.
+                self.update_stylesheet_media(node_id);
             }
             Resource::ImportedCss(import_rule, sheet) => {
                 let mut guard = self.guard.write();
diff --git a/packages/blitz-dom/src/mutator.rs b/packages/blitz-dom/src/mutator.rs
index ecf2eae83..794b6904b 100644
--- a/packages/blitz-dom/src/mutator.rs
+++ b/packages/blitz-dom/src/mutator.rs
@@ -502,6 +502,10 @@ impl DocumentMutator<'_> {
             || (tag, attr) == tag_and_attr!("link", "rel")
         {
             self.load_linked_stylesheet(node_id);
+        } else if (tag, attr) == tag_and_attr!("link", "media")
+            || (tag, attr) == tag_and_attr!("style", "media")
+        {
+            self.doc.update_stylesheet_media(node_id);
         } else if (tag, attr) == tag_and_attr!("iframe", "src")
             || (tag, attr) == tag_and_attr!("iframe", "srcdoc")
         {
@@ -622,6 +626,10 @@ impl DocumentMutator<'_> {
             self.recompute_is_animating = true;
         } else if (tag, attr) == tag_and_attr!("link", "href") {
             self.unload_stylesheet(node_id);
+        } else if (tag, attr) == tag_and_attr!("link", "media")
+            || (tag, attr) == tag_and_attr!("style", "media")
+        {
+            self.doc.update_stylesheet_media(node_id);
         } else if (tag, attr) == tag_and_attr!("iframe", "srcdoc") && node_is_in_document {
             // Fall back to loading from the `src` attribute (if any)
             self.load_iframe(node_id);
