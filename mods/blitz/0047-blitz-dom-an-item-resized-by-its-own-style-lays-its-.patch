From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Sat, 31 Oct 2026 00:08:11 +0100
Subject: [PATCH] blitz-dom: an item resized by its own style lays its
 container out again

Speculative relayout keeps a flex or grid container's old layout when
every changed item, asked again the questions the container asked it
last time, gives the same answers. But the container reads an item's
style itself (width, flex-basis, margins) and asks with what it made
of it, so an item whose width changed answers the old questions as
before: the container kept its layout, and the item its old size.

Stylo asks compute_layout_damage only for a style change that needs
relayout. It now adds STYLE_RELAYOUT, a damage bit of Blitz's own;
propagate_damage_flags records the nodes that carry it and drops it,
and speculate_layout settles no container from such an item. A change
of an item's content (a text node's, which damages its parent without
Stylo) and a change that only repaints still speculate.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/blitz-dom/src/document.rs         |  4 ++++
 packages/blitz-dom/src/layout/damage.rs    | 21 ++++++++++++++++++---
 packages/blitz-dom/src/layout/speculate.rs | 14 ++++++++++++--
 packages/blitz-dom/src/stylo.rs            |  5 +++--
 4 files changed, 37 insertions(+), 7 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index af6e629a..ab27f4e7 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -227,6 +227,9 @@ pub struct BaseDocument {
     pub(crate) invalidated: Vec<NodeId>,
     /// Nodes whose own content or style needs relayout (not only a child's).
     pub(crate) own_relayout: HashSet<NodeId>,
+    /// Nodes whose own style needs relayout (`STYLE_RELAYOUT`), which their
+    /// flex or grid container reads directly.
+    pub(crate) style_relayout: HashSet<NodeId>,
     /// Nodes whose layout children changed in this resolve's construction.
     pub(crate) restructured: HashSet<NodeId>,
     /// The source each inline `svg` was last built from, as a hash: its
@@ -503,6 +506,7 @@ impl BaseDocument {
             evicted_caches: HashMap::new(),
             invalidated: Vec::new(),
             own_relayout: HashSet::new(),
+            style_relayout: HashSet::new(),
             restructured: HashSet::new(),
             inline_svg_sources: HashMap::new(),
             geometry_changed: HashSet::new(),
diff --git a/packages/blitz-dom/src/layout/damage.rs b/packages/blitz-dom/src/layout/damage.rs
index 9a5db60e..5877c25e 100644
--- a/packages/blitz-dom/src/layout/damage.rs
+++ b/packages/blitz-dom/src/layout/damage.rs
@@ -32,6 +32,16 @@ pub(crate) const ONLY_RELAYOUT: RestyleDamage =
 pub(crate) const REORDER_CHILDREN: RestyleDamage =
     RestyleDamage::from_bits_retain(0b_0000_0000_0001_0000);
 
+/// The node's own style changed in a way that needs relayout: Stylo asked
+/// `compute_layout_damage`, which content changes (a text node's, which
+/// damages its parent) never reach. A flex or grid container reads its
+/// items' styles itself, so `speculate_layout` cannot settle it from the
+/// answers of an item with this bit. Kept on the node only until
+/// `propagate_damage_flags` records it, and not forwarded to the parent.
+/// Deliberately not part of `ALL_DAMAGE`.
+pub(crate) const STYLE_RELAYOUT: RestyleDamage =
+    RestyleDamage::from_bits_retain(0b_0000_0001_0000_0000);
+
 pub(crate) const CONSTRUCT_BOX: RestyleDamage =
     RestyleDamage::from_bits_retain(0b_0000_0000_0010_0000);
 pub(crate) const CONSTRUCT_FC: RestyleDamage =
@@ -64,6 +74,8 @@ impl BaseDocument {
 
         // What this node itself needs, before its children's damage joins.
         let own = damage;
+        let own_style = own.contains(STYLE_RELAYOUT);
+        damage.remove(STYLE_RELAYOUT);
 
         // Skip subtrees which contain no damage. Anonymous nodes are never
         // skipped themselves because damage marking walks the DOM parent
@@ -150,7 +162,7 @@ impl BaseDocument {
 
         if relayout {
             let own = reorder || own.intersects(ONLY_RELAYOUT | CONSTRUCT_BOX | CONSTRUCT_FC);
-            self.evict_layout_cache(node_id, own);
+            self.evict_layout_cache(node_id, own, own_style);
         }
 
         // Anonymous boxes between this node and its nearest element ancestor
@@ -282,8 +294,8 @@ impl BaseDocument {
 
     /// Clear a node's layout cache for relayout, keeping the old one for
     /// `speculate_layout`. `own` says the node itself changed, not only a
-    /// descendant.
-    fn evict_layout_cache(&mut self, node_id: NodeId, own: bool) {
+    /// descendant; `own_style`, that its own style did (`STYLE_RELAYOUT`).
+    fn evict_layout_cache(&mut self, node_id: NodeId, own: bool, own_style: bool) {
         let speculating = self.speculating();
         let node = &mut self.nodes[node_id];
         let old = node
@@ -296,6 +308,9 @@ impl BaseDocument {
             if own {
                 self.own_relayout.insert(node_id);
             }
+            if own_style {
+                self.style_relayout.insert(node_id);
+            }
             if let Some(old) = old {
                 self.evicted_caches.insert(node_id, old);
             }
diff --git a/packages/blitz-dom/src/layout/speculate.rs b/packages/blitz-dom/src/layout/speculate.rs
index 50e77f2e..52d874be 100644
--- a/packages/blitz-dom/src/layout/speculate.rs
+++ b/packages/blitz-dom/src/layout/speculate.rs
@@ -17,7 +17,11 @@
 //! - it is a flex or grid container (whose children are independent items),
 //! - its own content and style did not need relayout, only a child's,
 //! - construction left its layout children as they were,
-//! - every child whose cache was cleared gave the same answers.
+//! - every child whose cache was cleared gave the same answers,
+//! - and no such child's own style changed its layout. A container reads its
+//!   items' styles itself (`width`, `flex-basis`, margins, `align-self`)
+//!   and asks an item its questions with what it made of them: asked the
+//!   old questions again, an item whose `width` changed answers as before.
 
 use std::collections::{HashMap, HashSet};
 
@@ -35,6 +39,7 @@ impl BaseDocument {
         let mut evicted = std::mem::take(&mut self.evicted_caches);
         let invalidated = std::mem::take(&mut self.invalidated);
         let own = std::mem::take(&mut self.own_relayout);
+        let styled = std::mem::take(&mut self.style_relayout);
         let restructured = std::mem::take(&mut self.restructured);
         if evicted.is_empty() {
             return;
@@ -80,7 +85,12 @@ impl BaseDocument {
                     *self.nodes[id].cache_mut() = old;
                     true
                 }
-                Some(old) if self.is_item(id) => self.answers_as_before(id, &old),
+                // An item whose own style changed its layout is sized by
+                // its container from that style: the container lays out
+                // again.
+                Some(old) if self.is_item(id) && !styled.contains(&id) => {
+                    self.answers_as_before(id, &old)
+                }
                 _ => false,
             };
             if !settled {
diff --git a/packages/blitz-dom/src/stylo.rs b/packages/blitz-dom/src/stylo.rs
index 1a9b5a4f..185a328c 100644
--- a/packages/blitz-dom/src/stylo.rs
+++ b/packages/blitz-dom/src/stylo.rs
@@ -7,7 +7,7 @@ use std::sync::Mutex;
 use std::sync::atomic::Ordering;
 
 use crate::StyleThreading;
-use crate::layout::damage::compute_layout_damage;
+use crate::layout::damage::{STYLE_RELAYOUT, compute_layout_damage};
 use crate::node::Node;
 use crate::node::NodeData;
 use markup5ever::{LocalName, LocalNameStaticSet, Namespace, NamespaceStaticSet, local_name, ns};
@@ -1257,7 +1257,8 @@ impl<'a> TElement for BlitzNode<'a> {
     }
 
     fn compute_layout_damage(old: &ComputedValues, new: &ComputedValues) -> RestyleDamage {
-        compute_layout_damage(old, new)
+        // The node's own style changed its layout (see `STYLE_RELAYOUT`).
+        compute_layout_damage(old, new) | STYLE_RELAYOUT
         // ALL_DAMAGE
     }
 
