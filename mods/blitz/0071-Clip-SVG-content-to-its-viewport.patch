From 052f8507043beb762a4c4238452be78e3b45043d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Sat, 14 Nov 2026 16:52:43 +0100
Subject: [PATCH] Clip SVG content to its viewport

Give embedded SVG viewports their user-agent overflow default, retain author overrides and clip replaced SVG content. Keep CSS units for inline SVG without a viewBox.

Co-authored-by: hotty Agent <hotty@neuroplast.io>
---
 packages/blitz-dom/assets/default.css |  4 ++
 packages/blitz-paint/src/render.rs    | 71 ++++++++++++++++-----------
 2 files changed, 47 insertions(+), 28 deletions(-)

diff --git a/packages/blitz-dom/assets/default.css b/packages/blitz-dom/assets/default.css
index ee47bef98..23a289b83 100644
--- a/packages/blitz-dom/assets/default.css
+++ b/packages/blitz-dom/assets/default.css
@@ -5,6 +5,10 @@
 @namespace url(http://www.w3.org/1999/xhtml);
 /* set default namespace to HTML */
 @namespace xul url(http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul);
+@namespace svg url(http://www.w3.org/2000/svg);
+
+/* SVG viewports embedded in an HTML document clip by default. */
+svg|svg:not(:root) { overflow: hidden; }
 
 @font-face {
     font-family: -moz-bullet-font;
diff --git a/packages/blitz-paint/src/render.rs b/packages/blitz-paint/src/render.rs
index e58f37c9d..94d0bc4e2 100644
--- a/packages/blitz-paint/src/render.rs
+++ b/packages/blitz-paint/src/render.rs
@@ -1486,36 +1486,51 @@ impl ElementCx<'_, '_> {
         };
         let object_position = self.style.get_object_position();
 
-        // Apply object-fit algorithm
-        let container_size = taffy::Size { width, height };
-        let object_size = taffy::Size {
-            width: svg_size.width(),
-            height: svg_size.height(),
+        let is_inline_svg_element = self.element.name.local == local_name!("svg");
+        // With no viewBox, SVG user units are CSS pixels rather than a
+        // synthesized natural size to be fitted into the viewport.
+        let transform = if is_inline_svg_element && svg.viewbox_aspect_ratio().is_none() {
+            self.transform
+                .pre_scale(self.scale)
+                .then_translate(Vec2 { x, y })
+        } else {
+            let container_size = taffy::Size { width, height };
+            let object_size = taffy::Size {
+                width: svg_size.width(),
+                height: svg_size.height(),
+            };
+            let paint_size = compute_object_fit(container_size, Some(object_size), object_fit);
+            let x_offset = object_position.horizontal.resolve(
+                CSSPixelLength::new(container_size.width - paint_size.width) / self.scale as f32,
+            ) * self.scale as f32;
+            let y_offset = object_position.vertical.resolve(
+                CSSPixelLength::new(container_size.height - paint_size.height) / self.scale as f32,
+            ) * self.scale as f32;
+            let viewport = svg_viewport_affine(svg, paint_size.width, paint_size.height);
+            (self.transform * viewport).then_translate(Vec2 {
+                x: x + x_offset.px() as f64,
+                y: y + y_offset.px() as f64,
+            })
+        };
+
+        // Inline SVG uses CSS overflow. Replaced SVG content always clips.
+        let clips = if is_inline_svg_element {
+            let box_styles = self.style.get_box();
+            !matches!(box_styles.overflow_x, Overflow::Visible)
+                || !matches!(box_styles.overflow_y, Overflow::Visible)
+        } else {
+            true
         };
-        let paint_size = compute_object_fit(container_size, Some(object_size), object_fit);
-
-        // Compute object-position
-        let x_offset = object_position.horizontal.resolve(
-            CSSPixelLength::new(container_size.width - paint_size.width) / self.scale as f32,
-        ) * self.scale as f32;
-        let y_offset = object_position.vertical.resolve(
-            CSSPixelLength::new(container_size.height - paint_size.height) / self.scale as f32,
-        ) * self.scale as f32;
-        let x = x + x_offset.px() as f64;
-        let y = y + y_offset.px() as f64;
-
-        let viewport = svg_viewport_affine(svg, paint_size.width, paint_size.height);
-        let transform = (self.transform * viewport).then_translate(Vec2 { x, y });
-
-        self.with_replaced_content_clip(
+        self.context.layer_manager.maybe_with_layer(
             scene,
-            container_size,
-            paint_size,
-            x_offset.px(),
-            y_offset.px(),
-            |scene| {
-                anyrender_svg::render_svg_tree(scene, &svg.tree, transform);
-            },
+            clips,
+            BlendMode::default(),
+            1.0,
+            self.transform,
+            &self.frame.content_box_path(),
+            None,
+            None,
+            |scene| anyrender_svg::render_svg_tree(scene, &svg.tree, transform),
         );
     }
 
