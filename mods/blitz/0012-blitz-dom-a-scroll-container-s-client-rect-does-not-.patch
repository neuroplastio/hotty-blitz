From 253a3c8a7b0072784aa83a1373f3920000f1276f Mon Sep 17 00:00:00 2001
From: HOTTY Agent <hotty@neuroplast.io>
Date: Tue, 6 Oct 2026 19:09:00 +0200
Subject: [PATCH 12/45] blitz-dom: a scroll container's client rect does not
 move with its own scroll

getBoundingClientRect() is the border box, which a scroll container's own
scroll offset does not move: only its content moves. Node's absolute
position walk subtracts every scroll offset on the way up, the node's own
included, so a scrolled container reported its box shifted by its scroll.
scroll_into_view already compensated; get_client_bounding_rect now does
too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/blitz-dom/src/document.rs | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index 6cf2883c0..ab7c8d387 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -2490,8 +2490,13 @@ impl BaseDocument {
             return rects.reduce(BoundingRect::union);
         }
 
-        self.get_node(node_id)?;
-        let (pos, layout) = self.physical_unrounded_geometry(node_id);
+        let node = self.get_node(node_id)?;
+        let (mut pos, layout) = self.physical_unrounded_geometry(node_id);
+        // A scroll container's own scroll offset moves its content, not its box:
+        // `physical_unrounded_geometry` subtracts it, so add it back.
+        let scroll = node.scroll_offset();
+        pos.x += scroll.x as f32;
+        pos.y += scroll.y as f32;
         let size = layout.size;
 
         Some(BoundingRect {
