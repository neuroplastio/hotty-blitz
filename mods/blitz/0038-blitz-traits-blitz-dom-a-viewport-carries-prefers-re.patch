From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Sat, 7 Nov 2026 18:39:37 +0100
Subject: [PATCH 38/61] blitz-traits, blitz-dom: a viewport carries
 prefers-reduced-motion

Viewport::reduced_motion goes to Stylo's Device as the colour scheme does, a
change is a device change flushed in resolve, and a sub-document follows its
parent. Viewport::new keeps its signature; the field defaults to false.
---
 packages/blitz-dom/src/resolve.rs      | 1 +
 packages/blitz-dom/src/stylo/device.rs | 6 ++++++
 packages/blitz-traits/src/shell.rs     | 4 ++++
 3 files changed, 11 insertions(+)

diff --git a/packages/blitz-dom/src/resolve.rs b/packages/blitz-dom/src/resolve.rs
index 9c077c14c..6de28de24 100644
--- a/packages/blitz-dom/src/resolve.rs
+++ b/packages/blitz-dom/src/resolve.rs
@@ -147,6 +147,7 @@ impl BaseDocument {
                 sub_viewport.hidpi_scale = self.viewport.hidpi_scale;
                 sub_viewport.zoom = self.viewport.zoom;
                 sub_viewport.color_scheme = self.viewport.color_scheme;
+                sub_viewport.reduced_motion = self.viewport.reduced_motion;
 
                 let viewport_scale = self.viewport.scale();
                 sub_viewport.window_size = (
diff --git a/packages/blitz-dom/src/stylo/device.rs b/packages/blitz-dom/src/stylo/device.rs
index 841a6c4e1..8bd150a2d 100644
--- a/packages/blitz-dom/src/stylo/device.rs
+++ b/packages/blitz-dom/src/stylo/device.rs
@@ -40,6 +40,8 @@ bitflags! {
         const COLOR_SCHEME = 0b0000_0100;
         /// The media type (e.g. screen/print) changed.
         const MEDIA_TYPE = 0b0000_1000;
+        /// The `prefers-reduced-motion` setting changed.
+        const REDUCED_MOTION = 0b0001_0000;
     }
 }
 
@@ -57,6 +59,9 @@ impl DeviceChanges {
         if old.color_scheme != new.color_scheme {
             changes |= Self::COLOR_SCHEME;
         }
+        if old.reduced_motion != new.reduced_motion {
+            changes |= Self::REDUCED_MOTION;
+        }
         changes
     }
 }
@@ -90,6 +95,7 @@ pub(crate) fn make_media_data(viewport: &Viewport, media_type: MediaType) -> Med
             ColorScheme::Light => PrefersColorScheme::Light,
             ColorScheme::Dark => PrefersColorScheme::Dark,
         },
+        prefers_reduced_motion: viewport.reduced_motion,
         primary_pointer_capabilities: PointerCapabilities::default(),
         all_pointer_capabilities: PointerCapabilities::default(),
     }
diff --git a/packages/blitz-traits/src/shell.rs b/packages/blitz-traits/src/shell.rs
index f92d7326e..00526f32a 100644
--- a/packages/blitz-traits/src/shell.rs
+++ b/packages/blitz-traits/src/shell.rs
@@ -83,6 +83,8 @@ pub enum ColorScheme {
 #[derive(Debug, Clone, PartialEq)]
 pub struct Viewport {
     pub color_scheme: ColorScheme,
+    /// The user asked for less motion (`prefers-reduced-motion: reduce`).
+    pub reduced_motion: bool,
     pub window_size: (u32, u32),
     pub hidpi_scale: f32,
     pub zoom: f32,
@@ -95,6 +97,7 @@ impl Default for Viewport {
             hidpi_scale: 1.0,
             zoom: 1.0,
             color_scheme: ColorScheme::Light,
+            reduced_motion: false,
         }
     }
 }
@@ -111,6 +114,7 @@ impl Viewport {
             hidpi_scale: scale_factor,
             zoom: 1.0,
             color_scheme,
+            reduced_motion: false,
         }
     }
 
