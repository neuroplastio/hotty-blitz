diff --git a/packages/blitz-dom/src/select.rs b/packages/blitz-dom/src/select.rs
new file mode 100644
index 00000000..bc6da174
--- /dev/null
+++ b/packages/blitz-dom/src/select.rs
@@ -0,0 +1,189 @@
+//! A `<select>`'s options and their selectedness.
+//!
+//! An option's selectedness is its `ElementState::CHECKED` bit, as in Gecko,
+//! so `option:checked` matches the picked option and is invalidated with it.
+//! There is no script, so an option has no dirtiness: its `selected`
+//! attribute, set or removed, is its selectedness from then on.
+//!
+//! <https://html.spec.whatwg.org/multipage/form-elements.html#the-select-element>
+
+use blitz_traits::node_id::NodeId;
+use markup5ever::local_name;
+use style_dom::ElementState;
+
+use crate::BaseDocument;
+
+impl BaseDocument {
+    /// The select's list of options: its `option` children, and those of its
+    /// `optgroup` children, in tree order.
+    pub fn select_options(&self, select_id: NodeId) -> Vec<NodeId> {
+        let mut options = Vec::new();
+        let Some(select) = self.get_node(select_id) else {
+            return options;
+        };
+        for &child_id in select.children.iter() {
+            let child = &self.nodes[child_id];
+            if child.data.is_element_with_tag_name(&local_name!("option")) {
+                options.push(child_id);
+            } else if child
+                .data
+                .is_element_with_tag_name(&local_name!("optgroup"))
+            {
+                options.extend(child.children.iter().copied().filter(|&id| {
+                    self.nodes[id]
+                        .data
+                        .is_element_with_tag_name(&local_name!("option"))
+                }));
+            }
+        }
+        options
+    }
+
+    /// The select an option belongs to: its parent, or its `optgroup`'s.
+    pub fn option_select(&self, option_id: NodeId) -> Option<NodeId> {
+        let select = local_name!("select");
+        let optgroup = local_name!("optgroup");
+        let is = |id: NodeId, name: &markup5ever::LocalName| {
+            self.nodes[id].data.is_element_with_tag_name(name)
+        };
+        let parent = self.get_node(option_id)?.parent?;
+        if is(parent, &select) {
+            return Some(parent);
+        }
+        let grandparent = self.nodes[parent].parent?;
+        (is(parent, &optgroup) && is(grandparent, &select)).then_some(grandparent)
+    }
+
+    /// Whether an option is disabled: by its `disabled` attribute, or its
+    /// `optgroup`'s.
+    pub fn option_disabled(&self, option_id: NodeId) -> bool {
+        let Some(option) = self.get_node(option_id) else {
+            return true;
+        };
+        option.attr(local_name!("disabled")).is_some()
+            || option.parent.is_some_and(|p| {
+                let parent = &self.nodes[p];
+                parent
+                    .data
+                    .is_element_with_tag_name(&local_name!("optgroup"))
+                    && parent.attr(local_name!("disabled")).is_some()
+            })
+    }
+
+    /// Whether an option is selected.
+    pub fn option_selected(&self, option_id: NodeId) -> bool {
+        self.get_node(option_id)
+            .and_then(|n| n.element_data())
+            .is_some_and(|e| e.element_state.contains(ElementState::CHECKED))
+    }
+
+    /// An option's value: its `value` attribute, or else its text with
+    /// ASCII white space stripped and collapsed.
+    pub fn option_value(&self, option_id: NodeId) -> String {
+        let Some(option) = self.get_node(option_id) else {
+            return String::new();
+        };
+        if let Some(value) = option.attr(local_name!("value")) {
+            return value.to_string();
+        }
+        option
+            .text_content()
+            .split_ascii_whitespace()
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+
+    /// The select's value: its first selected option's.
+    pub fn select_value(&self, select_id: NodeId) -> Option<String> {
+        self.select_options(select_id)
+            .into_iter()
+            .find(|&o| self.option_selected(o))
+            .map(|o| self.option_value(o))
+    }
+
+    /// Picks an option of a select, as the user does: the option is selected
+    /// and, unless the select is `multiple`, no other is. Returns whether the
+    /// selectedness of any option changed.
+    pub fn pick_option(&mut self, select_id: NodeId, option_id: NodeId) -> bool {
+        let options = self.select_options(select_id);
+        if !options.contains(&option_id) {
+            return false;
+        }
+        let multiple = self.nodes[select_id]
+            .attr(local_name!("multiple"))
+            .is_some();
+        let picked: Vec<bool> = options
+            .iter()
+            .map(|&o| o == option_id || (multiple && self.option_selected(o)))
+            .collect();
+        self.set_selectedness(&options, &picked)
+    }
+
+    /// Runs the selectedness setting algorithm on a select after its options
+    /// changed. `inserted` are the options inserted with a `selected`
+    /// attribute, which are selected. `defaults` are the options whose
+    /// `selected` attribute was set (`true`) or removed (`false`), in the
+    /// order it happened: each takes it as its selectedness, and unless the
+    /// select is `multiple`, an option that becomes selected leaves no other
+    /// selected. Then, unless the select is `multiple`, one option is
+    /// selected: the last selected one, or else the first that is not
+    /// disabled.
+    pub(crate) fn update_selectedness(
+        &mut self,
+        select_id: NodeId,
+        inserted: &[NodeId],
+        defaults: &[(NodeId, bool)],
+    ) {
+        if self.get_node(select_id).is_none() {
+            return;
+        }
+        let options = self.select_options(select_id);
+        let multiple = self.nodes[select_id]
+            .attr(local_name!("multiple"))
+            .is_some();
+        let mut picked: Vec<bool> = options
+            .iter()
+            .map(|&o| self.option_selected(o) || inserted.contains(&o))
+            .collect();
+        for &(option_id, selected) in defaults {
+            let Some(i) = options.iter().position(|&o| o == option_id) else {
+                continue;
+            };
+            if selected && !multiple {
+                picked.fill(false);
+            }
+            picked[i] = selected;
+        }
+        if !multiple {
+            match picked.iter().rposition(|&p| p) {
+                Some(last) => {
+                    picked.fill(false);
+                    picked[last] = true;
+                }
+                None => {
+                    if let Some(first) = options.iter().position(|&o| !self.option_disabled(o)) {
+                        picked[first] = true;
+                    }
+                }
+            }
+        }
+        self.set_selectedness(&options, &picked);
+    }
+
+    fn set_selectedness(&mut self, options: &[NodeId], picked: &[bool]) -> bool {
+        let mut changed = false;
+        for (&option_id, &selected) in options.iter().zip(picked) {
+            if self.option_selected(option_id) == selected {
+                continue;
+            }
+            changed = true;
+            self.snapshot_node_and(option_id, ElementState::CHECKED, |node| {
+                if let Some(element) = node.element_data_mut() {
+                    element.element_state.set(ElementState::CHECKED, selected);
+                }
+                node.mark_ancestors_dirty();
+            });
+        }
+        changed
+    }
+}
