diff --git a/packages/blitz-dom/assets/default.css b/packages/blitz-dom/assets/default.css
index 304402cf..57cf0b6d 100644
--- a/packages/blitz-dom/assets/default.css
+++ b/packages/blitz-dom/assets/default.css
@@ -160,6 +160,42 @@ option {
     display: none;
 }
 
+/* A select that shows one option, not `multiple`, shows the selected one and
+   an arrow, and is as wide as its widest option, as a browser draws a closed
+   select. Its list is not drawn. */
+select:not([multiple]) {
+    display: inline-grid;
+    grid-template-columns: auto auto;
+    align-items: center;
+    white-space: nowrap;
+    border: 1px solid light-dark(#767676, #858585);
+    padding: 2px;
+    color: FieldText;
+    background-color: Field;
+}
+
+select:not([multiple]) > optgroup {
+    display: contents;
+}
+
+select:not([multiple]) > option,
+select:not([multiple]) > optgroup > option {
+    display: block;
+    grid-area: 1 / 1;
+    visibility: hidden;
+}
+
+select:not([multiple]) > option:checked,
+select:not([multiple]) > optgroup > option:checked {
+    visibility: visible;
+}
+
+select:not([multiple])::after {
+    content: "\25BE";
+    grid-area: 1 / 2;
+    padding-inline-start: 0.5em;
+}
+
 picture {
     display: contents;
 }
