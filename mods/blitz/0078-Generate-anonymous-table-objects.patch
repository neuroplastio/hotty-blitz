     fn push(&mut self, child_id: NodeId, doc: &mut BaseDocument) {
         self.maybe_push_anon_block(doc);
+        self.anonymous_table_id = None;
         self.children.push(child_id);
     }
 
     /// Append all layout children in `slice`.
