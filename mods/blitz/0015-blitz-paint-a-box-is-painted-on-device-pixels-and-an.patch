+    /// This box drawn at `offset` in device pixels, with the edges of its
+    /// border box on whole device pixels, as browsers snap a box they paint:
+    /// each edge rounded on its own, so boxes that meet still meet. The
+    /// border keeps its widths, so the padding box's edges are whole when
+    /// the widths are (Stylo snaps them). The content box stays where layout
+    /// put it, so text and images do not move.
+    pub fn snapped(&self, offset: Vec2) -> CssBox {
+        let snap = |v: f64, t: f64| (v + t + 0.5).floor() - t;
+        let bb = self.border_box;
+        let border_box = Rect::new(
+            snap(bb.x0, offset.x),
+            snap(bb.y0, offset.y),
+            snap(bb.x1, offset.x),
+            snap(bb.y1, offset.y),
+        );
+        let padding_box = border_box - self.border_width;
+        let content = self.content_box;
+        let padding = Insets {
+            x0: content.x0 - padding_box.x0,
+            y0: content.y0 - padding_box.y0,
+            x1: padding_box.x1 - content.x1,
+            y1: padding_box.y1 - content.y1,
+        };
+        let mut snapped = CssBox::new(
+            border_box,
+            self.border_width,
+            padding,
+            self.outline_width,
+            self.border_radii,
+        );
+        snapped.content_box = content;
+        snapped
+    }
+
