+        // Backgrounds, borders, shadows and outlines are drawn on device
+        // pixels, as browsers snap the boxes they paint: at a fractional
+        // scale a box sits at a fraction of a pixel, and a hairline drawn
+        // from its edge came out a different width on each side.
+        let frame = match transform.as_coeffs() {
+            [1.0, 0.0, 0.0, 1.0, tx, ty] => frame.snapped(Vec2::new(tx, ty)),
+            _ => frame,
+        };
 
         let element = node.element_data().unwrap();
 
