     text_layout.text = builder.build_into(&mut text_layout.layout);
+
+    // The end side of `text-overflow` (its only side when one value is
+    // given), shaped now so that painting can measure it and draw it.
+    text_layout.ellipsis = root_node_style.as_deref().and_then(|style| {
+        let text_overflow = style.clone_text_overflow();
+        let text = match &text_overflow.second {
+            TextOverflowSide::Clip => return None,
+            TextOverflowSide::Ellipsis => "\u{2026}",
+            TextOverflowSide::String(string) => &*string.0,
+        };
+        let mut builder = layout_ctx.tree_builder(font_ctx, scale, true, &parley_style);
+        builder.push_text(text);
+        let mut layout = parley::Layout::new();
+        builder.build_into(&mut layout);
+        layout.break_all_lines(None);
+        Some(layout)
+    });
     return;
 
