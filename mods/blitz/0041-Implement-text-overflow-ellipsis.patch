+/// Where `text-overflow` cuts the lines of a box that clips its overflow
+/// (CSS UI 4 §5.2): a left-to-right line that runs past the end edge loses
+/// the clusters and atomic inlines that would sit under its ellipsis, and
+/// the ellipsis follows what is left.
+pub(crate) struct TextOverflowCuts {
+    /// What stays visible, in the layout's coordinates: everything within
+    /// `far` of it but each cut line's band from its cut on.
+    pub(crate) visible: BezPath,
+    /// Where each cut line's ellipsis layout goes.
+    pub(crate) ellipses: Vec<Vec2>,
+}
+
+/// A line overflows when it runs past `overflow`, and its ellipsis ends by
+/// `end`.
+pub(crate) fn text_overflow_cuts(
+    layout: &Layout<TextBrush>,
+    ellipsis: &Layout<TextBrush>,
+    end: f32,
+    overflow: f32,
+    far: f64,
+) -> Option<TextOverflowCuts> {
+    if layout.is_rtl() {
+        return None;
+    }
+    let limit = end - ellipsis.full_width();
+    let ellipsis_baseline = ellipsis
+        .lines()
+        .next()
+        .map_or(0.0, |line| line.metrics().baseline);
+    let mut visible = BezPath::new();
+    let mut ellipses = Vec::new();
+    // Each line owns a band from the previous line's bottom to its own, so
+    // that glyphs taller than their line box are not cut.
+    let mut top = -far;
+    for (index, line) in layout.lines().enumerate() {
+        let metrics = line.metrics();
+        let bottom = if index + 1 == layout.len() {
+            far
+        } else {
+            metrics.block_max_coord as f64
+        };
+        let line_end = metrics.offset + metrics.advance - metrics.hanging_advance;
+        let right = if line_end > overflow + 0.5 {
+            let cut = cut_point(&line, limit);
+            ellipses.push(Vec2::new(
+                cut as f64,
+                (metrics.baseline - ellipsis_baseline) as f64,
+            ));
+            cut as f64
+        } else {
+            far
+        };
+        visible.extend(Rect::new(-far, top, right, bottom).path_elements(0.1));
+        top = bottom;
+    }
+    (!ellipses.is_empty()).then_some(TextOverflowCuts { visible, ellipses })
+}
+
+/// The end of the last cluster or atomic inline on a left-to-right `line`
+/// that ends by `limit`: what is cut is hidden whole.
+fn cut_point(line: &Line<'_, TextBrush>, limit: f32) -> f32 {
+    let limit = limit + 0.01;
+    let mut cut = line.metrics().offset;
+    for item in line.items() {
+        match item {
+            PositionedLayoutItem::GlyphRun(run) => {
+                let mut x = run.offset();
+                for cluster in run.run().visual_clusters() {
+                    x += cluster.advance();
+                    if x > limit {
+                        return cut;
+                    }
+                    cut = x;
+                }
+            }
+            PositionedLayoutItem::InlineBox(inline_box) => {
+                let box_end = inline_box.x + inline_box.width;
+                if box_end > limit {
+                    return cut;
+                }
+                cut = cut.max(box_end);
+            }
+        }
+    }
+    cut
+}
+
 pub(crate) fn stroke_text<'a>(
     scene: &mut impl PaintScene,
     lines: impl Iterator<Item = Line<'a, TextBrush>>,
