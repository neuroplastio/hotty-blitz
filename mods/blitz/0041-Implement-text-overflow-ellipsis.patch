+    /// Starts `text-overflow`'s cut when this inline root clips its overflow
+    /// and a line runs past its end edge: until `pop_text_overflow`, the
+    /// text and the atomic inlines are drawn only where the lines are kept.
+    fn push_text_overflow(
+        &self,
+        scene: &mut impl PaintScene,
+        pos: Point,
+    ) -> Option<TextOverflowCuts> {
+        if !self.node.flags.is_inline_root()
+            || matches!(self.style.get_box().overflow_x, Overflow::Visible)
+        {
+            return None;
+        }
+        let text_layout = self.element.inline_layout_data.as_ref()?;
+        let ellipsis = text_layout.ellipsis.as_ref()?;
+        let layout = self.node.final_layout();
+        let scroll = self.node.scroll_offset();
+        let end = layout.content_box_width() * self.scale as f32;
+        // Rounding moves the box's edges to whole pixels, which can leave it
+        // short of the line it was sized to hold: a line overflows only past
+        // the unrounded edge too.
+        let unrounded = self.node.unrounded_layout().content_box_width() * self.scale as f32;
+        let far = self.scale
+            * (layout.size.width as f64
+                + layout.size.height as f64
+                + scroll.x.abs()
+                + scroll.y.abs())
+            + (text_layout.layout.full_width() + text_layout.layout.height()) as f64
+            + 1.0;
+        let cuts = crate::text::text_overflow_cuts(
+            &text_layout.layout,
+            ellipsis,
+            end,
+            end.max(unrounded),
+            far,
+        )?;
+        let transform =
+            self.transform * Affine::translate((pos.x * self.scale, pos.y * self.scale));
+        scene.push_clip_layer(transform, &cuts.visible);
+        Some(cuts)
+    }
+
+    /// Ends the cut `push_text_overflow` started, and draws each cut line's
+    /// ellipsis after what is left of the line.
+    fn pop_text_overflow(
+        &self,
+        scene: &mut impl PaintScene,
+        pos: Point,
+        cuts: Option<TextOverflowCuts>,
+    ) {
+        let Some(cuts) = cuts else {
+            return;
+        };
+        scene.pop_layer();
+        let Some(ellipsis) = self
+            .element
+            .inline_layout_data
+            .as_ref()
+            .and_then(|text_layout| text_layout.ellipsis.as_ref())
+        else {
+            return;
+        };
+        let transform =
+            self.transform * Affine::translate((pos.x * self.scale, pos.y * self.scale));
+        let mut draw_text_context = self.context.draw_text_context.borrow_mut();
+        for at in cuts.ellipses {
+            crate::text::stroke_text(
+                scene,
+                ellipsis.lines(),
+                self.context.dom,
+                transform.pre_translate(at),
+                self.scale,
+                self.node.id,
+                &mut draw_text_context,
+                false,
+            );
+        }
+    }
+
