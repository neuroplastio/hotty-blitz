From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Mon, 28 Sep 2026 19:24:35 +0100
Subject: [PATCH 62/62] Apply inline-box opacity to text and span decorations

A non-atomic inline box paints no layer of its own, so its opacity
never took effect: `<span style="opacity:0">` painted fully opaque. The
glyphs, text decorations and span backgrounds and borders now take the
product of the opacities of the inline ancestors below the inline root,
whose own opacity is already a layer.

Text that fades by animating per-character span opacity showed every
state on top of each other without this.
---
 packages/blitz-paint/src/text.rs | 33 +++++++++++++++++++++++++++++---
 1 file changed, 30 insertions(+), 3 deletions(-)

diff --git a/packages/blitz-paint/src/text.rs b/packages/blitz-paint/src/text.rs
index e61c89c1f..c8bd2c12b 100644
--- a/packages/blitz-paint/src/text.rs
+++ b/packages/blitz-paint/src/text.rs
@@ -23,6 +23,19 @@ fn hint_glyphs(scale: f64) -> bool {
     !FONT_EMBOLDEN_ENABLED && scale <= 1.0
 }
 
+fn inline_opacity(doc: &BaseDocument, node_id: NodeId, inline_root_id: NodeId) -> f32 {
+    let mut opacity = 1.0;
+    let mut current = Some(node_id);
+    while let Some(id) = current.filter(|&id| id != inline_root_id) {
+        let Some(node) = doc.get_node(id) else { break };
+        if let Some(styles) = node.primary_styles() {
+            opacity *= styles.get_effects().opacity;
+        }
+        current = node.parent;
+    }
+    opacity
+}
+
