+    /// Whether Tab can bring focus here: the element is focusable and
+    /// rendered, as browsers have it. An element not displayed (nor in a
+    /// `display: none` subtree, which Stylo leaves unstyled) or not
+    /// visible (`visibility: hidden` or `collapse`) is passed over. Its
+    /// styles must be resolved.
+    pub fn is_sequentially_focussable(&self) -> bool {
+        use style::computed_values::visibility::T as Visibility;
+        self.is_focussable()
+            && self.primary_styles().is_some_and(|style| {
+                !style.get_box().display.is_none()
+                    && style.get_inherited_box().visibility == Visibility::Visible
+            })
+    }
