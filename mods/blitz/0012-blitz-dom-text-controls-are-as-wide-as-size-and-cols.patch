+/// What a text control's `size`, `cols` and `rows` attributes count in.
+pub(crate) struct ControlFontMetrics {
+    /// The width of one character.
+    pub(crate) avg: f32,
+    /// The width of the widest glyph, when `avg` is the font's own average.
+    pub(crate) max: Option<f32>,
+    /// The height of a line with `line-height: normal`, as Parley lays it out.
+    pub(crate) normal_line_height: f32,
+}
+
+/// Measures a text control's primary font (the first one with a space) as
+/// Chromium does: one character is the font's average character width (OS/2
+/// `xAvgCharWidth`), and the widest glyph the width of the font's bounding box
+/// (`head`), rounded. A font with no average, or whose average is a
+/// full-width (CJK) one, measures one character as the advance of `0`, and no
+/// widest glyph.
+pub(crate) fn control_font_metrics(
+    font_ctx: &Mutex<FontContext>,
+    font_styles: &FontStyles,
+    font_size: f32,
+) -> ControlFontMetrics {
+    use parley::fontique::QueryStatus;
+    use skrifa::instance::{LocationRef, Size};
+    use skrifa::metrics::{GlyphMetrics, Metrics};
+
+    let mut font_ctx = font_ctx.lock().unwrap();
+    let font_ctx = &mut *font_ctx;
+    let mut query = query_for_font_styles(font_ctx, font_styles);
+    let variations = stylo_to_parley::font_variations(&font_styles.font_variation_settings);
+
+    let mut found = None;
+    query.matches_with(|font| {
+        let Ok(font_ref) = skrifa::FontRef::from_index(font.blob.as_ref(), font.index) else {
+            return QueryStatus::Continue;
+        };
+        let charmap = font_ref.charmap();
+        if charmap.map(' ').is_none() {
+            return QueryStatus::Continue;
+        }
+        let location = font_ref.axes().location(
+            variations
+                .iter()
+                .map(|v| (skrifa::Tag::from_be_bytes(v.tag.to_bytes()), v.value)),
+        );
+        let location_ref = LocationRef::from(&location);
+        // Scaled as Parley scales glyph advances (see `advance_of` below).
+        let metrics = Metrics::new(&font_ref, Size::unscaled(), location_ref);
+        if metrics.units_per_em == 0 {
+            return QueryStatus::Continue;
+        }
+        let scale = font_size / metrics.units_per_em as f32;
+        let zero = charmap.map('0').and_then(|glyph| {
+            GlyphMetrics::new(&font_ref, Size::unscaled(), location_ref).advance_width(glyph)
+        });
+        let zero = zero.map(|advance| advance * scale);
+        let avg = metrics
+            .average_width
+            .filter(|avg| *avg > 0.0)
+            .map(|avg| avg * scale)
+            .filter(|avg| zero.is_none_or(|zero| *avg <= zero * 1.7));
+        let (avg, max) = match avg {
+            Some(avg) => (
+                avg,
+                metrics
+                    .bounds
+                    .map(|b| ((b.x_max - b.x_min) * scale).round()),
+            ),
+            None => (zero.unwrap_or(font_size / 2.0), None),
+        };
+        let normal_line_height = (metrics.ascent - metrics.descent + metrics.leading) * scale;
+        found = Some(ControlFontMetrics {
+            avg,
+            max,
+            normal_line_height,
+        });
+        QueryStatus::Stop
+    });
+    found.unwrap_or(ControlFontMetrics {
+        avg: font_size / 2.0,
+        max: None,
+        normal_line_height: font_size * 1.2,
+    })
+}
+
