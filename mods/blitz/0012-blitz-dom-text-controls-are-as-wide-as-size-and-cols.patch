+/// The value of a text control's `size`, `cols` or `rows` attribute: a
+/// number above zero, else `default`.
+fn control_count(value: Option<&str>, default: u32) -> f32 {
+    value
+        .and_then(|val| val.trim().parse::<u32>().ok())
+        .filter(|count| *count > 0)
+        .unwrap_or(default) as f32
+}
