+
+/// Stylesheets an embedder parses once and shares between its documents.
+///
+/// A document asks for a linked stylesheet's contents when its bytes
+/// arrive. Contents it gets here are the ones [`parse_shared_stylesheet`]
+/// made: on a read-only lock, so that any document can read them, and with
+/// their `@import`s already in. The document wraps them in a stylesheet of
+/// its own, with its own `media`, and parses nothing.
+pub trait SharedStylesheets: Send + Sync + 'static {
+    /// The parsed contents of the stylesheet at `url`, delivered as `bytes`
+    /// to document `doc_id`; `None` and the document parses `bytes` itself.
+    fn contents(
+        &self,
+        doc_id: usize,
+        url: &Url,
+        bytes: &Bytes,
+    ) -> Option<ServoArc<StylesheetContents>>;
+}
+
+/// Parses an author stylesheet so that any number of documents can share
+/// it ([`SharedStylesheets`]): on a read-only lock, so nothing can write
+/// to it, as Stylo does the user agent's sheets. Its `@import`s are
+/// resolved as it is parsed, with `import`, which returns an imported
+/// sheet's bytes: `None` from it, for any `@import`, and so for this sheet,
+/// whose import could arrive later and could not be written in.
+pub fn parse_shared_stylesheet(
+    bytes: &[u8],
+    url: &Url,
+    import: &dyn Fn(&Url) -> Option<Bytes>,
+) -> Option<ServoArc<StylesheetContents>> {
+    let lock = SharedRwLock::read_only();
+    let loader = SharedImportLoader {
+        import,
+        depth: 0,
+        missing: std::cell::Cell::new(false),
+    };
+    let sheet = loader.parse(bytes, url, ServoArc::new(lock.wrap(MediaList::empty())))?;
+    let contents = sheet.contents.read_with(&lock.read()).clone();
+    Some(contents)
+}
+
+/// Resolves a shared stylesheet's `@import`s as it is parsed.
+struct SharedImportLoader<'a> {
+    import: &'a dyn Fn(&Url) -> Option<Bytes>,
+    depth: usize,
+    missing: std::cell::Cell<bool>,
+}
+
+impl SharedImportLoader<'_> {
+    fn parse(
+        &self,
+        bytes: &[u8],
+        url: &Url,
+        media: ServoArc<Locked<MediaList>>,
+    ) -> Option<Stylesheet> {
+        let rewritten = std::str::from_utf8(bytes)
+            .ok()
+            .and_then(crate::css_compat::rewrite_legacy_widget_pseudo_rules);
+        let sheet = Stylesheet::from_bytes(
+            rewritten.as_deref().map(str::as_bytes).unwrap_or(bytes),
+            url.clone().into(),
+            None,
+            None,
+            Origin::Author,
+            media,
+            SharedRwLock::read_only(),
+            Some(self),
+            None,
+            QuirksMode::NoQuirks,
+        );
+        (!self.missing.get()).then_some(sheet)
+    }
+}
+
+impl ServoStylesheetLoader for SharedImportLoader<'_> {
+    fn request_stylesheet(
+        &self,
+        url: CssUrl,
+        location: SourceLocation,
+        lock: &SharedRwLock,
+        media: ServoArc<Locked<MediaList>>,
+        supports: Option<ImportSupportsCondition>,
+        layer: ImportLayer,
+    ) -> ServoArc<Locked<ImportRule>> {
+        // As a document's loader does: too deep, or not supported, refused.
+        let stylesheet =
+            if self.depth >= MAX_IMPORT_DEPTH || !supports.as_ref().is_none_or(|s| s.enabled) {
+                ImportSheet::new_refused()
+            } else {
+                let nested = SharedImportLoader {
+                    import: self.import,
+                    depth: self.depth + 1,
+                    missing: std::cell::Cell::new(false),
+                };
+                let sheet = url.url().and_then(|u| {
+                    let bytes = (self.import)(&**u)?;
+                    nested.parse(&bytes, &**u, media)
+                });
+                match sheet {
+                    Some(sheet) => ImportSheet::Sheet(ServoArc::new(sheet)),
+                    None => {
+                        self.missing.set(true);
+                        ImportSheet::new_refused()
+                    }
+                }
+            };
+        ServoArc::new(lock.wrap(ImportRule {
+            url,
+            stylesheet,
+            supports,
+            layer,
+            source_location: location,
+        }))
+    }
+}
+
+/// The stylesheets a shared sheet imports, all the way down, for their
+/// `@font-face` rules.
+fn imported_sheets(
+    rules: &[CssRule],
+    guard: &SharedRwLockReadGuard,
+    out: &mut Vec<ServoArc<Stylesheet>>,
+) {
+    for rule in rules {
+        if let CssRule::Import(import) = rule
+            && let ImportSheet::Sheet(sheet) = &import.read_with(guard).stylesheet
+        {
+            out.push(sheet.clone());
+            imported_sheets(sheet.contents(guard).rules(guard), guard, out);
+        }
+    }
 }
 
 impl NetHandler for ResourceHandler<StylesheetHandler> {
@@ -156,6 +289,41 @@ impl NetHandler for ResourceHandler<StylesheetHandler> {
     }
 
     fn bytes(self: Box<Self>, resolved_url: String, bytes: Bytes) {
+        if let Some(shared) = &self.data.shared_stylesheets
+            && let Some(contents) = shared.contents(self.doc_id, &self.data.source_url, &bytes)
+        {
+            let guard = &self.data.guard;
+            let sheet = Stylesheet {
+                contents: guard.wrap(contents),
+                shared_lock: guard.clone(),
+                media: ServoArc::new(guard.wrap(MediaList::empty())),
+                disabled: Default::default(),
+            };
+            // The document fetches the fonts of the sheet it is given; those
+            // of the sheets it imports are fetched here, as a document's own
+            // imports fetch theirs when they arrive.
+            let mut imports = Vec::new();
+            {
+                let read = guard.read();
+                imported_sheets(sheet.contents(&read).rules(&read), &read, &mut imports);
+                for import in &imports {
+                    fetch_font_face(
+                        self.tx.clone(),
+                        self.doc_id,
+                        self.node_id,
+                        import,
+                        &self.data.net_provider,
+                        &self.shell_provider,
+                        &read,
+                        self.data.abort_signal.as_ref(),
+                    );
+                }
+            }
+            return self.respond(
+                resolved_url,
+                Ok(Resource::Css(DocumentStyleSheet(ServoArc::new(sheet)))),
+            );
+        }
         // NOTE(Nico): I don't *think* external stylesheets should have HTML entities escaped
         // let escaped_css = html_escape::decode_html_entities(css);
 
