From 5dc2fe28c5da6ac370bf253dcd8c44103a59cb10 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Sat, 14 Nov 2026 18:33:08 +0100
Subject: [PATCH] Union collapsed border geometry before rasterization

---
 packages/blitz-paint/src/render/border.rs | 32 +++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-paint/src/render/border.rs b/packages/blitz-paint/src/render/border.rs
index a55f1c5e8..4cd97aec7 100644
--- a/packages/blitz-paint/src/render/border.rs
+++ b/packages/blitz-paint/src/render/border.rs
@@ -591,10 +591,12 @@ impl ElementCx<'_, '_> {
         // Neighbouring cells contribute the same shared edge. Union the
         // rectangles in one nonzero fill so alpha and antialiasing are applied
         // once even when edges or corners overlap.
-        let mut edges = BezPath::new();
+        let mut rectangles = Vec::new();
         let mut fill = |x0: f64, y0: f64, x1: f64, y1: f64| {
             let shape = Rect::new(x0, y0, x1, y1).scale_from_origin(self.scale);
-            edges.extend(shape.path_elements(0.1));
+            if shape.x1 > shape.x0 && shape.y1 > shape.y0 {
+                rectangles.push(shape);
+            }
         };
 
         // Paint each cell's own edges. Sweeping every grid line through the
@@ -715,6 +717,32 @@ impl ElementCx<'_, '_> {
                 bottom - gap.height,
             );
         }
+        let mut ys: Vec<f64> = rectangles.iter().flat_map(|r| [r.y0, r.y1]).collect();
+        ys.sort_by(f64::total_cmp);
+        ys.dedup();
+        let mut edges = BezPath::new();
+        for band in ys.windows(2) {
+            let (y0, y1) = (band[0], band[1]);
+            let mut spans: Vec<(f64, f64)> = rectangles
+                .iter()
+                .filter(|r| r.y0 < y1 && r.y1 > y0)
+                .map(|r| (r.x0, r.x1))
+                .collect();
+            spans.sort_by(|a, b| a.0.total_cmp(&b.0));
+            let mut merged: Vec<(f64, f64)> = Vec::new();
+            for (x0, x1) in spans {
+                if let Some(last) = merged.last_mut() {
+                    if x0 <= last.1 {
+                        last.1 = last.1.max(x1);
+                        continue;
+                    }
+                }
+                merged.push((x0, x1));
+            }
+            for (x0, x1) in merged {
+                edges.extend(Rect::new(x0, y0, x1, y1).path_elements(0.1));
+            }
+        }
         scene.fill(Fill::NonZero, self.transform, border_color, None, &edges);
     }
 
