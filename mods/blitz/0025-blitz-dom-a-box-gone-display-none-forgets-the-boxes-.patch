+    /// Forgets the boxes construction built for a box gone `display: none`
+    /// and for its subtree: layout children, anonymous blocks, inline
+    /// layouts, table contexts, hoisted out-of-flow boxes, and the paint
+    /// tree built from them. Nothing constructs them while it stays hidden.
+    /// Its parent constructs again, and may not list it any more (an inline
+    /// parent does not); its subtree is unstyled and reports no damage, not
+    /// even a removal. Kept, they named the nodes a delta freed under it,
+    /// which Taffy (hidden layout, rounding) and paint still visited. Shown
+    /// again, the subtree is styled and constructed afresh. A box with
+    /// nothing left to forget costs a look.
+    fn deconstruct(&mut self, node_id: NodeId) {
+        let node = &mut self.nodes[node_id];
+        let children = node.layout_children.get_mut().take();
+        // A hidden box Taffy lays out (in a block or flex parent, say) has
+        // children, none; one never constructed stays so.
+        if children.is_some() {
+            *node.layout_children.get_mut() = Some(ThinVec::new());
+        }
+        self.forget_boxes(node_id);
+        for child_id in children.into_iter().flatten() {
+            if self.nodes.contains_key(child_id) {
+                self.deconstruct_subtree(child_id);
+            }
+        }
+    }
+
+    fn deconstruct_subtree(&mut self, node_id: NodeId) {
+        let children = self.nodes[node_id].layout_children.get_mut().take();
+        self.forget_boxes(node_id);
+        for child_id in children.into_iter().flatten() {
+            if self.nodes.contains_key(child_id) {
+                self.deconstruct_subtree(child_id);
+            }
+        }
+    }
+
+    /// What construction, layout and the paint tree keep on a box besides
+    /// its layout children.
+    fn forget_boxes(&mut self, node_id: NodeId) {
+        use taffy::LayoutContainingBlock as _;
+        self.clear_hoisted_children(crate::taffy_node_id(node_id));
+        let node = &mut self.nodes[node_id];
+        node.flags.reset_construction_flags();
+        *node.paint_children.get_mut() = None;
+        node.stacking_context = None;
+        node.sc_contribution_cache.get_mut().clear();
+        if let Some(element) = node.element_data_mut() {
+            element.take_inline_layout();
+            if matches!(element.special_data, SpecialElementData::TableRoot(_)) {
+                element.special_data = SpecialElementData::None;
+            }
+        }
+        // Their children were the box's, deconstructed by the caller.
+        for anon_id in std::mem::take(&mut node.anonymous_blocks) {
+            self.deallocate_anonymous_block(anon_id);
+        }
+    }
+
     /// Whether this resolve keeps evicted layout caches for
     /// `speculate_layout`: only incremental relayouts of a laid-out tree.
     pub(crate) fn speculating(&self) -> bool {
