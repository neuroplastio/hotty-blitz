From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ruskin Constant <ruskin@cloudflare.com>
Date: Wed, 16 Sep 2026 12:34:44 +0100
Subject: [PATCH] Map CSS tab-size into text layout

Map number and length values to Parley tab stops and recollect inline text when tab-size changes.
---
 packages/blitz-dom/src/layout/damage.rs   |  3 ++-
 packages/blitz-dom/src/stylo_to_parley.rs | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/packages/blitz-dom/src/layout/damage.rs b/packages/blitz-dom/src/layout/damage.rs
index 89f15fbd7..bbd30d237 100644
--- a/packages/blitz-dom/src/layout/damage.rs
+++ b/packages/blitz-dom/src/layout/damage.rs
@@ -577,7 +577,8 @@ pub(crate) fn compute_layout_damage(old: &ComputedValues, new: &ComputedValues)
         let old_text = old.get_inherited_text();
         let new_text = new.get_inherited_text();
         if !std::ptr::eq(old_text, new_text)
-            && (old_text.white_space_collapse != new_text.white_space_collapse
+            && (old_text.tab_size != new_text.tab_size
+                || old_text.white_space_collapse != new_text.white_space_collapse
                 || old_text.text_transform != new_text.text_transform
                 || old_text.word_break != new_text.word_break
                 || old_text.line_break != new_text.line_break
diff --git a/packages/blitz-dom/src/stylo_to_parley.rs b/packages/blitz-dom/src/stylo_to_parley.rs
index eaab591e1..eff4c9e21 100644
--- a/packages/blitz-dom/src/stylo_to_parley.rs
+++ b/packages/blitz-dom/src/stylo_to_parley.rs
@@ -533,6 +533,15 @@ pub(crate) fn style(
     };
     let text_wrap_mode = text_wrap_mode(itext_styles.text_wrap_mode);
 
+    let tab_size = match itext_styles.tab_size {
+        style::values::computed::NonNegativeLengthOrNumber::Number(n) => {
+            parley::TabSize::Chars(n.0)
+        }
+        style::values::computed::NonNegativeLengthOrNumber::Length(l) => {
+            parley::TabSize::Px(l.px())
+        }
+    };
+
     parley::TextStyle {
         // font_family: parley::FontFamily::Single(FontFamilyName::Generic(GenericFamily::SystemUi)),
         font_family: parley::FontFamily::List(Cow::Owned(families)),
@@ -548,6 +557,7 @@ pub(crate) fn style(
         word_spacing,
         letter_spacing,
         text_wrap_mode,
+        tab_size,
         white_space_collapse: white_space_collapse(itext_styles.white_space_collapse),
         overflow_wrap,
         word_break,
