diff --git a/packages/blitz-dom/src/layout/damage.rs b/packages/blitz-dom/src/layout/damage.rs
index 117f83ef6..89f15fbd7 100644
--- a/packages/blitz-dom/src/layout/damage.rs
+++ b/packages/blitz-dom/src/layout/damage.rs
@@ -56,6 +56,33 @@ pub(crate) const CONSTRUCT_DESCENDENT: RestyleDamage =
 pub(crate) const ALL_DAMAGE: RestyleDamage =
     RestyleDamage::from_bits_retain(0b_0000_0000_1110_1111);
 
+/// Construction passes over a node it builds no box for: one an inline
+/// layout takes in, or a table's row, or a child of a table that is not a
+/// cell. Its construction damage is spent. The layout children it had as a
+/// box are forgotten, and theirs, down the boxes it owned: they name the
+/// children of then, which a delta may free or add to while nothing builds
+/// them. Each is flagged, and built afresh with its subtree when it is a
+/// layout child again (`resolve_layout_children`).
+pub(crate) fn pass_over(nodes: &mut NodeTree, node_id: NodeId) {
+    nodes[node_id].remove_damage(CONSTRUCT_DESCENDENT | CONSTRUCT_FC | CONSTRUCT_BOX);
+    forget_layout_children(nodes, node_id);
+}
+
+fn forget_layout_children(nodes: &mut NodeTree, node_id: NodeId) {
+    let node = &mut nodes[node_id];
+    node.flags.insert(NodeFlags::PASSED_OVER);
+    let children = node.layout_children.get_mut().take();
+    for child_id in children.into_iter().flatten() {
+        // A box built elsewhere since (a node moved) is not this one's.
+        if nodes
+            .get(child_id)
+            .is_some_and(|child| child.layout_parent.get() == Some(node_id))
+        {
+            forget_layout_children(nodes, child_id);
+        }
+    }
+}
+
 impl BaseDocument {
     /// Union `RestyleDamage` up the tree and clear the layout caches of every
     /// node whose subtree needs relayout.
