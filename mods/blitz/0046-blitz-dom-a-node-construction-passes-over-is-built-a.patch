diff --git a/packages/blitz-dom/src/resolve.rs b/packages/blitz-dom/src/resolve.rs
index 6ee3a2181..c4c88703c 100644
--- a/packages/blitz-dom/src/resolve.rs
+++ b/packages/blitz-dom/src/resolve.rs
@@ -264,16 +264,33 @@ impl BaseDocument {
             // children (and their `layout_parent`s) it was given last time.
             // Anonymous boxes are always walked, as `propagate_damage_flags`
             // does, because damage marking bypasses them.
+            let passed_over = doc.nodes[node_id]
+                .flags
+                .contains(crate::node::NodeFlags::PASSED_OVER);
             {
                 let node = &doc.nodes[node_id];
                 if node.damage().is_some_and(|d| d.is_empty())
                     && !node.has_damaged_descendants()
                     && !node.is_anonymous()
+                    && !passed_over
                 {
                     return;
                 }
             }
 
+            // A node construction passed over is a box again (`pass_over`).
+            // Damage under it went unbuilt meanwhile, and what its subtree
+            // kept from being boxes before (layout children, layout caches,
+            // paint lists) names the nodes of then: it is built afresh, as a
+            // new subtree is.
+            if passed_over {
+                doc.iter_subtree_mut(node_id, |id, doc| {
+                    let node = &mut doc.nodes[id];
+                    node.insert_damage(ALL_DAMAGE);
+                    node.invalidate_layout_cache();
+                });
+            }
+
             let mut damage = doc.nodes[node_id].damage().unwrap_or(ALL_DAMAGE);
             let _flags = doc.nodes[node_id].flags;
 
