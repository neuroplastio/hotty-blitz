+#[cfg(test)]
+mod passed_over_box_tests {
+    use super::*;
+    use crate::qual_name;
+    use blitz_traits::shell::ColorScheme;
+
+    /// A table lays out its cells, and passes over a block among its
+    /// children. The block's children change meanwhile; a box again, it is
+    /// built from them, not from the layout children it had before.
+    #[test]
+    fn a_block_a_table_passed_over_is_built_again() {
+        let mut doc = BaseDocument::new(DocumentConfig {
+            viewport: Some(Viewport::new(400, 300, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        });
+        let root_id = doc.root_node().id;
+        let mut mutator = doc.mutate();
+        let html = mutator.create_element(qual_name!("html", html), vec![]);
+        mutator.append_children(root_id, &[html]);
+        let body = mutator.create_element(qual_name!("body", html), vec![]);
+        mutator.append_children(html, &[body]);
+        let button = mutator.create_element(qual_name!("button", html), vec![]);
+        mutator.append_children(body, &[button]);
+        let section = mutator.create_element(qual_name!("section", html), vec![]);
+        mutator.append_children(button, &[section]);
+        let old = mutator.create_element(qual_name!("p", html), vec![]);
+        mutator.append_children(section, &[old]);
+        drop(mutator);
+        doc.resolve(0.0);
+
+        doc.mutate()
+            .set_attribute(button, qual_name!("style"), "display: table");
+        doc.resolve(0.0);
+        let mut mutator = doc.mutate();
+        let new = mutator.create_element(qual_name!("p", html), vec![]);
+        let text = mutator.create_text_node("a");
+        mutator.append_children(new, &[text]);
+        mutator.insert_nodes_before(old, &[new]);
+        mutator.remove_and_drop_node(old);
+        drop(mutator);
+        doc.resolve(0.0);
+
+        doc.mutate().clear_attribute(button, qual_name!("style"));
+        doc.resolve(0.0);
+        let section = doc.get_node(section).unwrap();
+        assert_eq!(
+            section.layout_children.borrow().as_deref(),
+            Some(&[new][..])
+        );
+        assert_eq!(section.paint_children.borrow().as_deref(), Some(&[new][..]));
+        assert!(doc.get_node(new).unwrap().final_layout().size.height > 0.0);
+    }
+
+    /// Nothing under a node construction passes over is built either, and
+    /// the damage a delta leaves there is cleared with the rest. A box again,
+    /// its subtree is built afresh.
+    #[test]
+    fn a_block_under_one_a_table_passed_over_is_built_again() {
+        let mut doc = BaseDocument::new(DocumentConfig {
+            viewport: Some(Viewport::new(400, 300, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        });
+        let root_id = doc.root_node().id;
+        let mut mutator = doc.mutate();
+        let html = mutator.create_element(qual_name!("html", html), vec![]);
+        mutator.append_children(root_id, &[html]);
+        let body = mutator.create_element(qual_name!("body", html), vec![]);
+        mutator.append_children(html, &[body]);
+        let button = mutator.create_element(qual_name!("button", html), vec![]);
+        mutator.append_children(body, &[button]);
+        let section = mutator.create_element(qual_name!("section", html), vec![]);
+        mutator.append_children(button, &[section]);
+        let div = mutator.create_element(qual_name!("div", html), vec![]);
+        mutator.append_children(section, &[div]);
+        let old = mutator.create_element(qual_name!("p", html), vec![]);
+        mutator.append_children(div, &[old]);
+        drop(mutator);
+        doc.resolve(0.0);
+
+        doc.mutate()
+            .set_attribute(button, qual_name!("style"), "display: table");
+        doc.resolve(0.0);
+        let mut mutator = doc.mutate();
+        let new = mutator.create_element(qual_name!("p", html), vec![]);
+        let text = mutator.create_text_node("a");
+        mutator.append_children(new, &[text]);
+        mutator.insert_nodes_before(old, &[new]);
+        mutator.remove_and_drop_node(old);
+        drop(mutator);
+        doc.resolve(0.0);
+
+        doc.mutate().clear_attribute(button, qual_name!("style"));
+        doc.resolve(0.0);
+        let div = doc.get_node(div).unwrap();
+        assert_eq!(div.layout_children.borrow().as_deref(), Some(&[new][..]));
+        assert_eq!(div.paint_children.borrow().as_deref(), Some(&[new][..]));
+        assert!(doc.get_node(new).unwrap().final_layout().size.height > 0.0);
+    }
+
+    /// An inline holding only a block is a box; its block made inline, it is
+    /// taken into its parent's inline layout and keeps no layout children.
+    #[test]
+    fn an_inline_taken_into_an_inline_layout_lists_no_children() {
+        let mut doc = BaseDocument::new(DocumentConfig {
+            viewport: Some(Viewport::new(400, 300, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        });
+        let root_id = doc.root_node().id;
+        let mut mutator = doc.mutate();
+        let html = mutator.create_element(qual_name!("html", html), vec![]);
+        mutator.append_children(root_id, &[html]);
+        let body = mutator.create_element(qual_name!("body", html), vec![]);
+        mutator.append_children(html, &[body]);
+        let p = mutator.create_element(qual_name!("p", html), vec![]);
+        mutator.append_children(body, &[p]);
+        let span = mutator.create_element(qual_name!("span", html), vec![]);
+        mutator.append_children(p, &[span]);
+        let button = mutator.create_element(qual_name!("button", html), vec![]);
+        let text = mutator.create_text_node("a");
+        mutator.append_children(button, &[text]);
+        mutator.append_children(span, &[button]);
+        drop(mutator);
+        doc.mutate()
+            .set_attribute(button, qual_name!("style"), "display: table");
+        doc.resolve(0.0);
+
+        doc.mutate().clear_attribute(button, qual_name!("style"));
+        doc.resolve(0.0);
+        assert_eq!(doc.get_node(button).unwrap().layout_parent.get(), Some(p));
+        assert!(
+            doc.get_node(span)
+                .unwrap()
+                .layout_children
+                .borrow()
+                .is_none()
+        );
+    }
+}
