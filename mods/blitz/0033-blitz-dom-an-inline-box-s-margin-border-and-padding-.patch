+                        let mut x0 = inline_box.x as f64;
+                        let mut x1 = x0 + inline_box.width as f64;
+                        let (InlineBoxId::Start(edge_of) | InlineBoxId::End(edge_of)) = id else {
+                            let y0 = inline_box.y as f64;
+                            add(x0, y0, x1, y0 + inline_box.height as f64);
+                            continue;
+                        };
+                        // The target's own margin lies outside its border box, on the edge
+                        // box's outer side.
+                        if edge_of == node_id {
+                            let cb_width = root_layout.content_box_width();
+                            let (_, border_padding) = inline_edge_size(node, id, Some(cb_width));
+                            let border_padding = (border_padding as f64 * scale).min(x1 - x0);
+                            let rtl = node.primary_styles().is_some_and(|s| {
+                                s.clone_direction() == style::computed_values::direction::T::Rtl
+                            });
+                            if matches!(id, InlineBoxId::Start(_)) != rtl {
+                                x0 = x1 - border_padding;
+                            } else {
+                                x1 = x0 + border_padding;
+                            }
+                        }
+                        // An edge box has no height: like a glyph run, it spans the line box.
+                        let y0 = line_metrics.block_min_coord as f64;
+                        let y1 = line_metrics.block_max_coord as f64;
+                        add(x0, y0, x1, y1);
                     }
                 }
             }
