From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Fri, 13 Nov 2026 21:30:49 +0100
Subject: [PATCH] Keep the existing box-shadow blur width

---
 packages/blitz-paint/src/render/box_shadow.rs | 10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

diff --git a/packages/blitz-paint/src/render/box_shadow.rs b/packages/blitz-paint/src/render/box_shadow.rs
index 7562f4028..2d6033b0f 100644
--- a/packages/blitz-paint/src/render/box_shadow.rs
+++ b/packages/blitz-paint/src/render/box_shadow.rs
@@ -68,12 +68,6 @@ fn snap_out(rect: Rect, grid: Vec2) -> Rect {
     )
 }
 
-/// CSS uses a Gaussian deviation of half the blur radius; vello's erf(d / std_dev)
-/// requires that deviation multiplied by sqrt(2) (css-backgrounds-3, "Blurring Shadow Edges").
-fn vello_std_dev(blur_radius: f64) -> f64 {
-    blur_radius * 0.5 * std::f64::consts::SQRT_2
-}
-
 impl ElementCx<'_, '_> {
     pub(super) fn draw_outset_box_shadow(&self, scene: &mut impl PaintScene) {
         let box_shadow = &self.style.get_effects().box_shadow.0;
@@ -130,7 +124,7 @@ impl ElementCx<'_, '_> {
                         });
 
                         let spread = shadow.spread.px() as f64 * self.scale;
-                        let std_dev = vello_std_dev(shadow.base.blur.px() as f64 * self.scale);
+                        let std_dev = shadow.base.blur.px() as f64;
                         self.draw_outset_shadow_shape(
                             scene,
                             transform,
@@ -339,7 +333,7 @@ impl ElementCx<'_, '_> {
                 hole,
                 Color::WHITE,
                 radius,
-                vello_std_dev(shadow.base.blur.px() as f64 * self.scale),
+                shadow.base.blur.px() as f64 * self.scale,
             );
 
             scene.pop_layer();
