From 835e66f87af04ca4501fe6cf0f9278ffc5b60989 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Tue, 17 Nov 2026 07:58:02 +0100
Subject: [PATCH] blitz-dom: match :placeholder-shown, following the field's
 text

:placeholder-shown never matched, so a field showing its placeholder was
styled as one holding text, and a :has() over it (a command palette's
separators, hidden once the search field has text) never changed.

Node::is_placeholder_shown reads the field: an input of a type with a
placeholder, or a textarea, whose placeholder is not empty and whose value
(its editor's text, or before it has one, the text it will start with) is
empty. The document keeps its input and textarea elements and, before each
style pass, brings their PLACEHOLDER_SHOWN state up to date, snapshotting
a styled one whose state flips so that the selectors over it are
invalidated. Text changes in many places (typing, script, the embedder),
and the check covers them all. The state also agrees with the match at the
first style pass, since Stylo shares styles only between elements in the
same state.
---
 packages/blitz-dom/src/document.rs  | 45 ++++++++++++++++++++++++++
 packages/blitz-dom/src/node/node.rs | 50 +++++++++++++++++++++++++++++
 packages/blitz-dom/src/resolve.rs   |  2 ++
 packages/blitz-dom/src/stylo/dom.rs |  2 +-
 4 files changed, 98 insertions(+), 1 deletion(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index ac4145620..c159b599e 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -316,6 +316,9 @@ pub struct BaseDocument {
     /// When each scroll container's overlay scrollbars were last shown
     /// (scrolled, or the pointer left the thumb); drives their fade-out
     pub(crate) scrollbar_activity: HashMap<NodeId, Instant>,
+    /// The `input` and `textarea` elements, whose `:placeholder-shown` follows their text
+    /// ([`BaseDocument::sync_placeholder_shown`])
+    pub(crate) text_fields: std::collections::BTreeSet<NodeId>,
     /// Whether anything scrolls horizontally and vertically
     /// ([`BaseDocument::set_scroll_axes`])
     pub(crate) scroll_axes: (bool, bool),
@@ -607,6 +610,7 @@ impl BaseDocument {
             drag_mode: DragMode::None,
             hovered_scrollbar: None,
             scrollbar_activity: HashMap::new(),
+            text_fields: Default::default(),
             scroll_axes: (true, true),
             scroll_animation: ScrollAnimationState::None,
             text_selection: TextSelection::default(),
@@ -1110,6 +1114,14 @@ impl BaseDocument {
         let id = self
             .nodes
             .insert_with_key(|id| Node::new(tree_ptr, id, guard, node_data));
+        if self.nodes[id].element_data().is_some_and(|el| {
+            matches!(
+                el.name.local,
+                local_name!("input") | local_name!("textarea")
+            )
+        }) {
+            self.text_fields.insert(id);
+        }
 
         self.has_changes = true;
         id
@@ -1939,6 +1951,39 @@ impl BaseDocument {
     /// Apply a state change (hover/focus/active/etc affecting the given [`ElementState`]
     /// bits) to a node, taking a state-only snapshot beforehand if any style rule
     /// depends on those bits.
+    /// Brings each text field's `PLACEHOLDER_SHOWN` state up to date with its text, which
+    /// typing, script and the embedder change in many places, before a style pass: a field
+    /// that has been styled gets a snapshot, so that selectors on `:placeholder-shown` (and
+    /// `:has()` over it) are invalidated. Matching reads the field itself
+    /// (`Node::is_placeholder_shown`), and the state agrees with it at every style pass,
+    /// the first included, since Stylo shares styles only between elements in the same state.
+    pub(crate) fn sync_placeholder_shown(&mut self) {
+        let mut fields = std::mem::take(&mut self.text_fields);
+        fields.retain(|&id| {
+            self.nodes
+                .get(id)
+                .and_then(|node| node.element_data())
+                .is_some_and(|el| {
+                    matches!(
+                        el.name.local,
+                        local_name!("input") | local_name!("textarea")
+                    )
+                })
+        });
+        for &id in &fields {
+            let shown = self.nodes[id].is_placeholder_shown();
+            let state = self.nodes[id].element_data().unwrap().element_state;
+            if state.contains(ElementState::PLACEHOLDER_SHOWN) != shown {
+                self.snapshot_node_and(id, ElementState::PLACEHOLDER_SHOWN, |node| {
+                    if let Some(el) = node.element_data_mut() {
+                        el.element_state.set(ElementState::PLACEHOLDER_SHOWN, shown);
+                    }
+                });
+            }
+        }
+        self.text_fields = fields;
+    }
+
     pub fn snapshot_node_and(
         &mut self,
         node_id: NodeId,
diff --git a/packages/blitz-dom/src/node/node.rs b/packages/blitz-dom/src/node/node.rs
index eba20acc4..5240dd0b3 100644
--- a/packages/blitz-dom/src/node/node.rs
+++ b/packages/blitz-dom/src/node/node.rs
@@ -1320,6 +1320,56 @@ impl Node {
     /// is not `none` (<https://drafts.csswg.org/css-ui-4/#appearance-switching>). With
     /// `none`, a check box or radio button is an ordinary box: its own styles and its
     /// `::before` and `::after` draw it.
+    /// Whether the node is a text field showing its placeholder (`:placeholder-shown`): an
+    /// `input` of a type that has one, or a `textarea`, with a placeholder that is not empty
+    /// and an empty value. The value is the field's editor text once it has an editor, and
+    /// before that what the editor will start with.
+    pub fn is_placeholder_shown(&self) -> bool {
+        let Some(el) = self.element_data() else {
+            return false;
+        };
+        let textarea = el.name.local == local_name!("textarea");
+        if !textarea && el.name.local != local_name!("input") {
+            return false;
+        }
+        if !el
+            .attr(local_name!("placeholder"))
+            .is_some_and(|p| !p.is_empty())
+        {
+            return false;
+        }
+        if !textarea
+            && el.attr(local_name!("type")).is_some_and(|ty| {
+                [
+                    "hidden",
+                    "checkbox",
+                    "radio",
+                    "file",
+                    "submit",
+                    "image",
+                    "reset",
+                    "button",
+                    "range",
+                    "color",
+                    "date",
+                    "time",
+                    "datetime-local",
+                    "month",
+                    "week",
+                ]
+                .iter()
+                .any(|t| ty.eq_ignore_ascii_case(t))
+            })
+        {
+            return false;
+        }
+        match el.text_input_data() {
+            Some(input) => input.value().is_empty(),
+            None if textarea => self.text_content().is_empty(),
+            None => el.attr(local_name!("value")).unwrap_or("").is_empty(),
+        }
+    }
+
     pub fn has_native_appearance(&self) -> bool {
         self.primary_styles().is_some_and(|s| {
             s.get_box().appearance != style::values::specified::box_::Appearance::None
diff --git a/packages/blitz-dom/src/resolve.rs b/packages/blitz-dom/src/resolve.rs
index 77c50ff81..d3d89013e 100644
--- a/packages/blitz-dom/src/resolve.rs
+++ b/packages/blitz-dom/src/resolve.rs
@@ -111,6 +111,8 @@ impl BaseDocument {
 
         let mut styled_sizes = container_sizes(self);
 
+        self.sync_placeholder_shown();
+
         // we need to resolve stylist first since it will need to drive our layout bits
         self.resolve_stylist(current_time_for_animations);
         self.resolve_counters();
diff --git a/packages/blitz-dom/src/stylo/dom.rs b/packages/blitz-dom/src/stylo/dom.rs
index 92f2f7738..92ed00eb2 100644
--- a/packages/blitz-dom/src/stylo/dom.rs
+++ b/packages/blitz-dom/src/stylo/dom.rs
@@ -298,7 +298,7 @@ impl selectors::Element for BlitzNode<'_> {
             NonTSPseudoClass::Lang(_) => false,
             NonTSPseudoClass::CustomState(_) => false,
             NonTSPseudoClass::Link => self.element_state().contains(ElementState::UNVISITED),
-            NonTSPseudoClass::PlaceholderShown => false,
+            NonTSPseudoClass::PlaceholderShown => self.is_placeholder_shown(),
             NonTSPseudoClass::ReadWrite => false,
             NonTSPseudoClass::ReadOnly => false,
             NonTSPseudoClass::ServoNonZeroBorder => false,
