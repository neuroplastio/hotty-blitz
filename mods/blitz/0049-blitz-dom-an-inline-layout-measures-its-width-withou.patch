From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Sat, 31 Oct 2026 00:07:29 +0100
Subject: [PATCH] blitz-dom: an inline layout measures its width without
 rounding it up

a1c00e08 rounds an inline layout's measured width up to a whole device
pixel, so that laying it out again at that width, divided by the scale
and multiplied back, can't come out narrower than its content by a
rounding error and break its last line. But the box is then up to a
device pixel wider than its content, and Taffy, rounding to whole CSS
pixels afterwards, can make that a whole CSS pixel: at scale 2, an
inline-block holding nine 8.8px inline-blocks (79.2px) is 80px wide,
and 79px with its width set to the same 79.2px. Which of the two a box
gets depends on its width and the scale, so content laid out on a grid
of fractional widths is ragged.

Measure the width as it is, and give line breaking the slack instead: a
line breaks when it is wider than its box by more than 1/64 of a device
pixel. That is more than the round trip's error, and less than anything
a glyph advances.

Rendered at scales 1, 1.1, 1.25, 1.5, 1.6, 1.75 and 2, 48 auto-width
inline-blocks of 3 to 37 inline-blocks 6.4 to 10.4px wide differed from
the same width set explicitly by a whole CSS pixel in 10 to 24 cases a
scale; in none now. Of 320 shrink-to-fit boxes holding one line of text
(inline-block, float, flex item and absolute, five font sizes), none
breaks before or after; without the slack, up to 24 a scale do.
---
 packages/blitz-dom/src/layout/inline.rs | 25 ++++++++++++++++---------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/packages/blitz-dom/src/layout/inline.rs b/packages/blitz-dom/src/layout/inline.rs
index 37c9748d..74ae4e4e 100644
--- a/packages/blitz-dom/src/layout/inline.rs
+++ b/packages/blitz-dom/src/layout/inline.rs
@@ -29,6 +29,12 @@ use super::resolve_calc_value;
 use crate::BaseDocument;
 use crate::stylo_to_parley;
 
+/// How much wider than its width, in device px, a line may be before it
+/// breaks. A width measured from content, divided by the scale and
+/// multiplied back, can come out below the content's own advance by a
+/// rounding error, and parley breaks a line that is wider by any amount.
+const BREAK_SLACK: f32 = 1.0 / 64.0;
+
 impl BaseDocument {
     pub(crate) fn compute_inline_layout(
         &mut self,
@@ -527,8 +533,7 @@ impl BaseDocument {
                     AvailableSpace::Definite(limit) => (limit * scale)
                         .min(max_content_width + float_width)
                         .max(min_content_width),
-                }
-                .ceil();
+                };
 
                 let style_width = node_size.width.map(|w| w * scale);
                 let min_width = node_min_size.width.map(|w| w * scale);
@@ -569,7 +574,7 @@ impl BaseDocument {
                 .inline_layout_data = Some(inline_layout);
 
             let measured_size = inputs.known_dimensions.unwrap_or(taffy::Size {
-                width: width.ceil() / scale,
+                width: width / scale,
                 // Height is ignored if RequestedAxis if Horizontal
                 height: 0.0,
             });
@@ -586,7 +591,9 @@ impl BaseDocument {
 
         #[cfg(not(feature = "floats"))]
         {
-            inline_layout.layout.break_all_lines(Some(width));
+            inline_layout
+                .layout
+                .break_all_lines(Some(width + BREAK_SLACK));
         }
 
         // Out-of-flow candidates bubbled up from this container and its in-flow subtree.
@@ -600,8 +607,8 @@ impl BaseDocument {
             let initial_slot = block_ctx.find_content_slot(0.0, Clear::None, None);
             let mut has_active_floats = initial_slot.segment_id.is_some();
             let state = breaker.state_mut();
-            state.set_layout_max_advance(width);
-            state.set_line_max_advance(initial_slot.width * scale);
+            state.set_layout_max_advance(width + BREAK_SLACK);
+            state.set_line_max_advance(initial_slot.width * scale + BREAK_SLACK);
             state.set_line_x(initial_slot.x * scale);
             state.set_line_y((initial_slot.y * scale) as f64);
 
@@ -626,12 +633,12 @@ impl BaseDocument {
                                 block_ctx.find_content_slot(min_y as f32, Clear::None, None);
                             has_active_floats = next_slot.segment_id.is_some();
 
-                            state.set_line_max_advance(next_slot.width * scale);
+                            state.set_line_max_advance(next_slot.width * scale + BREAK_SLACK);
                             state.set_line_x(next_slot.x * scale);
                             state.set_line_y((next_slot.y * scale) as f64);
                         } else {
                             state.set_line_x(0.0);
-                            state.set_line_max_advance(width);
+                            state.set_line_max_advance(width + BREAK_SLACK);
                         }
 
                         continue;
@@ -683,7 +690,7 @@ impl BaseDocument {
                             block_ctx.find_content_slot(min_y as f32, Clear::None, None);
                         has_active_floats = next_slot.segment_id.is_some();
 
-                        state.set_line_max_advance(next_slot.width * scale);
+                        state.set_line_max_advance(next_slot.width * scale + BREAK_SLACK);
                         state.set_line_x(next_slot.x * scale);
                         state.set_line_y((next_slot.y * scale) as f64);
 
