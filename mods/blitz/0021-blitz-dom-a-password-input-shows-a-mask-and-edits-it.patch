@@ -65,6 +65,34 @@ pub struct TextInputData {
     /// vertical offset. It is kept up to date so that the caret remains visible within the
     /// input's content box.
     pub scroll_offset: f32,
+    /// A password field's value. Its editor holds the mask instead, one
+    /// [`PASSWORD_MASK`] per character, and each edit of the mask is made
+    /// to the value too. `None` for any other text field.
+    password: Option<String>,
+}
+
+/// What a password field shows for each character of its value, as Chrome.
+pub const PASSWORD_MASK: char = '\u{2022}';
+
+fn mask(len: usize) -> String {
+    std::iter::repeat_n(PASSWORD_MASK, len).collect()
+}
+
+fn char_len(s: &str) -> usize {
+    s.chars().count()
+}
+
+/// The byte offset of character `index` of `s`, or its end.
+fn byte_at(s: &str, index: usize) -> usize {
+    s.char_indices().nth(index).map_or(s.len(), |(i, _)| i)
+}
+
+/// A password field's selection and length, in characters, before an edit.
+#[derive(Clone, Copy)]
+struct MaskedEdit {
+    start: usize,
+    end: usize,
+    len: usize,
 }
 
 // FIXME: Implement Clone for PlainEditor
@@ -81,16 +109,106 @@ impl TextInputData {
             editor,
             is_multiline,
             scroll_offset: 0.0,
+            password: None,
+        }
+    }
+
+    /// The field's value: what was typed, never a password field's mask.
+    pub fn value(&self) -> String {
+        match &self.password {
+            Some(value) => value.clone(),
+            None => self.editor.raw_text().to_string(),
         }
     }
 
+    /// A password field's value; `None` for any other text field.
+    pub fn password(&self) -> Option<&str> {
+        self.password.as_deref()
+    }
+
+    /// Masks the field's value, for `type=password`, or shows it again.
+    /// The selection stays on the same characters.
+    pub(crate) fn set_password(
+        &mut self,
+        font_ctx: &mut FontContext,
+        layout_ctx: &mut LayoutContext<TextBrush>,
+        on: bool,
+    ) {
+        if on == self.password.is_some() {
+            return;
+        }
+        let shown = self.editor.raw_text();
+        let selection = self.editor.raw_selection();
+        let anchor = char_len(&shown[..selection.anchor().index()]);
+        let focus = char_len(&shown[..selection.focus().index()]);
+        let text = if on {
+            let value = self.editor.text().to_string();
+            let masked = mask(char_len(&value));
+            self.password = Some(value);
+            masked
+        } else {
+            self.password.take().unwrap_or_default()
+        };
+        self.editor.set_text(&text);
+        self.editor
+            .driver(font_ctx, layout_ctx)
+            .select_byte_range(byte_at(&text, anchor), byte_at(&text, focus));
+    }
+
+    fn masked_edit(&self) -> Option<MaskedEdit> {
+        self.password.as_ref()?;
+        let shown = self.editor.raw_text();
+        let range = self.editor.raw_selection().text_range();
+        Some(MaskedEdit {
+            start: char_len(&shown[..range.start]),
+            end: char_len(&shown[..range.end]),
+            len: char_len(shown),
+        })
+    }
+
+    /// After an edit of a password field's mask, makes it to the value and
+    /// masks the field again. Every edit replaces the selection, or deletes
+    /// a run beside a collapsed one, with what it inserts before the caret,
+    /// so the old selection, the old and new lengths and the caret give the
+    /// replaced range and the inserted characters.
+    fn unmask_edit(
+        &mut self,
+        font_ctx: &mut FontContext,
+        layout_ctx: &mut LayoutContext<TextBrush>,
+        before: MaskedEdit,
+    ) {
+        let Some(value) = self.password.as_mut() else {
+            return;
+        };
+        let shown = self.editor.raw_text();
+        let len = char_len(shown);
+        let caret = char_len(&shown[..self.editor.raw_selection().focus().index()]);
+        let inserted_len = (len + before.end - before.start).saturating_sub(before.len);
+        let start = caret.saturating_sub(inserted_len);
+        let end = start + (before.len + inserted_len).saturating_sub(len);
+        let inserted: String = shown.chars().skip(start).take(inserted_len).collect();
+        value.replace_range(byte_at(value, start)..byte_at(value, end), &inserted);
+        debug_assert_eq!(char_len(value), len);
+        let masked = mask(char_len(value));
+        self.editor.set_text(&masked);
+        self.editor
+            .driver(font_ctx, layout_ctx)
+            .move_to_byte(byte_at(&masked, caret));
+    }
+
     pub fn set_text(
         &mut self,
         font_ctx: &mut FontContext,
         layout_ctx: &mut LayoutContext<TextBrush>,
         text: &str,
     ) {
-        if self.editor.text() != text {
+        if let Some(value) = &mut self.password {
+            if value != text {
+                *value = text.to_string();
+                self.editor.set_text(&mask(char_len(text)));
+                self.editor.driver(font_ctx, layout_ctx).refresh_layout();
+            }
+        } else if self.editor.text() != text {
             self.editor.set_text(text);
             self.editor.driver(font_ctx, layout_ctx).refresh_layout();
         }
@@ -192,12 +310,43 @@ impl TextInputData {
         delta - consumed
     }
 
+    /// Runs an edit; a password field's value takes it too.
+    fn edit(
+        &mut self,
+        font_ctx: &mut FontContext,
+        layout_ctx: &mut LayoutContext<TextBrush>,
+        edit: impl FnOnce(
+            &mut Self,
+            &mut FontContext,
+            &mut LayoutContext<TextBrush>,
+        ) -> Option<GeneratedTextInputEvent>,
+    ) -> Option<GeneratedTextInputEvent> {
+        let before = self.masked_edit();
+        let generated = edit(self, font_ctx, layout_ctx);
+        if let (Some(before), Some(GeneratedTextInputEvent::Input)) = (before, &generated) {
+            self.unmask_edit(font_ctx, layout_ctx, before);
+        }
+        generated
+    }
+
     pub(crate) fn apply_keypress_event(
