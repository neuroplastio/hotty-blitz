+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use blitz_traits::{events::KeyState, shell::ClipboardError};
+    use keyboard_types::{Code, Location};
+    use std::sync::Mutex;
+
+    #[derive(Default)]
+    struct Clipboard(Mutex<Option<String>>);
+
+    impl ShellProvider for Clipboard {
+        fn get_clipboard_text(&self) -> Result<String, ClipboardError> {
+            self.0.lock().unwrap().clone().ok_or(ClipboardError)
+        }
+        fn set_clipboard_text(&self, text: String) -> Result<(), ClipboardError> {
+            *self.0.lock().unwrap() = Some(text);
+            Ok(())
+        }
+    }
+
+    struct Field {
+        input: TextInputData,
+        font_ctx: FontContext,
+        layout_ctx: LayoutContext<TextBrush>,
+        shell: Clipboard,
+    }
+
+    impl Field {
+        fn password(value: &str) -> Self {
+            let mut field = Field {
+                input: TextInputData::new(false),
+                font_ctx: FontContext::new(),
+                layout_ctx: LayoutContext::new(),
+                shell: Clipboard::default(),
+            };
+            field.input.editor.set_text(value);
+            field
+                .input
+                .set_password(&mut field.font_ctx, &mut field.layout_ctx, true);
+            field
+        }
+
+        fn key(&mut self, key: Key, modifiers: Modifiers) -> Option<GeneratedTextInputEvent> {
+            let event = BlitzKeyEvent {
+                key,
+                code: Code::Unidentified,
+                modifiers,
+                location: Location::Standard,
+                is_auto_repeating: false,
+                is_composing: false,
+                state: KeyState::Pressed,
+                text: None,
+            };
+            self.input.apply_keypress_event(
+                &mut self.font_ctx,
+                &mut self.layout_ctx,
+                &self.shell,
+                event,
+            )
+        }
+
+        fn typed(&mut self, s: &str) {
+            self.key(Key::Character(s.into()), Modifiers::empty());
+        }
+
+        fn ime(&mut self, event: BlitzImeEvent) {
+            self.input
+                .apply_ime_event(&mut self.font_ctx, &mut self.layout_ctx, event);
+        }
+
+        /// The value, after checking that the field shows only its mask.
+        fn value(&self) -> String {
+            let value = self.input.value();
+            assert_eq!(self.input.editor.raw_text(), mask(char_len(&value)));
+            value
+        }
+
+        fn caret(&self) -> usize {
+            let shown = self.input.editor.raw_text();
+            char_len(&shown[..self.input.editor.raw_selection().focus().index()])
+        }
+    }
+
+    #[test]
+    fn a_password_field_shows_a_mask_and_edits_its_value() {
+        let mut f = Field::password("hunter2");
+        assert_eq!(f.value(), "hunter2");
+        f.key(Key::End, Modifiers::empty());
+        f.typed("X");
+        assert_eq!(f.value(), "hunter2X");
+        for _ in 0..3 {
+            f.key(Key::ArrowLeft, Modifiers::empty());
+        }
+        f.key(Key::Backspace, Modifiers::empty());
+        assert_eq!(f.value(), "huntr2X");
+        assert_eq!(f.caret(), 4);
+        f.key(Key::ArrowLeft, Modifiers::SHIFT);
+        f.key(Key::ArrowLeft, Modifiers::SHIFT);
+        f.typed("AB");
+        assert_eq!(f.value(), "huABr2X");
+        f.key(Key::Delete, Modifiers::empty());
+        assert_eq!(f.value(), "huAB2X");
+        f.key(Key::Home, Modifiers::empty());
+        f.key(Key::Delete, Modifiers::empty());
+        assert_eq!(f.value(), "uAB2X");
+        f.key(Key::Backspace, Modifiers::empty());
+        assert_eq!(f.value(), "uAB2X", "nothing before the caret");
+
+        // A word delete takes a run of the mask; the value loses the same.
+        f.key(Key::End, Modifiers::empty());
+        let (old, end) = (f.value(), f.caret());
+        f.key(Key::Backspace, ACTION_MOD);
+        let start = f.caret();
+        assert!(start < end);
+        let kept: String = old
+            .chars()
+            .take(start)
+            .chain(old.chars().skip(end))
+            .collect();
+        assert_eq!(f.value(), kept);
+
+        f.key(Key::Character("a".into()), ACTION_MOD);
+        f.typed("é");
+        assert_eq!(f.value(), "é", "typing replaces a selection of all");
+    }
+
+    #[test]
+    fn a_password_field_is_not_copied_or_cut_but_takes_a_paste() {
+        let mut f = Field::password("secret");
+        f.key(Key::Character("a".into()), ACTION_MOD);
+        assert!(f.key(Key::Character("c".into()), ACTION_MOD).is_none());
+        assert!(f.key(Key::Character("x".into()), ACTION_MOD).is_none());
+        assert_eq!(*f.shell.0.lock().unwrap(), None);
+        assert_eq!(f.value(), "secret");
+        *f.shell.0.lock().unwrap() = Some("pasted".into());
+        f.key(Key::Character("v".into()), ACTION_MOD);
+        assert_eq!(f.value(), "pasted");
+        assert_eq!(f.caret(), 6);
+    }
+
+    #[test]
+    fn a_password_field_composes_nothing_and_takes_a_commit() {
+        let mut f = Field::password("ab");
+        f.key(Key::End, Modifiers::empty());
+        f.ime(BlitzImeEvent::Preedit("か".into(), Some((0, 3))));
+        assert_eq!(f.value(), "ab");
+        f.ime(BlitzImeEvent::Commit("か".into()));
+        assert_eq!(f.value(), "abか");
+    }
+
+    #[test]
+    fn a_password_field_takes_a_new_value_and_shows_it_when_unmasked() {
+        let mut f = Field::password("one");
+        f.input
+            .set_text(&mut f.font_ctx, &mut f.layout_ctx, "three");
+        assert_eq!(f.value(), "three");
+        f.key(Key::End, Modifiers::empty());
+        f.key(Key::ArrowLeft, Modifiers::SHIFT);
+        f.input
+            .set_password(&mut f.font_ctx, &mut f.layout_ctx, false);
+        assert_eq!(f.input.password(), None);
+        assert_eq!(f.input.editor.raw_text(), "three");
+        assert_eq!(f.input.editor.selected_text(), Some("e"));
+        f.input
+            .set_password(&mut f.font_ctx, &mut f.layout_ctx, true);
+        assert_eq!(f.value(), "three");
+        assert_eq!(f.input.editor.selected_text(), Some("\u{2022}"));
+    }
+}
