+/// The SVG presentation attributes the cascade takes as presentational
+/// hints, of the properties Stylo computes (`vector-effect` and the stop
+/// and flood colours are Gecko's alone).
+pub(crate) fn is_svg_presentation_attribute(name: &LocalName) -> bool {
+    matches!(
+        name.as_ref(),
+        "color"
+            | "fill"
+            | "fill-opacity"
+            | "fill-rule"
+            | "opacity"
+            | "stroke"
+            | "stroke-dasharray"
+            | "stroke-dashoffset"
+            | "stroke-linecap"
+            | "stroke-linejoin"
+            | "stroke-miterlimit"
+            | "stroke-opacity"
+            | "stroke-width"
+    )
+}
