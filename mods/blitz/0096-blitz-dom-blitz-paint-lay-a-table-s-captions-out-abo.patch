 /// Convert Stylo and Taffy types into Kurbo types
+/// A table's own box, its background and border, is drawn around its grid: Taffy's box for
+/// the table holds its captions too, above and below the grid (blitz-dom's
+/// `table::layout_captions`). Returns the grid's layout and how far down it starts.
+fn table_grid_layout(dom: &BaseDocument, node: &Node, layout: Layout) -> (Layout, f32) {
+    let Some(blitz_dom::node::SpecialElementData::TableRoot(table)) =
+        node.element_data().map(|el| &el.special_data)
+    else {
+        return (layout, 0.0);
+    };
+    let (mut top, mut bottom) = (0.0f32, layout.size.height);
+    for &(id, is_top) in &table.captions {
+        let Some(caption) = dom.get_node(id) else {
+            continue;
+        };
+        let l = caption.final_layout();
+        if is_top {
+            top = top.max(l.location.y + l.size.height + l.margin.bottom);
+        } else {
+            bottom = bottom.min(l.location.y - l.margin.top);
+        }
+    }
+    let mut grid = layout;
+    grid.size.height = (bottom - top).max(0.0);
+    (grid, top)
+}
