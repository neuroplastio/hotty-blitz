+/// Lays the table's captions out above and below its grid, each as wide as the table
+/// (`width`, its border box) less the caption's margins (CSS 2.2 §17.4), and returns the
+/// height they take above the grid and below it, margins included. In `PerformLayout` it
+/// places them: the top captions from the table's top edge, the bottom ones after
+/// `grid_height`.
+pub(crate) fn layout_captions(
+    tree: &mut LayoutPassState<'_>,
+    ctx: &TableContext,
+    width: f32,
+    grid_height: f32,
+    run_mode: taffy::RunMode,
+) -> (f32, f32) {
+    let mut above = 0.0;
+    let mut below = 0.0;
+    for side_top in [true, false] {
+        let mut y = if side_top { 0.0 } else { above + grid_height };
+        for &(id, _) in ctx.captions.iter().filter(|(_, top)| *top == side_top) {
+            let node = crate::taffy_node_id(id);
+            let (margin, padding, border) = {
+                let style = tree.nodes[id].layout_style();
+                let parent = Some(width);
+                (
+                    style
+                        .margin()
+                        .resolve_or_zero(parent, super::resolve_calc_value),
+                    style
+                        .padding()
+                        .resolve_or_zero(parent, super::resolve_calc_value),
+                    style
+                        .border()
+                        .resolve_or_zero(parent, super::resolve_calc_value),
+                )
+            };
+            let inner = (width - margin.left - margin.right).max(0.0);
+            let output = tree.compute_child_layout(
+                node,
+                taffy::LayoutInput {
+                    run_mode,
+                    sizing_mode: taffy::SizingMode::InherentSize,
+                    axis: taffy::RequestedAxis::Vertical,
+                    known_dimensions: taffy::Size {
+                        width: Some(inner),
+                        height: None,
+                    },
+                    known_dimensions_are_definite: taffy::Size {
+                        width: true,
+                        height: true,
+                    },
+                    parent_size: taffy::Size {
+                        width: Some(width),
+                        height: None,
+                    },
+                    available_space: taffy::Size {
+                        width: taffy::AvailableSpace::Definite(inner),
+                        height: taffy::AvailableSpace::MaxContent,
+                    },
+                    vertical_margins_are_collapsible: taffy::Line::FALSE,
+                },
+            );
+            if run_mode == taffy::RunMode::PerformLayout {
+                let layout = taffy::Layout {
+                    order: 0,
+                    location: taffy::Point {
+                        x: margin.left,
+                        y: y + margin.top,
+                    },
+                    size: output.size,
+                    scrollable_overflow_rect: output.scrollable_overflow_rect,
+                    scrollbar_size: taffy::Size::ZERO,
+                    border,
+                    padding,
+                    margin,
+                };
+                tree.set_unrounded_layout(node, &layout);
+            }
+            let height = margin.top + output.size.height + margin.bottom;
+            y += height;
+            if side_top {
+                above += height;
+            } else {
+                below += height;
+            }
+        }
+    }
+    (above, below)
+}
+
+/// Moves the table's grid down by `dy`, the height of its top captions: its cells, and the
+/// row positions its collapsed borders are painted from.
+pub(crate) fn shift_grid(tree: &mut LayoutPassState<'_>, ctx: &TableContext, dy: f32) {
+    for cell in &ctx.cells {
+        let node = crate::taffy_node_id(cell.node_id);
+        let mut layout = *tree.nodes[cell.node_id].unrounded_layout();
+        layout.location.y += dy;
+        tree.set_unrounded_layout(node, &layout);
+    }
+    if let Some(info) = ctx.computed_grid_info.borrow_mut().as_mut() {
+        for line in &mut info.rows.positions {
+            line.start += dy;
+            line.end += dy;
+        }
+        if let Some(line) = &mut info.rows.empty_axis_line {
+            *line += dy;
+        }
+    }
+}
