             let container = &doc.nodes[container_node_id];
diff --git a/packages/blitz-dom/src/layout/inline/layout.rs b/packages/blitz-dom/src/layout/inline/layout.rs
index fc7bd1db2..1c0642d2d 100644
--- a/packages/blitz-dom/src/layout/inline/layout.rs
+++ b/packages/blitz-dom/src/layout/inline/layout.rs
@@ -1095,6 +1095,25 @@ impl LayoutPassState<'_> {
             breaker.finish();
         }
 
+        // Stylo identifies the legacy vertical WebKit box clamp after it
+        // rewrites that box to a flow-root.
+        let clamp_lines = self.nodes[node_id].primary_styles().and_then(|style| {
+            if !style.flags.contains(
+                style::computed_value_flags::ComputedValueFlags::IS_WEBKIT_LINE_CLAMP_CONTEXT,
+            ) {
+                return None;
+            }
+            style
+                .get_box()
+                .get_line_clamp()
+                .max_lines
+                .lines_value()
+                .map(|n| n.0 as usize)
+        });
+        if let Some(max_lines) = clamp_lines {
+            inline_layout.layout.truncate_lines(max_lines);
+        }
+
         // Propagate the height consumed by floats placed within this container to the
         // enclosing block context (so that the BFC root can contain them)
         #[cfg(feature = "floats")]
