+/// A table's borders in the collapsing border model (CSS 2.2 §17.6.2): a line between each
+/// pair of neighbouring grid slots, and around the grid, each resolved from the borders of
+/// the cells, rows, row groups, columns, column groups and the table that meet there.
+#[derive(Debug)]
+pub struct CollapsedBorders {
+    /// The number of rows and columns of the grid
+    pub rows: usize,
+    pub columns: usize,
+    /// Whether the columns run right to left (`direction: rtl`): column 0 is then on the
+    /// right, and vertical line `c` on the right of column `c`
+    pub rtl: bool,
+    /// The horizontal lines: `(rows + 1) * columns`, line `r` (above row `r`) over column `c`
+    /// at `r * columns + c`
+    pub horizontal: Vec<Option<CollapsedLine>>,
+    /// The vertical lines: `rows * (columns + 1)`, line `c` (left of column `c`) beside row
+    /// `r` at `r * (columns + 1) + c`
+    pub vertical: Vec<Option<CollapsedLine>>,
+}
+
+/// One segment of a collapsed border: the width and colour of the border that won it
+#[derive(Debug, Clone, Copy)]
+pub struct CollapsedLine {
+    pub width: f32,
+    pub color: AbsoluteColor,
+}
+
+impl CollapsedBorders {
+    pub fn horizontal(&self, row: usize, column: usize) -> Option<CollapsedLine> {
+        self.horizontal[row * self.columns + column]
+    }
+
+    pub fn vertical(&self, row: usize, column: usize) -> Option<CollapsedLine> {
+        self.vertical[row * (self.columns + 1) + column]
+    }
+
+    fn width(line: Option<CollapsedLine>) -> f32 {
+        line.map_or(0.0, |line| line.width)
+    }
+
+    /// A cell's border: half of the widest segment on each of its sides.
+    fn cell_border(&self, cell: &TableCell) -> taffy::Rect<f32> {
+        let r0 = (cell.row as usize).min(self.rows);
+        let r1 = (r0 + cell.row_span as usize).min(self.rows);
+        let c0 = (cell.column as usize).min(self.columns);
+        let c1 = (c0 + cell.column_span as usize).min(self.columns);
+        let across = |r: usize| {
+            (c0..c1)
+                .map(|c| Self::width(self.horizontal(r, c)))
+                .fold(0.0, f32::max)
+        };
+        let down = |c: usize| {
+            (r0..r1)
+                .map(|r| Self::width(self.vertical(r, c)))
+                .fold(0.0, f32::max)
+        };
+        self.physical(across(r0), across(r1), down(c0), down(c1))
+    }
+
+    /// Half of the lines on each side, given at the top, the bottom, the start and the end.
+    fn physical(&self, top: f32, bottom: f32, start: f32, end: f32) -> taffy::Rect<f32> {
+        let (left, right) = if self.rtl { (end, start) } else { (start, end) };
+        taffy::Rect {
+            top: top / 2.0,
+            bottom: bottom / 2.0,
+            left: left / 2.0,
+            right: right / 2.0,
+        }
+    }
+
+    /// The table's border: half of its widest outer segment on each side.
+    fn table_border(&self) -> taffy::Rect<f32> {
+        let across = |r: usize| {
+            (0..self.columns)
+                .map(|c| Self::width(self.horizontal(r, c)))
+                .fold(0.0, f32::max)
+        };
+        let down = |c: usize| {
+            (0..self.rows)
+                .map(|r| Self::width(self.vertical(r, c)))
+                .fold(0.0, f32::max)
+        };
+        self.physical(across(0), across(self.rows), down(0), down(self.columns))
+    }
+}
+
+/// A border side taking part in a collapse: its width, style and colour, and the rank of the
+/// box it is on (a cell 0, a row 1, a row group 2, a column 3, a column group 4, the table 5)
+#[derive(Clone, Copy)]
+struct BorderCandidate {
+    width: f32,
+    style: BorderStyle,
+    color: AbsoluteColor,
+    origin: u8,
+}
+
+#[derive(Clone, Copy)]
+enum Side {
+    Top,
+    Right,
+    Bottom,
+    Left,
+}
+
+fn border_candidate(
+    doc: &BaseDocument,
+    node_id: Option<NodeId>,
+    side: Side,
+    origin: u8,
+) -> Option<BorderCandidate> {
+    let node = doc.nodes.get(node_id?)?;
+    if !node.is_element() {
+        return None;
+    }
+    let style = node.primary_styles()?;
+    let border = style.get_border();
+    let (width, border_style, color) = match side {
+        Side::Top => (
+            border.border_top_width.0,
+            border.border_top_style,
+            &border.border_top_color,
+        ),
+        Side::Right => (
+            border.border_right_width.0,
+            border.border_right_style,
+            &border.border_right_color,
+        ),
+        Side::Bottom => (
+            border.border_bottom_width.0,
+            border.border_bottom_style,
+            &border.border_bottom_color,
+        ),
+        Side::Left => (
+            border.border_left_width.0,
+            border.border_left_style,
+            &border.border_left_color,
+        ),
+    };
+    Some(BorderCandidate {
+        width: width.to_f32_px(),
+        style: border_style,
+        color: color.resolve_to_absolute(&style.clone_color()),
+        origin,
+    })
+}
+
+/// The border that wins a segment (CSS 2.2 §17.6.2.1): none if any is `hidden`; else the
+/// widest, then the one of the higher-priority style, then the one on the higher-ranked
+/// box, then the first given (the one further up or to the left).
+fn resolve_collapsed(candidates: &[BorderCandidate]) -> Option<CollapsedLine> {
+    let style_rank = |style: BorderStyle| match style {
+        BorderStyle::Double => 8,
+        BorderStyle::Solid => 7,
+        BorderStyle::Dashed => 6,
+        BorderStyle::Dotted => 5,
+        BorderStyle::Ridge => 4,
+        BorderStyle::Outset => 3,
+        BorderStyle::Groove => 2,
+        BorderStyle::Inset => 1,
+        BorderStyle::None | BorderStyle::Hidden => 0,
+    };
+    if candidates.iter().any(|c| c.style == BorderStyle::Hidden) {
+        return None;
+    }
+    let mut winner: Option<&BorderCandidate> = None;
+    for candidate in candidates
+        .iter()
+        .filter(|c| c.style != BorderStyle::None && c.width > 0.0)
+    {
+        let wins = winner.is_none_or(|w| {
+            (
+                candidate.width,
+                style_rank(candidate.style),
+                u8::MAX - candidate.origin,
+            ) > (w.width, style_rank(w.style), u8::MAX - w.origin)
+        });
+        if wins {
+            winner = Some(candidate);
+        }
+    }
+    winner.map(|w| CollapsedLine {
+        width: w.width,
+        color: w.color,
+    })
+}
+
+/// Resolves the collapsed borders of a table's grid from its cells, rows, row groups,
+/// columns, column groups and the table itself. Columns run in the table's `direction`;
+/// rows run top to bottom, as in a horizontal writing mode.
+fn collapse_borders(
+    doc: &BaseDocument,
+    table: NodeId,
+    cells: &[TableCell],
+    rows: &[TableRow],
+    columns: &[TableColumn],
+) -> CollapsedBorders {
+    let rtl = doc.nodes[table]
+        .primary_styles()
+        .is_some_and(|s| s.clone_direction() == style::computed_values::direction::T::Rtl);
+    // The physical sides at the start and the end of a row
+    let (start, end) = if rtl {
+        (Side::Right, Side::Left)
     } else {
-        width.to_f32_px()
+        (Side::Left, Side::Right)
+    };
+    let row_count = rows.len();
+    let column_count = cells
+        .iter()
+        .map(|cell| cell.column as usize + cell.column_span as usize)
+        .max()
+        .unwrap_or(0)
+        .max(columns.len());
+
+    // Which cell covers each slot of the grid
+    let mut owner: Vec<Option<usize>> = vec![None; row_count * column_count];
+    for (i, cell) in cells.iter().enumerate() {
+        let r0 = cell.row as usize;
+        let c0 = cell.column as usize;
+        for r in r0..(r0 + cell.row_span as usize).min(row_count) {
+            for c in c0..(c0 + cell.column_span as usize).min(column_count) {
+                owner[r * column_count + c] = Some(i);
+            }
+        }
+    }
+    let owner_at = |r: usize, c: usize| owner[r * column_count + c];
+    // A cell takes part only with its own border, not an implicit cell's box's
+    let cell_side = |i: usize, side: Side| {
+        let cell = &cells[i];
+        (!cell.implicit)
+            .then(|| border_candidate(doc, Some(cell.node_id), side, 0))
+            .flatten()
+    };
+    let row_node = |r: usize| Some(rows[r].node_id).filter(|id| *id != NodeId::default());
+    let row_group = |r: usize| rows[r].group;
+    let column = |c: usize| columns.get(c).map(|col| col.node_id);
+    let column_group = |c: usize| columns.get(c).and_then(|col| col.group);
+    let table = Some(table);
+
+    let mut horizontal = Vec::with_capacity((row_count + 1) * column_count);
+    for r in 0..=row_count {
+        for c in 0..column_count {
+            let above = (r > 0).then(|| owner_at(r - 1, c)).flatten();
+            let below = (r < row_count).then(|| owner_at(r, c)).flatten();
+            // A line through a cell that spans it is no line
+            if above.is_some() && above == below {
+                horizontal.push(None);
+                continue;
+            }
+            let mut candidates = Vec::new();
+            candidates.extend(above.and_then(|i| cell_side(i, Side::Bottom)));
+            candidates.extend(below.and_then(|i| cell_side(i, Side::Top)));
+            if r > 0 {
+                candidates.extend(border_candidate(doc, row_node(r - 1), Side::Bottom, 1));
+            }
+            if r < row_count {
+                candidates.extend(border_candidate(doc, row_node(r), Side::Top, 1));
+            }
+            let group_above = (r > 0).then(|| row_group(r - 1)).flatten();
+            let group_below = (r < row_count).then(|| row_group(r)).flatten();
+            if group_above != group_below {
+                candidates.extend(border_candidate(doc, group_above, Side::Bottom, 2));
+                candidates.extend(border_candidate(doc, group_below, Side::Top, 2));
+            }
+            if r == 0 || r == row_count {
+                let side = if r == 0 { Side::Top } else { Side::Bottom };
+                candidates.extend(border_candidate(doc, column(c), side, 3));
+                candidates.extend(border_candidate(doc, column_group(c), side, 4));
+                candidates.extend(border_candidate(doc, table, side, 5));
+            }
+            horizontal.push(resolve_collapsed(&candidates));
+        }
+    }
+
+    let mut vertical = Vec::with_capacity(row_count * (column_count + 1));
+    for r in 0..row_count {
+        for c in 0..=column_count {
+            let left = (c > 0).then(|| owner_at(r, c - 1)).flatten();
+            let right = (c < column_count).then(|| owner_at(r, c)).flatten();
+            if left.is_some() && left == right {
+                vertical.push(None);
+                continue;
+            }
+            let mut candidates = Vec::new();
+            candidates.extend(left.and_then(|i| cell_side(i, end)));
+            candidates.extend(right.and_then(|i| cell_side(i, start)));
+            if c == 0 || c == column_count {
+                let side = if c == 0 { start } else { end };
+                candidates.extend(border_candidate(doc, row_node(r), side, 1));
+                candidates.extend(border_candidate(doc, row_group(r), side, 2));
+            }
+            if c > 0 {
+                candidates.extend(border_candidate(doc, column(c - 1), end, 3));
+            }
+            if c < column_count {
+                candidates.extend(border_candidate(doc, column(c), start, 3));
+            }
+            let group_left = (c > 0).then(|| column_group(c - 1)).flatten();
+            let group_right = (c < column_count).then(|| column_group(c)).flatten();
+            if group_left != group_right {
+                candidates.extend(border_candidate(doc, group_left, end, 4));
+                candidates.extend(border_candidate(doc, group_right, start, 4));
+            }
+            if c == 0 || c == column_count {
+                let side = if c == 0 { start } else { end };
+                candidates.extend(border_candidate(doc, table, side, 5));
+            }
+            vertical.push(resolve_collapsed(&candidates));
+        }
+    }
+
+    CollapsedBorders {
+        rows: row_count,
+        columns: column_count,
+        rtl,
+        horizontal,
+        vertical,
     }
 }
 
