From f6b7d31226f9c666f33de40b5f0128fdfb5176c1 Mon Sep 17 00:00:00 2001
From: HOTTY Agent <hotty@neuroplast.io>
Date: Wed, 14 Oct 2026 16:39:16 +0200
Subject: [PATCH 30/45] blitz-dom: a double click in a password input selects
 all of it

A password input's mask has no words: each bullet is a word of its own
to UAX #29, so a double click selected one. A browser selects the whole
value, on a double click and a triple click alike.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/blitz-dom/src/events/pointer.rs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packages/blitz-dom/src/events/pointer.rs b/packages/blitz-dom/src/events/pointer.rs
index d5e503a8b..843edbb38 100644
--- a/packages/blitz-dom/src/events/pointer.rs
+++ b/packages/blitz-dom/src/events/pointer.rs
@@ -526,6 +526,7 @@ pub(crate) fn handle_pointerdown(
             let node = &mut doc.nodes[actual_target];
             let el = node.data.downcast_element_mut().unwrap();
             if let SpecialElementData::TextInput(ref mut text_input_data) = el.special_data {
+                let password = text_input_data.password().is_some();
                 let mut font_ctx = doc.font_ctx.lock().unwrap();
                 let mut driver = text_input_data
                     .editor
@@ -539,6 +540,9 @@ pub(crate) fn handle_pointerdown(
                             driver.move_to_point(tx as f32, ty as f32);
                         }
                     }
+                    // A password field's mask has no words: a double click
+                    // selects all of it, as a browser's does.
+                    _ if password => driver.select_all(),
                     2 => driver.select_word_at_point(tx as f32, ty as f32),
                     _ => driver.select_hard_line_at_point(tx as f32, ty as f32),
                 }
