+    /// What selected text shows: the highlight behind it, the element's
+    /// `::selection` background or the default one, and whether a
+    /// `::selection` style colours the text itself. A `::selection` that
+    /// sets no background keeps the default one, as the user agent's rule
+    /// for it would.
+    fn selection_paint(&self) -> (Color, bool) {
+        let Some(selection) = self.node.selection_styles() else {
+            return (SELECTION_COLOR, false);
+        };
+        let color = selection.get_inherited_text().color;
+        let background = selection
+            .get_background()
+            .background_color
+            .resolve_to_absolute(&color);
+        let highlight = if background.alpha == 0.0 {
+            SELECTION_COLOR
+        } else {
+            background.as_srgb_color()
+        };
+        (highlight, true)
+    }
