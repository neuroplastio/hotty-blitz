+
+/// The `<use>` elements of `html`, as the serializer writes them, whose
+/// `href` (or, without one, `xlink:href`) names an element of another
+/// resource: where the value is in `html`, and what `resolve` makes of it
+/// (the resource's URL and the element's id).
+fn external_uses(
+    html: &str,
+    resolve: impl Fn(&str) -> Option<(String, String)>,
+) -> Vec<(std::ops::Range<usize>, String, String)> {
+    let mut uses = Vec::new();
+    let mut rest = 0;
+    while let Some(pos) = html[rest..].find("<use") {
+        let start = rest + pos + 4;
+        // Attribute values have `>` escaped: the tag ends at the first.
+        let Some(end) = html[start..].find('>').map(|e| start + e) else {
+            break;
+        };
+        rest = end;
+        if !html[start..]
+            .chars()
+            .next()
+            .is_some_and(|c| c.is_whitespace() || c == '/' || c == '>')
+        {
+            continue;
+        }
+        let attrs = attributes(&html[start..end], start);
+        let Some(range) = ["href", "xlink:href"]
+            .iter()
+            .find_map(|n| attrs.iter().find(|(name, _)| name == n))
+            .map(|(_, range)| range.clone())
+        else {
+            continue;
+        };
+        let href = html_escape::decode_html_entities(&html[range.clone()]);
+        if href.starts_with('#') {
+            continue;
+        }
+        if let Some((url, id)) = resolve(&href) {
+            uses.push((range, url, id));
+        }
+    }
+    uses
+}
+
+/// The `name="value"` attributes of `tag`, the inside of an opening tag
+/// that starts at `offset`: each name, and where its value is.
+fn attributes(tag: &str, offset: usize) -> Vec<(&str, std::ops::Range<usize>)> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    let bytes = tag.as_bytes();
+    while i < bytes.len() {
+        while i < bytes.len() && (bytes[i].is_ascii_whitespace() || bytes[i] == b'/') {
+            i += 1;
+        }
+        let name_start = i;
+        while i < bytes.len() && !bytes[i].is_ascii_whitespace() && bytes[i] != b'=' {
+            i += 1;
+        }
+        let name = &tag[name_start..i];
+        if tag[i..].starts_with("=\"") {
+            let from = i + 2;
+            let Some(len) = tag[from..].find('"') else {
+                break;
+            };
+            out.push((name, offset + from..offset + from + len));
+            i = from + len + 1;
+        } else if name.is_empty() {
+            i += 1;
+        }
+    }
+    out
+}
+
+/// An SVG resource that `<use>`s draw elements of, parsed once.
+pub(crate) struct Sprite {
+    nodes: Vec<XmlNode>,
+    /// Its elements by id: the first of each.
+    ids: HashMap<String, usize>,
+    /// The copies written so far, by id.
+    copies: Mutex<HashMap<String, Arc<Copy>>>,
+}
+
+enum XmlNode {
+    Text(String),
+    Element {
+        name: String,
+        /// Each attribute as written in a copy, and its value.
+        attrs: Vec<(String, String)>,
+        children: Vec<usize>,
+    },
+}
+
+/// An element of a sprite as a `<defs>` holds it: the markup, in which
+/// every id the sprite has, defined or referred to, is to be prefixed.
+struct Copy {
+    /// Markup and ids, alternately: a prefix goes before each odd chunk.
+    chunks: Vec<String>,
+    /// The ids it refers to, which are copied too.
+    refs: Vec<String>,
+    /// The ids it defines, its own and its descendants'.
+    ids: Vec<String>,
+}
+
+impl Sprite {
+    fn parse(bytes: &[u8]) -> Option<Sprite> {
+        use usvg::roxmltree::{Document, ParsingOptions};
+        let text = std::str::from_utf8(bytes).ok()?;
+        let options = ParsingOptions {
+            allow_dtd: true,
+            ..Default::default()
+        };
+        let xml = Document::parse_with_options(text, options).ok()?;
+        let mut sprite = Sprite {
+            nodes: Vec::new(),
+            ids: HashMap::new(),
+            copies: Mutex::new(HashMap::new()),
+        };
+        sprite.own(xml.root_element());
+        Some(sprite)
+    }
+
+    /// Takes `node` and what it holds into the sprite: its index.
+    fn own(&mut self, node: usvg::roxmltree::Node) -> Option<usize> {
+        if node.is_text() {
+            self.nodes
+                .push(XmlNode::Text(node.text().unwrap_or_default().to_string()));
+            return Some(self.nodes.len() - 1);
+        }
+        if !node.is_element() {
+            return None;
+        }
+        let attrs = node
+            .attributes()
+            .map(|a| {
+                // `xml:space` keeps its prefix; `xlink:href` is written as
+                // SVG 2's `href`, which needs no namespace declaration.
+                let name = match a.namespace() {
+                    Some("http://www.w3.org/XML/1998/namespace") => format!("xml:{}", a.name()),
+                    _ => a.name().to_string(),
+                };
+                (name, a.value().to_string())
+            })
+            .collect();
+        let index = self.nodes.len();
+        self.nodes.push(XmlNode::Element {
+            name: node.tag_name().name().to_string(),
+            attrs,
+            children: Vec::new(),
+        });
+        if let Some(id) = node.attribute("id") {
+            self.ids.entry(id.to_string()).or_insert(index);
+        }
+        let children: Vec<usize> = node.children().filter_map(|c| self.own(c)).collect();
+        if let XmlNode::Element { children: c, .. } = &mut self.nodes[index] {
+            *c = children;
+        }
+        Some(index)
+    }
+
+    /// Element `id`'s copy, written the first time it is asked for.
+    fn copy(&self, id: &str) -> Option<Arc<Copy>> {
+        let index = *self.ids.get(id)?;
+        let mut copies = self.copies.lock().unwrap();
+        if let Some(copy) = copies.get(id) {
+            return Some(copy.clone());
+        }
+        let mut copy = Copy {
+            chunks: vec![String::new()],
+            refs: Vec::new(),
+            ids: Vec::new(),
+        };
+        self.write(index, &mut copy);
+        let copy = Arc::new(copy);
+        copies.insert(id.to_string(), copy.clone());
+        Some(copy)
+    }
+
+    /// Writes node `index` into `copy`, its ids and its references to the
+    /// sprite's ids marked to be prefixed.
+    fn write(&self, index: usize, copy: &mut Copy) {
+        let (name, attrs, children) = match &self.nodes[index] {
+            XmlNode::Text(text) => {
+                copy.escaped(text);
+                return;
+            }
+            XmlNode::Element {
+                name,
+                attrs,
+                children,
+            } => (name, attrs, children),
+        };
+        copy.text("<");
+        copy.text(name);
+        for (attr, value) in attrs {
+            copy.text(" ");
+            copy.text(attr);
+            copy.text("=\"");
+            if attr == "id" {
+                copy.ids.push(value.clone());
+                copy.id(value);
+            } else if let Some(target) = (attr == "href")
+                .then(|| value.strip_prefix('#'))
+                .flatten()
+                .filter(|t| self.ids.contains_key(*t))
+            {
+                copy.text("#");
+                copy.refs.push(target.to_string());
+                copy.id(target);
+            } else if value.contains("url(") {
+                self.write_urls(value, copy);
+            } else {
+                copy.escaped(value);
+            }
+            copy.text("\"");
+        }
+        copy.text(">");
+        for &child in children {
+            self.write(child, copy);
+        }
+        copy.text("</");
+        copy.text(name);
+        copy.text(">");
+    }
+
+    /// Writes `value` with each `url(#id)` of an id of the sprite marked.
+    fn write_urls(&self, value: &str, copy: &mut Copy) {
+        let mut rest = value;
+        while let Some(pos) = rest.find("url(") {
+            let (head, tail) = rest.split_at(pos + 4);
+            copy.escaped(head);
+            let quote = tail
+                .trim_start()
+                .chars()
+                .next()
+                .filter(|c| *c == '"' || *c == '\'');
+            let skip = tail.len() - tail.trim_start().len() + quote.map_or(0, |_| 1);
+            copy.escaped(&tail[..skip]);
+            let tail = &tail[skip..];
+            rest = tail;
+            let Some(target) = tail.strip_prefix('#') else {
+                continue;
+            };
+            let end = target
+                .find(|c: char| c == ')' || c == '"' || c == '\'' || c.is_whitespace())
+                .unwrap_or(target.len());
+            let target = &target[..end];
+            if self.ids.contains_key(target) {
+                copy.text("#");
+                copy.refs.push(target.to_string());
+                copy.id(target);
+                rest = &tail[1 + end..];
+            }
+        }
+        copy.escaped(rest);
+    }
+}
+
+impl Copy {
+    fn text(&mut self, text: &str) {
+        self.chunks.last_mut().unwrap().push_str(text);
+    }
+
+    fn escaped(&mut self, text: &str) {
+        escape_into(text, self.chunks.last_mut().unwrap());
+    }
+
+    /// An id, to be written after the prefix.
+    fn id(&mut self, id: &str) {
+        let mut chunk = String::new();
+        escape_into(id, &mut chunk);
+        self.chunks.push(chunk);
+        self.chunks.push(String::new());
+    }
+}
+
+fn escape_into(text: &str, out: &mut String) {
+    for c in text.chars() {
+        match c {
+            '&' => out.push_str("&amp;"),
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '"' => out.push_str("&quot;"),
+            c => out.push(c),
+        }
+    }
+}
