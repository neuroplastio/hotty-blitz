         if matches!(tag_name, "svg") {
             let mut outer_html = doc.get_node(container_node_id).unwrap().svg_source();
             let targets = inline_external_fragment_refs(doc, &mut outer_html);
+            doc.inline_external_uses(&mut outer_html);
             if targets.is_empty() {
                 doc.external_svg_targets.remove(&container_node_id);
             } else {
diff --git a/packages/blitz-dom/src/mutator.rs b/packages/blitz-dom/src/mutator.rs
