+    }
+}
+
+/// A request's destination: <https://fetch.spec.whatwg.org/#concept-request-destination>,
+/// for the kinds of request a document makes.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum Destination {
+    /// Not one of the others: fetch's empty string.
+    #[default]
+    Empty,
+    /// A document to navigate to.
+    Document,
+    /// The document of an `<iframe>`.
+    Iframe,
+    /// An image: `<img>`, or an image in CSS (`background-image`,
+    /// `mask-image`).
+    Image,
+    /// A stylesheet: `<link rel=stylesheet>` or `@import`.
+    Style,
+    /// A font, from `@font-face`.
+    Font,
 }
 
 #[derive(Debug, Clone)]
