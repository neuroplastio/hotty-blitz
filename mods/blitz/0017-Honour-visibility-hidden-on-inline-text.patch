From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 3 Oct 2026 16:53:55 +0100
Subject: [PATCH 17/62] Honour visibility:hidden on inline text

render.rs skips a box whose visibility is not visible, but inline text
paints from the inline root, run by run, with no visibility check. A
hidden <span> or ::after still painted its glyphs, text decorations and
span background. For example, a math editor that sizes an empty cursor
with a hidden ::after "c" showed a stray c in every empty expression.

visibility inherits, so each run checks its own node. A hidden run
keeps its advance and paints nothing. A visible child inside a hidden
span still paints.
---
 packages/blitz-paint/src/text.rs | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/packages/blitz-paint/src/text.rs b/packages/blitz-paint/src/text.rs
index fb1eacd8c..a3bdb5ce3 100644
--- a/packages/blitz-paint/src/text.rs
+++ b/packages/blitz-paint/src/text.rs
@@ -6,6 +6,7 @@ use parley::{Affinity, Cursor, Layout, Line, PositionedLayoutItem, Selection};
 use peniko::Fill;
 use std::collections::HashMap;
 use style::properties::generated::longhands::text_decoration_style::computed_value::T as TextDecorationStyle;
+use style::properties::generated::longhands::visibility::computed_value::T as Visibility;
 use style::values::computed::{
     Length, LengthPercentage, TextDecorationLength, TextDecorationLine, TextUnderlinePosition,
 };
@@ -44,6 +45,9 @@ pub(crate) fn draw_inline_backgrounds<'a>(
             let Some(styles) = doc.get_node(node_id).and_then(|node| node.primary_styles()) else {
                 continue;
             };
+            if styles.get_inherited_box().visibility != Visibility::Visible {
+                continue;
+            }
 
             let current_color = styles.clone_color();
             let bg_color = styles
@@ -146,6 +150,7 @@ struct ResolvedDecoration {
 /// consecutive runs doesn't re-resolve them.
 struct DecorationStackEntry {
     node_id: NodeId,
+    visible: bool,
     /// This node's (inherited) text fill colour, used for the glyphs of runs whose
     /// innermost node is this one.
     fill_color: Color,
@@ -164,6 +169,7 @@ fn resolve_decoration_entry(
     let Some(styles) = node.and_then(|node| node.primary_styles()) else {
         return DecorationStackEntry {
             node_id,
+            visible: true,
             fill_color: Color::BLACK,
             decoration: None,
         };
@@ -213,6 +219,7 @@ fn resolve_decoration_entry(
 
     DecorationStackEntry {
         node_id,
+        visible: styles.get_inherited_box().visibility == Visibility::Visible,
         fill_color,
         decoration,
     }
@@ -662,6 +669,10 @@ pub(crate) fn stroke_text<'a>(
                     stack.push(resolve_decoration_entry(doc, node_id, selected));
                 }
 
+                if stack.last().is_some_and(|entry| !entry.visible) {
+                    continue;
+                }
+
                 let fill_color = brush_override
                     .unwrap_or_else(|| stack.last().map(|e| e.fill_color).unwrap_or(Color::BLACK));
 
