+/// Lays a text field's `placeholder` out in its `::placeholder` style, or
+/// drops it once the field has none. A field is flushed when it is built
+/// and when it is restyled, since `::placeholder` is computed on demand
+/// rather than in the style traversal.
+pub(crate) fn flush_placeholder(doc: &mut BaseDocument, node_id: NodeId) {
+    use style::selector_parser::PseudoElement;
+    use style::stylist::RuleInclusion;
+    use style::thread_state::{self, ThreadState};
+
+    let Some(node) = doc.nodes.get(node_id) else {
+        return;
+    };
+    let Some(input) = node.element_data().and_then(|el| el.text_input_data()) else {
+        return;
+    };
+    let is_multiline = input.is_multiline;
+    let text = node.attr(local_name!("placeholder")).unwrap_or("");
+    // An input shows its placeholder with the line breaks stripped.
+    let text: String = if is_multiline {
+        text.to_string()
+    } else {
+        text.chars().filter(|c| !matches!(c, '\n' | '\r')).collect()
+    };
+    let style = match node.primary_styles() {
+        Some(primary) if !text.is_empty() => {
+            let read_guard = doc.guard.read();
+            let guards = StylesheetGuards::same(&read_guard);
+            thread_state::enter(ThreadState::LAYOUT);
+            let style = doc.stylist.lazily_compute_pseudo_element_style(
+                &guards,
+                crate::stylo::BlitzNode(node),
+                &PseudoElement::Placeholder,
+                RuleInclusion::All,
+                &primary,
+                false,
+                None,
+            );
+            thread_state::exit(ThreadState::LAYOUT);
+            style
+        }
+        _ => None,
+    };
+    let scale = doc.viewport.scale_f64() as f32;
+    // A textarea's placeholder wraps at its content box, as layout sets its
+    // editor's width (`compute_child_layout`).
+    let width = is_multiline.then(|| node.final_layout().content_box_width() * scale);
+
+    let input = doc.nodes[node_id]
+        .data
+        .downcast_element_mut()
+        .and_then(|el| el.text_input_data_mut())
+        .unwrap();
+    let Some(style) = style else {
+        input.placeholder = None;
+        return;
+    };
+    let editor = &mut input
+        .placeholder
+        .insert(Placeholder {
+            editor: Box::new(PlainEditor::new(16.0)),
+            style: style.clone(),
+        })
+        .editor;
+    editor.set_text(&text);
+    editor.set_scale(scale);
+    editor.set_width(width);
+    set_text_style(
+        editor,
+        stylo_to_parley::style(node_id, &style),
+        stylo_to_parley::text_align(style.clone_text_align()),
+        stylo_to_parley::base_direction(style.clone_direction(), style.clone_unicode_bidi()),
     );
+    editor.refresh_layout(&mut doc.font_ctx.lock().unwrap(), &mut doc.layout_ctx);
 }
 
