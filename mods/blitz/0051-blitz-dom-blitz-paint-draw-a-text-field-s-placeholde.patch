@@ -1190,6 +1190,39 @@ impl ElementCx<'_, '_> {
     fn draw_text_input_text(&self, scene: &mut impl PaintScene, pos: Point) {
         // Render the text in text inputs
         if let Some(input_data) = self.text_input {
+            // While the field is empty, its placeholder in its `::placeholder` style, centred
+            // as the field's own text would be.
+            if let Some(layout) = input_data
+                .placeholder
+                .as_ref()
+                .filter(|_| input_data.editor.raw_text().is_empty())
+                .and_then(|placeholder| Some((placeholder, placeholder.editor.try_layout()?)))
+            {
+                let (placeholder, layout) = layout;
+                let y_offset = if input_data.is_multiline {
+                    0.0
+                } else {
+                    let content_box_height = self.node.final_layout().content_box_height() as f64;
+                    ((content_box_height - layout.height() as f64 / self.scale) / 2.0).max(0.0)
+                };
+                let transform = self.transform
+                    * Affine::translate((pos.x * self.scale, (pos.y + y_offset) * self.scale));
+                crate::text::fill_text(
+                    scene,
+                    layout.lines(),
+                    transform,
+                    self.scale,
+                    // Its `opacity` too, which the glyphs' own alpha would not carry to
+                    // every renderer.
+                    placeholder
+                        .style
+                        .get_inherited_text()
+                        .color
+                        .as_srgb_color()
+                        .multiply_alpha(placeholder.style.get_effects().opacity),
+                );
+            }
+
             // For single-line inputs, add an offset to vertically center the text input layout
             // within the content box of it's node.
             let y_offset = self.node.text_input_v_centering_offset(self.scale);
