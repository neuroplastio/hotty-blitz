+/// The style of the anonymous content box of fieldset `id` (`collect_fieldset_children`): an
+/// anonymous box's, laid out as the fieldset's `display` says, with the fieldset's flex and
+/// grid container properties and its padding.
+pub(crate) fn fieldset_content_style(
+    doc: &BaseDocument,
+    id: NodeId,
+) -> style::servo_arc::Arc<style::properties::ComputedValues> {
+    use style::properties::StyleBuilder;
+    use style::selector_parser::PseudoElement;
+
+    let parent_style = doc.nodes[id].primary_styles().unwrap();
+    let read_guard = doc.guard.read();
+    let guards = StylesheetGuards::same(&read_guard);
+    let anon_style = doc.stylist.style_for_anonymous::<BlitzNode>(
+        &guards,
+        &PseudoElement::ServoAnonymousBox,
+        &parent_style,
+    );
+    let mut builder = StyleBuilder::for_derived_style(
+        doc.stylist.device(),
+        Some(&doc.stylist),
+        &anon_style,
+        Some(&parent_style),
+    );
+    builder.mutate_box().set_display(match parent_style.clone_display().inside() {
+        DisplayInside::Flex => Display::Flex,
+        DisplayInside::Grid => Display::Grid,
+        _ => Display::FlowRoot,
+    });
+    let from = parent_style.get_position();
+    let to = builder.mutate_position();
+    to.copy_flex_direction_from(from);
+    to.copy_flex_wrap_from(from);
+    to.copy_justify_content_from(from);
+    to.copy_align_content_from(from);
+    to.copy_align_items_from(from);
+    to.copy_justify_items_from(from);
+    to.copy_row_gap_from(from);
+    to.copy_column_gap_from(from);
+    to.copy_grid_template_rows_from(from);
+    to.copy_grid_template_columns_from(from);
+    to.copy_grid_template_areas_from(from);
+    to.copy_grid_auto_rows_from(from);
+    to.copy_grid_auto_columns_from(from);
+    to.copy_grid_auto_flow_from(from);
+    let from = parent_style.get_padding();
+    let to = builder.mutate_padding();
+    to.copy_padding_top_from(from);
+    to.copy_padding_right_from(from);
+    to.copy_padding_bottom_from(from);
+    to.copy_padding_left_from(from);
+    builder.build()
+}
+
+/// The rendered legend of fieldset `id`: its first `legend` child, if that is
+/// neither floated nor absolutely positioned, and the fieldset is laid out as
+/// a flow, flex or grid container.
+fn rendered_legend(doc: &BaseDocument, id: NodeId) -> Option<NodeId> {
+    let node = &doc.nodes[id];
+    if !node.data.is_element_with_tag_name(&local_name!("fieldset"))
+        || !matches!(
+            node.display_style()?.inside(),
+            DisplayInside::Flow | DisplayInside::FlowRoot | DisplayInside::Flex | DisplayInside::Grid
+        )
+    {
+        return None;
+    }
+    let legend = node
+        .children
+        .iter()
+        .copied()
+        .find(|&c| doc.nodes[c].data.is_element_with_tag_name(&local_name!("legend")))?;
+    let style = doc.nodes[legend].primary_styles()?;
+    let rendered = !matches!(
+        style.clone_display().inside(),
+        DisplayInside::None | DisplayInside::Contents
+    ) && !style.clone_float().is_floating()
+        && !style.clone_position().is_absolutely_positioned();
+    rendered.then_some(legend)
+}
+
+/// A fieldset with a rendered legend: the legend, and then an anonymous
+/// fieldset content box holding the rest. The content box is laid out as the
+/// fieldset's `display` says (flow, flex or grid), with its flex and grid
+/// container properties and its padding; the fieldset itself lays the two out
+/// in a flow of its own (`NodeFlags::IS_FIELDSET_WITH_CONTENT_BOX`). So a
+/// flex fieldset's `gap` is between its content's items and not after the
+/// legend, and the legend is not stretched as a flex item would be.
+fn collect_fieldset_children(
+    doc: &mut BaseDocument,
+    id: NodeId,
+    legend: NodeId,
+    out: &mut LayoutChildren,
+) {
+    const NAME: QualName = QualName {
+        prefix: None,
+        ns: ns!(html),
+        local: local_name!("div"),
+    };
+    let content: Vec<NodeId> = {
+        let node = &doc.nodes[id];
+        node.before()
+            .into_iter()
+            .chain(node.children.iter().copied().filter(|&c| c != legend))
+            .chain(node.after())
+            .collect()
+    };
+    let anon = doc.create_node(NodeData::AnonymousBlock(Box::new(ElementData::new(
+        NAME,
+        Vec::new(),
+    ))));
+
+    let style = fieldset_content_style(doc, id);
+    let mut stylo_element_data = StyloElementData {
+        damage: ALL_DAMAGE,
+        ..Default::default()
+    };
+    stylo_element_data.styles.primary = Some(style);
+    stylo_element_data.set_restyled();
+    *doc.nodes[anon].stylo_element_data_mut().ensure_init_mut() = stylo_element_data;
+    if doc.nodes[id].flags.contains(NodeFlags::IS_IN_DOCUMENT) {
+        doc.nodes[anon].flags.insert(NodeFlags::IS_IN_DOCUMENT);
+    }
+    doc.nodes[anon].parent = Some(id);
+    doc.nodes[anon].layout_parent.set(Some(id));
+    doc.nodes[anon].children = content.into();
+
+    out.children.push(legend);
+    out.children.push(anon);
+    out.anonymous_blocks.push(anon);
+    doc.nodes[id]
+        .flags
+        .insert(NodeFlags::IS_FIELDSET_WITH_CONTENT_BOX);
+}
+
 /// The layout children of `container_node_id` as its `display` lays them out.
 fn collect_box_children(
     doc: &mut BaseDocument,
