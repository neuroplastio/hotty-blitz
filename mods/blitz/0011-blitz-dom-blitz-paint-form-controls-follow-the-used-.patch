+    square: Rect,
     transform: Affine,
-    accent_color: Color,
+    colors: &ControlColors,
     scale: f64,
 ) {
+    let border = scale;
+    let radius = 2.0 * scale;
+    let outer = RoundedRect::from_rect(square, radius);
     if checked {
-        scene.fill(Fill::NonZero, transform, accent_color, None, &frame);
-        //Tick code derived from masonry
-        let mut path = BezPath::new();
-        path.move_to((2.0, 9.0));
-        path.line_to((6.0, 13.0));
-        path.line_to((14.0, 2.0));
-
-        path.apply_affine(Affine::translate(Vec2 { x: 2.0, y: 1.0 }).then_scale(scale));
+        scene.fill(Fill::NonZero, transform, colors.accent, None, &outer);
 
+        let (x, y, w, h) = (square.x0, square.y0, square.width(), square.height());
+        let mut path = BezPath::new();
+        path.move_to((x + w * 0.2, y + h * 0.5));
+        path.line_to((x + w * 0.4, y + h * 0.7));
+        path.line_to((x + w * 0.8, y + h * 0.2));
         let style = Stroke {
-            width: 2.0 * scale,
-            join: Join::Round,
+            width: h * 0.16,
+            join: Join::Miter,
             miter_limit: 10.0,
-            start_cap: Cap::Round,
-            end_cap: Cap::Round,
+            start_cap: Cap::Butt,
+            end_cap: Cap::Butt,
             dash_pattern: Default::default(),
             dash_offset: 0.0,
         };
-
-        scene.stroke(&style, transform, Color::WHITE, None, &path);
+        scene.stroke(&style, transform, colors.mark, None, &path);
     } else {
-        scene.fill(Fill::NonZero, transform, Color::WHITE, None, &frame);
-        scene.stroke(&Stroke::default(), transform, accent_color, None, &frame);
+        let inner = RoundedRect::from_rect(square.inset(-border), (radius - border).max(0.0));
+        scene.fill(Fill::NonZero, transform, colors.border, None, &outer);
+        scene.fill(Fill::NonZero, transform, colors.field, None, &inner);
     }
 }
 
+/// A 1px ring; checked, the ring takes the accent and a dot of it fills the
