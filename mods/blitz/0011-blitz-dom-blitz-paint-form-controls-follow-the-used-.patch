+/// The colors of a checkbox or radio button in a color scheme, those Chromium
+/// draws with `accent-color: auto` (Stylo's Servo build has no `accent-color`).
+struct ControlColors {
+    /// The fill of a checked control, and its border.
+    accent: Color,
+    /// The fill of an unchecked control.
+    field: Color,
+    /// The border of an unchecked control.
+    border: Color,
+    /// The check mark.
+    mark: Color,
+}
+
+impl ControlColors {
+    fn new(scheme: ColorScheme, disabled: bool) -> Self {
+        let rgb = Color::from_rgb8;
+        match (scheme, disabled) {
+            (ColorScheme::Light, false) => Self {
+                accent: rgb(0x00, 0x75, 0xFF),
+                field: rgb(0xFF, 0xFF, 0xFF),
+                border: rgb(0x76, 0x76, 0x76),
+                mark: rgb(0xFF, 0xFF, 0xFF),
+            },
+            (ColorScheme::Light, true) => Self {
+                accent: rgb(0xD0, 0xD0, 0xD0),
+                field: rgb(0xF7, 0xF7, 0xF7),
+                border: rgb(0xD0, 0xD0, 0xD0),
+                mark: rgb(0xEC, 0xEC, 0xEC),
+            },
+            (ColorScheme::Dark, false) => Self {
+                accent: rgb(0x99, 0xC8, 0xFF),
+                field: rgb(0x3B, 0x3B, 0x3B),
+                border: rgb(0x85, 0x85, 0x85),
+                mark: rgb(0x3B, 0x3B, 0x3B),
+            },
+            (ColorScheme::Dark, true) => Self {
+                accent: rgb(0x75, 0x75, 0x75),
+                field: rgb(0x3B, 0x3B, 0x3B),
+                border: rgb(0x62, 0x62, 0x62),
+                mark: rgb(0x3B, 0x3B, 0x3B),
+            },
+        }
+    }
+}
+
