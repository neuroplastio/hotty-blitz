 use blitz_traits::net::{AbortSignal, DummyNetProvider, NetProvider, Request};
 use blitz_traits::node_id::NodeId;
-use blitz_traits::shell::{DummyShellProvider, ShellProvider, Viewport};
+use blitz_traits::shell::{ColorScheme, DummyShellProvider, ShellProvider, Viewport};
 use cursor_icon::CursorIcon;
 use linebender_resource_handle::Blob;
 use markup5ever::{LocalName, local_name};
@@ -2020,6 +2020,25 @@ impl BaseDocument {
         &self.viewport
     }
 
+    /// The color scheme an element with this style is drawn in: the one its
+    /// `color-scheme` names when it names only light or only dark, else the
+    /// viewport's preferred one. Stylo resolves system colors the same way,
+    /// so what paint draws in this scheme matches the element's `Field`,
+    /// `ButtonFace` and the other system colors.
+    pub fn used_color_scheme(&self, style: &ComputedValues) -> ColorScheme {
+        use style::values::specified::color::ColorSchemeFlags;
+        let flags = style.get_inherited_ui().color_scheme_bits();
+        let dark = flags.contains(ColorSchemeFlags::DARK);
+        if dark != flags.contains(ColorSchemeFlags::LIGHT) {
+            return if dark {
+                ColorScheme::Dark
+            } else {
+                ColorScheme::Light
+            };
+        }
+        self.viewport.color_scheme
+    }
+
     pub fn viewport_mut(&mut self) -> ViewportMut<'_> {
         ViewportMut::new(self)
     }
