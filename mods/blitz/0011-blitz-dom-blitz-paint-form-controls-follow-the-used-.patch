diff --git a/packages/blitz-dom/assets/default.css b/packages/blitz-dom/assets/default.css
index efec5738..304402cf 100644
--- a/packages/blitz-dom/assets/default.css
+++ b/packages/blitz-dom/assets/default.css
@@ -58,25 +58,37 @@ input[type="hidden" i] {
     display: none !important;
 }
 
+/* Form controls take their colors from the CSS system colors, which resolve
+ * in the element's used color scheme (https://drafts.csswg.org/css-color-adjust/#color-scheme-prop),
+ * so a page with `color-scheme: dark` gets dark fields and buttons. The
+ * borders are the ones Chromium draws in each scheme. */
+
+/* Checkboxes and radio buttons are drawn whole by blitz-paint (form_controls.rs),
+ * so nothing of the box is painted under them. */
+input[type="checkbox"],
+input[type="radio"] {
+    box-sizing: border-box;
+    width: 13px;
+    height: 13px;
+    padding: 0;
+    border: none;
+    background-color: transparent;
+}
+
 input[type="checkbox"] {
-    width: 14px;
-    height: 14px;
     margin: 3px 3px 3px 4px;
 }
 
 input[type="radio"] {
-    width: 14px;
-    height: 14px;
-    border-radius: 14px;
-    border: none;
-    margin: 3px 3px 3px 4px;
+    margin: 3px 3px 0 5px;
 }
 
 input,
 textarea {
-    border: 1px solid #999;
+    border: 1px solid light-dark(#767676, #858585);
     padding: 2px;
-    background-color: white;
+    color: FieldText;
+    background-color: Field;
 }
 
 input,
@@ -98,11 +110,11 @@ button,
 input[type="submit"],
 input[type="reset"],
 input[type="button"] {
-    border: 1px solid #999;
+    border: 1px solid light-dark(#767676, #6B6B6B);
     border-radius: 1px;
     padding: 1px 6px;
-    color: black;
-    background-color: #EFEFEF;
+    color: ButtonText;
+    background-color: ButtonFace;
     text-align: center;
     display: inline-flex;
     align-items: center;
