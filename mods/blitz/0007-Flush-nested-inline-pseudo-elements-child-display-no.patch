From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sun, 26 Jul 2026 00:14:38 +0100
Subject: [PATCH 07/61] Flush nested inline pseudo-elements (child display, not
 parent's)

flush_inline_pseudos_recursive decided whether to recurse into a
child by reading the display of the node being iterated (the parent)
instead of the child's. For a block inline-context root the check was
always false, so ::before/::after on inline elements nested deeper
than one level (p > span > i.icon:before; every icon-font pattern)
were never synthesized. The inline layout builder already handles
nested pseudos; the nodes just never existed. Found on
azuleja.azulpop.pt's bootstrap-icons empty-state icons.
---
 packages/blitz-dom/src/layout/construct.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/packages/blitz-dom/src/layout/construct.rs b/packages/blitz-dom/src/layout/construct.rs
index b22d74954..2051fbd74 100644
--- a/packages/blitz-dom/src/layout/construct.rs
+++ b/packages/blitz-dom/src/layout/construct.rs
@@ -964,7 +964,8 @@ pub(crate) fn find_inline_layout_embedded_boxes(
     fn flush_inline_pseudos_recursive(doc: &mut BaseDocument, node_id: NodeId) {
         doc.iter_children_mut(node_id, |child_id, doc| {
             flush_pseudo_elements(doc, child_id);
-            let display = doc.nodes[node_id]
+            // The child determines whether the walk can reach nested pseudos.
+            let display = doc.nodes[child_id]
                 .display_style()
                 .unwrap_or(Display::inline());
             let do_recurse = match (display.outside(), display.inside()) {
