From 808ce555d883d29bc34bec9723aae3809a5a45f1 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Sat, 14 Nov 2026 18:20:52 +0100
Subject: [PATCH] Place shared collapsed borders in track gutters

---
 packages/blitz-paint/src/render/border.rs | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/packages/blitz-paint/src/render/border.rs b/packages/blitz-paint/src/render/border.rs
index 42292769e..0237b6841 100644
--- a/packages/blitz-paint/src/render/border.rs
+++ b/packages/blitz-paint/src/render/border.rs
@@ -1,6 +1,6 @@
 use anyrender::PaintScene;
-use blitz_dom::CopyStyleGetters;
 use blitz_dom::node::SpecialElementData;
+use blitz_dom::CopyStyleGetters;
 use kurbo::{BezPath, Cap, Circle, Insets, Join, PathEl, Point, Rect, Shape as _, Stroke, Vec2};
 use peniko::{Color, Fill};
 use smallvec::SmallVec;
@@ -10,7 +10,7 @@ use style::{
 };
 
 use crate::{
-    color::{ToColorColor as _, contrast_ratio},
+    color::{contrast_ratio, ToColorColor as _},
     kurbo_css::Edge,
     render::{ElementCx, PhysicalTracks},
 };
@@ -650,25 +650,33 @@ impl ElementCx<'_, '_> {
             } else {
                 col_start as f64
             };
-            let ex1 = if has_right { x1 } else { col_end as f64 };
+            let ex1 = if has_right {
+                x1 + border_width_x
+            } else {
+                col_end as f64
+            };
             let ey0 = if has_top {
                 y0 - border_width_y
             } else {
                 row_start as f64
             };
-            let ey1 = if has_bottom { y1 } else { row_end as f64 };
+            let ey1 = if has_bottom {
+                y1 + border_width_y
+            } else {
+                row_end as f64
+            };
 
             if has_left {
                 fill(x0 - border_width_x, ey0, x0, ey1);
             }
             if has_right {
-                fill(x1 - border_width_x, ey0, x1, ey1);
+                fill(x1, ey0, x1 + border_width_x, ey1);
             }
             if has_top {
                 fill(ex0, y0 - border_width_y, ex1, y0);
             }
             if has_bottom {
-                fill(ex0, y1 - border_width_y, ex1, y1);
+                fill(ex0, y1, ex1, y1 + border_width_y);
             }
         }
 
