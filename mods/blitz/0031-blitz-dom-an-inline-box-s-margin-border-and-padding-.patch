+
+// The inline-start and inline-end margin, border and padding of a non-atomic inline box (a
+// `<span>`, say) take space in the line, but parley knows only the box's text style. So
+// construction places a zero-height inline box at the start and the end of the element's
+// style span for each edge that has any, and layout sizes it and puts it in flow like an
+// atomic inline, leaving line breaking, alignment, bidi reordering and hit testing to parley.
+//
+// An edge box's id is the element's node id with `INLINE_EDGE` set, and `INLINE_EDGE_END` too
+// for the end edge. Node ids keep their slot's version in the high bits, which reach these
+// only once a slot has been reused about 2^29 times.
+const INLINE_EDGE: u64 = 1 << 63;
+const INLINE_EDGE_END: u64 = 1 << 62;
+
+/// What an inline box in an inline root's parley layout stands for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum InlineBoxId {
+    /// An atomic inline, or an out-of-flow box placed in the line.
+    Node(NodeId),
+    /// The inline-start edge of a non-atomic inline box.
+    Start(NodeId),
+    /// The inline-end edge of a non-atomic inline box.
+    End(NodeId),
+}
+
+impl InlineBoxId {
+    pub(crate) fn node_id(self) -> NodeId {
+        match self {
+            Self::Node(id) | Self::Start(id) | Self::End(id) => id,
+        }
+    }
+
+    pub(crate) fn from_u64(id: u64) -> Self {
+        let node_id = NodeId::from_u64(id & !(INLINE_EDGE | INLINE_EDGE_END));
+        if id & INLINE_EDGE == 0 {
+            Self::Node(NodeId::from_u64(id))
+        } else if id & INLINE_EDGE_END == 0 {
+            Self::Start(node_id)
+        } else {
+            Self::End(node_id)
+        }
+    }
+
+    pub(crate) fn as_u64(self) -> u64 {
+        match self {
+            Self::Node(id) => id.as_u64(),
+            Self::Start(id) => id.as_u64() | INLINE_EDGE,
+            Self::End(id) => id.as_u64() | INLINE_EDGE | INLINE_EDGE_END,
+        }
+    }
+}
+
+/// Whether the inline-start and inline-end edges of a non-atomic inline box with this style
+/// have margin, border or padding. A percentage or `calc()` counts, as its size is only known
+/// at layout.
+pub(crate) fn inline_edges(style: &ComputedValues) -> (bool, bool) {
+    let margin = style.get_margin();
+    let padding = style.get_padding();
+    let border = style.get_border();
+    let side = |margin: &GenericMargin<LengthPercentage>,
+                padding: &LengthPercentage,
+                width: &BorderSideWidth,
+                border_style: BorderStyle| {
+        matches!(margin, GenericMargin::LengthPercentage(m) if !m.is_zero())
+            || !padding.is_zero()
+            || (!border_style.none_or_hidden() && width.0.to_f32_px() != 0.0)
+    };
+    let left = side(
+        &margin.margin_left,
+        &padding.padding_left.0,
+        &border.border_left_width,
+        border.border_left_style,
+    );
+    let right = side(
+        &margin.margin_right,
+        &padding.padding_right.0,
+        &border.border_right_width,
+        border.border_right_style,
+    );
+    match style.clone_direction() {
+        StyloDirection::Ltr => (left, right),
+        StyloDirection::Rtl => (right, left),
+    }
+}
+
+/// The margin, and the border and padding, on the side of a non-atomic inline box that
+/// `edge` (an `InlineBoxId::Start` or `End`) stands for, in CSS px. Percentages resolve
+/// against `cb_width`, the inline size of the containing block.
+pub(crate) fn inline_edge_size(
+    node: &crate::Node,
+    edge: InlineBoxId,
+    cb_width: Option<f32>,
+) -> (f32, f32) {
+    let style = node.layout_style();
+    let rtl = style.direction() == Direction::Rtl;
+    let left = matches!(edge, InlineBoxId::Start(_)) != rtl;
+    let margin = style.margin().resolve_or_zero(cb_width, resolve_calc_value);
+    let border = style.border().resolve_or_zero(cb_width, resolve_calc_value);
+    let padding = style
+        .padding()
+        .resolve_or_zero(cb_width, resolve_calc_value);
+    if left {
+        (margin.left, border.left + padding.left)
+    } else {
+        (margin.right, border.right + padding.right)
+    }
+}
