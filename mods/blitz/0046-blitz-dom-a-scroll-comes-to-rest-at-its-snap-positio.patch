+//! CSS Scroll Snap (<https://drafts.csswg.org/css-scroll-snap-1/>): where a scroll comes to
+//! rest in a scroll container whose `scroll-snap-type` is not `none`.
+//!
+//! A snap container's snap areas are the border boxes of the elements it scrolls whose
+//! `scroll-snap-align` is not `none`. Each gives a snap position along each axis the container
+//! snaps along: the scroll offset that aligns the area's start, end or centre with the
+//! container's snapport (its scrollport less `scroll-padding`), or, for an area longer than the
+//! snapport, every offset at which it covers the snapport ("Snapping Boxes that Overflow the
+//! Scrollport"), so that a mandatory snap never leaves part of it out of reach. A position the
+//! container cannot reach is the nearest it can ("Unreachable Snap Positions").
+//!
+//! When a scroll comes to rest, the snap position it rests at is chosen by what the scroll meant
+//! to do ([`ScrollSnapIntent`]), as "Choosing Snap Positions" tells scrolls apart, and only
+//! along an axis where one is near enough: always for `mandatory`, within a third of the
+//! snapport for `proximity`. A scroll with a direction stops at an area whose
+//! `scroll-snap-stop` is `always` rather than pass over it. Where no position qualifies, the
+//! scroll rests where it ended.
+//!
+//! A scroller whose content overflows the other way (`direction: rtl`, a reversed flex box)
+//! snaps within its range below zero. Not done: `scroll-margin` (areas are border boxes),
+//! writing modes and direction (the block axis is `y`, and `start` is the top or left edge
+//! whichever way content overflows), preferring the same area along both axes, and snapping
+//! again after layout changes.
+
+use blitz_traits::node_id::NodeId;
+use style::computed_values::position::T as Position;
+use style::properties::ComputedValues;
+use style::values::computed::length::CSSPixelLength;
+use style::values::computed::{
+    NonNegativeLengthPercentageOrAuto, Overflow, ScrollSnapAxis, ScrollSnapStop,
+    ScrollSnapStrictness,
+};
+use style::values::generics::length::GenericLengthPercentageOrAuto;
+use style::values::specified::box_::ScrollSnapAlignKeyword;
+use stylo_taffy::CopyStyleGetters;
+
+use crate::BaseDocument;
+use crate::local_name;
+use crate::scrolling::ScrollTarget;
+use crate::util::Point;
+
+/// What a scroll that comes to rest meant to do, as CSS Scroll Snap 1's "Choosing Snap
+/// Positions" tells scrolls apart. It decides which snap positions the scroll may rest at, and
+/// which of them it takes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ScrollSnapIntent {
+    /// An intended end position: the snap position nearest to where the scroll ended, either
+    /// way. `scrollTo()`, Home and End, a scrollbar thumb let go.
+    EndPosition,
+    /// An end position that brings an element into view (`scrollIntoView()`, a fragment,
+    /// focus): as [`ScrollSnapIntent::EndPosition`], among the snap positions that keep the
+    /// element in the snapport, or as much of it as fits, where there are any.
+    IntoView(NodeId),
+    /// An intended direction and end position: a snap position past where the scroll began,
+    /// the nearest to where it ended. A line (an arrow key, a wheel's notch), `scrollBy()`, a
+    /// gesture that comes to rest.
+    Direction,
+    /// A page (Page Down, Space): as [`ScrollSnapIntent::Direction`], but at or short of where
+    /// it ended where it can be, so that it passes over no content.
+    Page,
+}
+
+/// Snap positions closer than this to a scroll's start, in CSS pixels, are where it began.
+const SLACK: f64 = 0.5;
+
+/// A snap area: its border box in the container's scrollport coordinates at scroll offset
+/// zero, (left, top, right, bottom); its alignment (block, inline); and `scroll-snap-stop`.
+struct SnapArea {
+    rect: [f64; 4],
+    align: (ScrollSnapAlignKeyword, ScrollSnapAlignKeyword),
+    always: bool,
+}
+
+/// The snap positions an area gives along one axis, from `lo` to `hi`: one where they are the
+/// same, every offset between where the area is longer than the snapport. And whether its
+/// `scroll-snap-stop` is `always`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Candidate {
+    lo: f64,
+    hi: f64,
+    always: bool,
+}
+
+impl Candidate {
+    #[cfg(test)]
+    fn at(at: f64) -> Self {
+        Candidate {
+            lo: at,
+            hi: at,
+            always: false,
+        }
+    }
+
+    /// Its position nearest to `at`.
+    fn nearest_to(&self, at: f64) -> f64 {
+        at.clamp(self.lo, self.hi)
+    }
+}
+
+/// One axis of a snap container, for choosing among its snap positions.
+struct Axis {
+    /// The scroll's start and end, and the container's scroll range: from a negative `min`
+    /// where its content overflows the other way (`direction: rtl`, a reversed flex box).
+    from: f64,
+    to: f64,
+    min: f64,
+    max: f64,
+    /// The scrollport's length, and the snapport's insets in it.
+    port: f64,
+    pad: (f64, f64),
+}
+
+impl Axis {
+    fn sign(&self) -> f64 {
+        match self.to - self.from {
+            d if d > 0.0 => 1.0,
+            d if d < 0.0 => -1.0,
+            _ => 0.0,
+        }
+    }
+
+    /// The snap positions that align `[start, end)` with the snapport as `align` says.
+    fn position(
+        &self,
+        align: ScrollSnapAlignKeyword,
+        start: f64,
+        end: f64,
+        always: bool,
+    ) -> Option<Candidate> {
+        let (p0, p1) = self.pad;
+        let at = match align {
+            ScrollSnapAlignKeyword::None => return None,
+            // Longer than the snapport: wherever it covers it.
+            _ if end - start > self.port - p0 - p1 => (start - p0, end - (self.port - p1)),
+            ScrollSnapAlignKeyword::Start => (start - p0, start - p0),
+            ScrollSnapAlignKeyword::End => (end - (self.port - p1), end - (self.port - p1)),
+            ScrollSnapAlignKeyword::Center => {
+                let at = (start + end) / 2.0 - (p0 + self.port - p1) / 2.0;
+                (at, at)
+            }
+        };
+        Some(Candidate {
+            lo: at.0.clamp(self.min, self.max),
+            hi: at.1.clamp(self.min, self.max),
+            always,
+        })
+    }
+
+    /// The part of `c` past where the scroll began, the scroll's way.
+    fn ahead(&self, c: &Candidate) -> Option<Candidate> {
+        let c = match self.sign() {
+            s if s > 0.0 => Candidate {
+                lo: c.lo.max(self.from + SLACK),
+                ..*c
+            },
+            s if s < 0.0 => Candidate {
+                hi: c.hi.min(self.from - SLACK),
+                ..*c
+            },
+            _ => return None,
+        };
+        (c.lo <= c.hi).then_some(c)
+    }
+
+    /// The farthest position of `c`, the scroll's way, at or short of where it ended.
+    fn short(&self, c: &Candidate) -> Option<f64> {
+        if self.sign() > 0.0 {
+            (c.lo <= self.to + SLACK).then(|| c.hi.min(self.to).max(c.lo))
+        } else {
+            (c.hi >= self.to - SLACK).then(|| c.lo.max(self.to).min(c.hi))
+        }
+    }
+
+    /// The first position of `c` the scroll's way.
+    fn entry(&self, c: &Candidate) -> f64 {
+        if self.sign() > 0.0 { c.lo } else { c.hi }
+    }
+
+    /// Of the positions `cands` give, the one nearest to the scroll's end. On a tie, the one
+    /// farther the scroll's way.
+    fn nearest<'a>(&self, cands: impl Iterator<Item = &'a Candidate>) -> Option<f64> {
+        let sign = self.sign();
+        cands.map(|c| c.nearest_to(self.to)).min_by(|a, b| {
+            let (da, db) = ((a - self.to).abs(), (b - self.to).abs());
+            da.total_cmp(&db).then((b * sign).total_cmp(&(a * sign)))
+        })
+    }
+
+    /// The snap position the scroll rests at along this axis, if any qualifies. `keep` is the
+    /// extent of the element an [`ScrollSnapIntent::IntoView`] brings into view.
+    fn choose(
+        &self,
+        cands: &[Candidate],
+        intent: ScrollSnapIntent,
+        keep: Option<(f64, f64)>,
+    ) -> Option<f64> {
+        let sign = self.sign();
+        let ahead: Vec<Candidate> = cands.iter().filter_map(|c| self.ahead(c)).collect();
+        let chosen = match intent {
+            ScrollSnapIntent::EndPosition => self.nearest(cands.iter()),
+            ScrollSnapIntent::IntoView(_) => {
+                let shown = keep.and_then(|(e0, e1)| {
+                    let (p0, p1) = self.pad;
+                    let need = (e1 - e0).min(self.port - p0 - p1) - SLACK;
+                    let shows = |c: &&Candidate| {
+                        let at = c.nearest_to(self.to);
+                        e1.min(at + self.port - p1) - e0.max(at + p0) >= need
+                    };
+                    self.nearest(cands.iter().filter(shows))
+                });
+                shown.or_else(|| self.nearest(cands.iter()))
+            }
+            _ if sign == 0.0 => None,
+            ScrollSnapIntent::Direction => self.nearest(ahead.iter()),
+            // The farthest that passes over nothing, or else the first past the end.
+            ScrollSnapIntent::Page => ahead
+                .iter()
+                .filter_map(|c| self.short(c))
+                .max_by(|a, b| (a * sign).total_cmp(&(b * sign)))
+                .or_else(|| self.nearest(ahead.iter())),
+        }?;
+        // A scroll with a direction passes over no area whose `scroll-snap-stop` is `always`.
+        let stop = match intent {
+            ScrollSnapIntent::Direction | ScrollSnapIntent::Page => ahead
+                .iter()
+                .filter(|c| c.always)
+                .map(|c| self.entry(c))
+                .filter(|at| (at - chosen) * sign < -SLACK)
+                .min_by(|a, b| (a * sign).total_cmp(&(b * sign))),
+            _ => None,
+        };
+        Some(stop.unwrap_or(chosen))
+    }
+}
+
+/// `scroll-padding` along one side, against the scrollport's length along its axis. `auto` is
+/// zero, as browsers have it.
+fn resolve_padding(value: &NonNegativeLengthPercentageOrAuto, basis: f64) -> f64 {
+    match value {
+        GenericLengthPercentageOrAuto::LengthPercentage(lp) => {
+            lp.0.resolve(CSSPixelLength::new(basis as f32)).px() as f64
+        }
+        GenericLengthPercentageOrAuto::Auto => 0.0,
+    }
+}
+
+/// Whether a box with these styles is a scroll container (CSS Overflow 3): it clips its
+/// overflow and can be scrolled, along either axis.
+fn clips_to_scroll(styles: &ComputedValues) -> bool {
+    let scrolls = |o| matches!(o, Overflow::Hidden | Overflow::Auto | Overflow::Scroll);
+    scrolls(styles.clone_overflow_x()) || scrolls(styles.clone_overflow_y())
+}
+
+impl BaseDocument {
+    /// Where a scroll of `node_id` (the root element for the viewport) that went from offset
+    /// `from` to offset `to` comes to rest, as its snap container's CSS Scroll Snap properties
+    /// and the scroll's `intent` choose: a snap position along each axis that snaps and where
+    /// one qualifies, and `to` along the others. `to` itself where the container does not snap.
+    pub fn scroll_snap_position(
+        &self,
+        node_id: NodeId,
+        from: Point<f64>,
+        to: Point<f64>,
+        intent: ScrollSnapIntent,
+    ) -> Point<f64> {
+        let target = self.canonical_scroll_target(ScrollTarget::Node(node_id));
+        self.snap_position(target, from, to, intent)
+    }
+
+    pub(crate) fn snap_position(
+        &self,
+        target: ScrollTarget,
+        from: Point<f64>,
+        to: Point<f64>,
+        intent: ScrollSnapIntent,
+    ) -> Point<f64> {
+        let container = match target {
+            ScrollTarget::Viewport => self.try_root_element().map(|n| n.id),
+            ScrollTarget::Node(id) => Some(id),
+        };
+        let Some(container) = container else {
+            return to;
+        };
+        let Some(styles) = self.nodes.get(container).and_then(|n| n.primary_styles()) else {
+            return to;
+        };
+        // The viewport's comes from the root element, not propagated from the body.
+        let snap_type = *styles.get_scroll_snap_type();
+        let (snap_x, snap_y) = match (snap_type.strictness, snap_type.axis) {
+            (ScrollSnapStrictness::None, _) => return to,
+            (_, ScrollSnapAxis::X | ScrollSnapAxis::Inline) => (true, false),
+            (_, ScrollSnapAxis::Y | ScrollSnapAxis::Block) => (false, true),
+            (_, ScrollSnapAxis::Both) => (true, true),
+        };
+        let proximity = snap_type.strictness == ScrollSnapStrictness::Proximity;
+        let (_, min, max) = self.scroll_state(target, true);
+        // A scroll with a direction snaps only the axes it moved along.
+        let directed = matches!(intent, ScrollSnapIntent::Direction | ScrollSnapIntent::Page);
+        let snap_x = snap_x && max.x > min.x && !(directed && from.x == to.x);
+        let snap_y = snap_y && max.y > min.y && !(directed && from.y == to.y);
+        if !(snap_x || snap_y) {
+            return to;
+        }
+
+        let (port_w, port_h) = self.scrollport_size(target);
+        let padding = styles.get_padding();
+        let axis_x = Axis {
+            from: from.x,
+            to: to.x,
+            min: min.x,
+            max: max.x,
+            port: port_w,
+            pad: (
+                resolve_padding(&padding.scroll_padding_left, port_w),
+                resolve_padding(&padding.scroll_padding_right, port_w),
+            ),
+        };
+        let axis_y = Axis {
+            from: from.y,
+            to: to.y,
+            min: min.y,
+            max: max.y,
+            port: port_h,
+            pad: (
+                resolve_padding(&padding.scroll_padding_top, port_h),
+                resolve_padding(&padding.scroll_padding_bottom, port_h),
+            ),
+        };
+        drop(styles);
+
+        let areas = self.snap_areas(target, container);
+        let keep = match intent {
+            ScrollSnapIntent::IntoView(id) => self.rect_in_scrollport(id, target, true),
+            _ => None,
+        };
+        let mut out = to;
+        for (snaps, axis, along_y) in [(snap_x, &axis_x, false), (snap_y, &axis_y, true)] {
+            if !snaps {
+                continue;
+            }
+            let cands: Vec<Candidate> = areas
+                .iter()
+                .filter_map(|a| {
+                    let [x0, y0, x1, y1] = a.rect;
+                    match along_y {
+                        true => axis.position(a.align.0, y0, y1, a.always),
+                        false => axis.position(a.align.1, x0, x1, a.always),
+                    }
+                })
+                .collect();
+            let keep = keep.map(|[x0, y0, x1, y1]| if along_y { (y0, y1) } else { (x0, x1) });
+            let Some(at) = axis.choose(&cands, intent, keep) else {
+                continue;
+            };
+            let (p0, p1) = axis.pad;
+            if proximity && (at - axis.to).abs() > (axis.port - p0 - p1).max(0.0) / 3.0 {
+                continue;
+            }
+            match along_y {
+                true => out.y = at,
+                false => out.x = at,
+            }
+        }
+        out
+    }
+
+    /// The size of a scroll target's scrollport, in CSS pixels: the window for the viewport,
+    /// and an element's padding box less its scrollbars.
+    fn scrollport_size(&self, target: ScrollTarget) -> (f64, f64) {
+        match target {
+            ScrollTarget::Viewport => {
+                let scale = self.viewport.scale() as f64;
+                (
+                    self.viewport.window_size.0 as f64 / scale,
+                    self.viewport.window_size.1 as f64 / scale,
+                )
+            }
+            ScrollTarget::Node(id) => self.nodes.get(id).map_or((0.0, 0.0), |n| {
+                (
+                    n.client_width().max(0.0) as f64,
+                    n.client_height().max(0.0) as f64,
+                )
+            }),
+        }
+    }
+
+    /// Whether `id` is a scroll container that holds its own snap areas: an element that clips
+    /// its overflow, but not the root (whose overflow is the viewport's) nor a body whose
+    /// overflow the viewport takes.
+    fn is_inner_scroll_container(&self, id: NodeId) -> bool {
+        let Some(node) = self.nodes.get(id) else {
+            return false;
+        };
+        let Some(styles) = node.primary_styles() else {
+            return false;
+        };
+        if !clips_to_scroll(&styles) {
+            return false;
+        }
+        let Some(root) = self.try_root_element() else {
+            return true;
+        };
+        if root.id == id {
+            return false;
+        }
+        let is_body = node.parent == Some(root.id)
+            && node.data.is_element_with_tag_name(&local_name!("body"));
+        let root_visible = root.primary_styles().is_some_and(|s| !clips_to_scroll(&s));
+        !(is_body && root_visible)
+    }
+
+    /// The border box of `id` in the scrollport coordinates of `target` (its content at
+    /// scroll offset zero), following its containing blocks up to it: none where they do not
+    /// lead there, pass through a fixed-position box, or, unless `through_scrollers`, pass
+    /// through another scroll container.
+    fn rect_in_scrollport(
+        &self,
+        id: NodeId,
+        target: ScrollTarget,
+        through_scrollers: bool,
+    ) -> Option<[f64; 4]> {
+        let node = self.nodes.get(id)?;
+        let fixed = |n: &crate::Node| {
+            n.primary_styles()
+                .is_some_and(|s| s.get_box().position == Position::Fixed)
+        };
+        if fixed(node) {
+            return None;
+        }
+        let l = node.final_layout();
+        let (w, h) = (l.size.width as f64, l.size.height as f64);
+        let (mut x, mut y) = (l.location.x as f64, l.location.y as f64);
+        let mut cb = node.containing_block();
+        for _ in 0..4096 {
+            match (cb, target) {
+                (Some(c), ScrollTarget::Node(t)) if c == t => {
+                    let b = self.nodes.get(t)?.final_layout().border;
+                    let (x, y) = (x - b.left as f64, y - b.top as f64);
+                    return Some([x, y, x + w, y + h]);
+                }
+                (None, ScrollTarget::Viewport) => return Some([x, y, x + w, y + h]),
+                (None, _) => return None,
+                (Some(c), _) => {
+                    let n = self.nodes.get(c)?;
+                    if fixed(n) || (!through_scrollers && self.is_inner_scroll_container(c)) {
+                        return None;
+                    }
+                    let l = n.final_layout();
+                    x += l.location.x as f64 - n.scroll_offset().x;
+                    y += l.location.y as f64 - n.scroll_offset().y;
+                    cb = n.containing_block();
+                }
+            }
+        }
+        None
+    }
+
+    /// The snap areas of the snap container `container`, which scrolls as `target`: the
+    /// elements under it, not under a scroll container inside it, whose `scroll-snap-align` is
+    /// not `none` and that are laid out.
+    fn snap_areas(&self, target: ScrollTarget, container: NodeId) -> Vec<SnapArea> {
+        let mut areas = Vec::new();
+        let Some(node) = self.nodes.get(container) else {
+            return areas;
+        };
+        let mut stack: Vec<NodeId> = node.children.iter().rev().copied().collect();
+        while let Some(id) = stack.pop() {
+            let Some(node) = self.nodes.get(id) else {
+                continue;
+            };
+            if !node.is_element() {
+                continue;
+            }
+            // An element under `display: none` has no styles.
+            let Some(styles) = node.primary_styles() else {
+                continue;
+            };
+            let display = styles.clone_display();
+            if display.is_none() {
+                continue;
+            }
+            let align = *styles.get_scroll_snap_align();
+            let always = *styles.get_scroll_snap_stop() == ScrollSnapStop::Always;
+            drop(styles);
+            let aligned = align.block != ScrollSnapAlignKeyword::None
+                || align.inline != ScrollSnapAlignKeyword::None;
+            if aligned && !display.is_contents() {
+                if let Some(rect) = self.rect_in_scrollport(id, target, false) {
+                    areas.push(SnapArea {
+                        rect,
+                        align: (align.block, align.inline),
+                        always,
+                    });
+                }
+            }
+            if !self.is_inner_scroll_container(id) {
+                stack.extend(node.children.iter().rev().copied());
+            }
+        }
+        areas
+    }
+}
