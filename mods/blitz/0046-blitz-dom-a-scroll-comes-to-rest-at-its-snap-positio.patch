+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn axis(from: f64, to: f64) -> Axis {
+        Axis {
+            from,
+            to,
+            min: 0.0,
+            max: 1000.0,
+            port: 610.0,
+            pad: (0.0, 0.0),
+        }
+    }
+
+    /// Rows of 20 px from 0 to 1000, aligned at their starts.
+    fn rows() -> Vec<Candidate> {
+        (0..=50).map(|i| Candidate::at(i as f64 * 20.0)).collect()
+    }
+
+    fn choose(from: f64, to: f64, c: &[Candidate], intent: ScrollSnapIntent) -> Option<f64> {
+        axis(from, to).choose(c, intent, None)
+    }
+
+    #[test]
+    fn a_line_rests_past_its_start_nearest_its_end() {
+        let c = rows();
+        // 40 px down: two rows. 15 px: one, the nearest ahead.
+        assert_eq!(
+            choose(0.0, 40.0, &c, ScrollSnapIntent::Direction),
+            Some(40.0)
+        );
+        assert_eq!(
+            choose(0.0, 15.0, &c, ScrollSnapIntent::Direction),
+            Some(20.0)
+        );
+        // Never back where it began, nor behind it.
+        assert_eq!(
+            choose(0.0, 3.0, &c, ScrollSnapIntent::Direction),
+            Some(20.0)
+        );
+        assert_eq!(
+            choose(100.0, 97.0, &c, ScrollSnapIntent::Direction),
+            Some(80.0)
+        );
+        // Nothing ahead: no snap.
+        assert_eq!(
+            choose(1000.0, 1000.0, &c, ScrollSnapIntent::Direction),
+            None
+        );
+        let one = [Candidate::at(0.0)];
+        assert_eq!(choose(0.0, 40.0, &one, ScrollSnapIntent::Direction), None);
+    }
+
+    #[test]
+    fn a_page_passes_over_nothing() {
+        // 7/8 of 610 px: the row at or short of 533.75.
+        let c = rows();
+        assert_eq!(choose(0.0, 533.75, &c, ScrollSnapIntent::Page), Some(520.0));
+        assert_eq!(choose(520.0, -13.75, &c, ScrollSnapIntent::Page), Some(0.0));
+        // Areas further apart than a page: the first past its end.
+        let far = [0.0, 800.0].map(Candidate::at);
+        assert_eq!(
+            choose(0.0, 533.75, &far, ScrollSnapIntent::Page),
+            Some(800.0)
+        );
+    }
+
+    #[test]
+    fn an_end_position_takes_the_nearest_either_way() {
+        let c = rows();
+        assert_eq!(
+            choose(0.0, 533.75, &c, ScrollSnapIntent::EndPosition),
+            Some(540.0)
+        );
+        assert_eq!(
+            choose(600.0, 9.0, &c, ScrollSnapIntent::EndPosition),
+            Some(0.0)
+        );
+        // A tie goes the scroll's way.
+        assert_eq!(
+            choose(0.0, 10.0, &c, ScrollSnapIntent::EndPosition),
+            Some(20.0)
+        );
+        assert_eq!(
+            choose(40.0, 30.0, &c, ScrollSnapIntent::EndPosition),
+            Some(20.0)
+        );
+    }
+
+    #[test]
+    fn into_view_keeps_the_element_in_the_snapport() {
+        // Row 30 (600 to 620) brought into view at the bottom of 610 px: 10 px, between rows
+        // 0 and 1, and only 20 shows all of it.
+        let c = rows();
+        let keep = Some((600.0, 620.0));
+        let intent = ScrollSnapIntent::IntoView(NodeId::from_u64(0));
+        assert_eq!(axis(0.0, 10.0).choose(&c, intent, keep), Some(20.0));
+        assert_eq!(axis(40.0, 10.0).choose(&c, intent, keep), Some(20.0));
+    }
+
+    #[test]
+    fn a_scroll_stops_at_an_area_that_says_always() {
+        let mut c = rows();
+        c[5].always = true;
+        assert_eq!(choose(0.0, 533.75, &c, ScrollSnapIntent::Page), Some(100.0));
+        // Not one it began at, nor one behind it.
+        assert_eq!(
+            choose(100.0, 633.75, &c, ScrollSnapIntent::Page),
+            Some(620.0)
+        );
+        assert_eq!(
+            choose(400.0, -133.75, &c, ScrollSnapIntent::Page),
+            Some(100.0)
+        );
+        // An end position may pass over it.
+        assert_eq!(
+            choose(0.0, 533.75, &c, ScrollSnapIntent::EndPosition),
+            Some(540.0)
+        );
+    }
+
+    #[test]
+    fn an_area_longer_than_the_snapport_snaps_wherever_it_covers_it() {
+        // Sections of 1000 px in a 610 px port: within one, any offset that keeps it over the
+        // whole port; past its end, the next.
+        let a = Axis {
+            max: 1390.0,
+            ..axis(0.0, 0.0)
+        };
+        let c: Vec<Candidate> = [0.0, 1000.0]
+            .iter()
+            .filter_map(|&s| a.position(ScrollSnapAlignKeyword::Start, s, s + 1000.0, false))
+            .collect();
+        assert_eq!(
+            c[0],
+            Candidate {
+                lo: 0.0,
+                hi: 390.0,
+                always: false
+            }
+        );
+        assert_eq!(
+            c[1],
+            Candidate {
+                lo: 1000.0,
+                hi: 1390.0,
+                always: false
+            }
+        );
+        let at = |from, to, intent| Axis { from, to, ..a }.choose(&c, intent, None);
+        assert_eq!(at(0.0, 40.0, ScrollSnapIntent::Direction), Some(40.0));
+        assert_eq!(at(0.0, 533.75, ScrollSnapIntent::Page), Some(390.0));
+        assert_eq!(at(390.0, 923.75, ScrollSnapIntent::Page), Some(1000.0));
+        assert_eq!(
+            at(1100.0, 1060.0, ScrollSnapIntent::Direction),
+            Some(1060.0)
+        );
+        assert_eq!(at(1000.0, 960.0, ScrollSnapIntent::Direction), Some(390.0));
+        assert_eq!(at(0.0, 600.0, ScrollSnapIntent::EndPosition), Some(390.0));
+    }
+
+    #[test]
+    fn alignment_and_padding_place_the_snap_position() {
+        let a = Axis {
+            from: 0.0,
+            to: 0.0,
+            min: 0.0,
+            max: 1000.0,
+            port: 100.0,
+            pad: (10.0, 20.0),
+        };
+        // An area from 200 to 240 in a 100 px port with a 70 px snapport from 10.
+        let at = |align, s, e| a.position(align, s, e, false).map(|c| (c.lo, c.hi));
+        assert_eq!(
+            at(ScrollSnapAlignKeyword::Start, 200.0, 240.0),
+            Some((190.0, 190.0))
+        );
+        assert_eq!(
+            at(ScrollSnapAlignKeyword::End, 200.0, 240.0),
+            Some((160.0, 160.0))
+        );
+        assert_eq!(
+            at(ScrollSnapAlignKeyword::Center, 200.0, 240.0),
+            Some((175.0, 175.0))
+        );
+        assert_eq!(
+            at(ScrollSnapAlignKeyword::Start, 5.0, 25.0),
+            Some((0.0, 0.0))
+        );
+        assert_eq!(at(ScrollSnapAlignKeyword::None, 5.0, 25.0), None);
+    }
+
+    #[test]
+    fn a_reversed_scroller_snaps_in_its_negative_range() {
+        // A `column-reverse` box whose content overflows upwards: offsets from -1000 to 0,
+        // rows of 20 px above its start.
+        let a = Axis {
+            min: -1000.0,
+            max: 0.0,
+            ..axis(0.0, 0.0)
+        };
+        let c: Vec<Candidate> = (0..=50)
+            .filter_map(|i| {
+                let s = -1000.0 + i as f64 * 20.0;
+                a.position(ScrollSnapAlignKeyword::Start, s, s + 20.0, false)
+            })
+            .collect();
+        let at = |from, to, intent| Axis { from, to, ..a }.choose(&c, intent, None);
+        assert_eq!(at(0.0, -40.0, ScrollSnapIntent::Direction), Some(-40.0));
+        assert_eq!(at(0.0, -533.75, ScrollSnapIntent::Page), Some(-520.0));
+        assert_eq!(at(-520.0, -9.0, ScrollSnapIntent::EndPosition), Some(0.0));
+        // A row whose start is past the range's end comes to rest at the end.
+        let past = a.position(ScrollSnapAlignKeyword::Start, -1100.0, -1080.0, false);
+        assert_eq!(past.map(|c| c.lo), Some(-1000.0));
+    }
+}
