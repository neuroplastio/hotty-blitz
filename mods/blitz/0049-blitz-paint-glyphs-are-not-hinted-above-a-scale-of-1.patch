From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Tue, 3 Nov 2026 17:53:13 +0100
Subject: [PATCH 49/54] blitz-paint: glyphs are not hinted above a scale of 1

blitz-paint asks for vertical hinting wherever it does not embolden, so
on Linux and Windows glyphs are hinted at any scale. Hinting snaps a
glyph's heights to whole device pixels: at 1x that keeps small text
crisp, but at a denser scale it costs more of the glyph's shape than it
buys, and with fonts whose own instructions round the x-height down, such
as IBM Plex Sans, small text drawn at 1.5x to 2x comes out a row shorter
and lighter than a browser draws it.

Hint only at a scale of 1 or less, as before there.
---
 packages/blitz-paint/src/text.rs | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-paint/src/text.rs b/packages/blitz-paint/src/text.rs
index fdd58bcd1..16260081d 100644
--- a/packages/blitz-paint/src/text.rs
+++ b/packages/blitz-paint/src/text.rs
@@ -14,6 +14,14 @@ use style::values::generics::text::{GenericTextDecorationInset, GenericTextDecor
 use crate::FONT_EMBOLDEN_ENABLED;
 use crate::color::{Color, ToColorColor as _};
 
+/// Whether glyphs drawn at `scale` device pixels per CSS pixel are hinted.
+/// Hinting snaps a glyph's heights to whole pixels, which at small sizes on
+/// a 1x display is what keeps text crisp; on a denser display the rounding
+/// costs more of a glyph's shape than it buys, and browsers leave it off.
+fn hint_glyphs(scale: f64) -> bool {
+    !FONT_EMBOLDEN_ENABLED && scale <= 1.0
+}
+
 /// Draw the backgrounds of inline elements (e.g. `<span style="background: ...">`).
 ///
 /// Each glyph run carries the node id of the innermost inline element it belongs to
@@ -765,7 +773,7 @@ pub(crate) fn stroke_text<'a>(
                     scene.draw_glyphs(
                         font,
                         font_size,
-                        !FONT_EMBOLDEN_ENABLED, // hint
+                        hint_glyphs(scale),
                         normalized_coords,
                         embolden,
                         Fill::NonZero,
@@ -875,7 +883,7 @@ pub(crate) fn fill_text<'a>(
             scene.draw_glyphs(
                 run.font(),
                 font_size,
-                !FONT_EMBOLDEN_ENABLED, // hint
+                hint_glyphs(scale),
                 normalized_coords,
                 embolden,
                 Fill::NonZero,
