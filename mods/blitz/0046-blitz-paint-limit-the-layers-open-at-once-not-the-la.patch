From f0b7e573607ea223953f475734399624a033394e Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Fri, 30 Oct 2026 10:51:07 +0100
Subject: [PATCH] blitz-paint: limit the layers open at once, not the layers
 painted

LayerManager counted every layer it pushed in a paint against
LAYER_LIMIT, and never took one off when it was popped. A document with
more than 1,024 clipped elements, side by side rather than nested, lost
the clips of every element after the 1,024th: their content painted
past their boxes.

Check the layers open at once, layer_depth, instead. The limit still
bounds nesting, which is what a renderer's layer stack holds.
---
 packages/blitz-paint/src/layers.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-paint/src/layers.rs b/packages/blitz-paint/src/layers.rs
index 65e480f9..f169e299 100644
--- a/packages/blitz-paint/src/layers.rs
+++ b/packages/blitz-paint/src/layers.rs
@@ -3,6 +3,8 @@ use kurbo::{Affine, Shape};
 use peniko::Mix;
 use std::{cell::Cell, sync::Arc};
 
+/// The most layers open at once: a document with more clipped elements than
+/// this side by side still clips them all.
 const LAYER_LIMIT: u32 = 1024;
 
 #[derive(Default)]
@@ -57,8 +59,8 @@ impl LayerManager {
         }
         self.layers_wanted.update(|x| x + 1);
 
-        // Check if clips are above limit
-        let layers_available = self.layers_used.get() <= LAYER_LIMIT;
+        // Check if open layers are above limit
+        let layers_available = self.layer_depth.get() < LAYER_LIMIT;
         if !layers_available {
             return false;
         }
