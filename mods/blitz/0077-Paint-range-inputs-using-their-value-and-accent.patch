+    /// Live value of an `<input type=range>`, when the
+    /// special data has been initialized (layout construct pass).
+    pub fn range_input_value(&self) -> Option<f64> {
+        match self.special_data {
+            SpecialElementData::RangeInput(value) => Some(value),
+            _ => None,
+        }
+    }
+
+    /// Refresh a slider from its HTML attributes after a host delta.
+    pub(crate) fn reset_range_input(&mut self) -> bool {
+        if !matches!(self.special_data, SpecialElementData::RangeInput(_)) {
+            return false;
+        }
+        let parse = |name| {
+            self.attr(name)
+                .and_then(|v| v.parse::<f64>().ok())
+                .filter(|n| n.is_finite())
+        };
+        let min = parse(local_name!("min")).unwrap_or(0.0);
+        let max = parse(local_name!("max")).unwrap_or(100.0).max(min);
+        let value = parse(local_name!("value"))
+            .unwrap_or(min / 2.0 + max / 2.0)
+            .clamp(min, max);
+        self.special_data = SpecialElementData::RangeInput(value);
+        true
+    }
