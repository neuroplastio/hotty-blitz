+/// Draw the track and thumb of a horizontal range control.
+fn draw_range_slider(
+    scene: &mut impl PaintScene,
+    fraction: f64,
+    frame: Rect,
+    transform: Affine,
+    accent: Color,
+    scale: f64,
+) {
+    let (width, height) = (frame.width(), frame.height());
+    if width <= 0.0 || height <= 0.0 {
+        return;
+    }
+    let cy = frame.y0 + height / 2.0;
+    let radius = (height * 0.5).min(width * 0.25).max(2.0 * scale) * 0.8;
+    let track_h = (height * 0.25).clamp(2.0 * scale, 6.0 * scale);
+    let thumb_x = frame.x0 + radius + (width - 2.0 * radius).max(0.0) * fraction;
+    let track = RoundedRect::new(
+        frame.x0,
+        cy - track_h / 2.0,
+        frame.x1,
+        cy + track_h / 2.0,
+        track_h / 2.0,
+    );
+    let filled = RoundedRect::new(
+        frame.x0,
+        cy - track_h / 2.0,
+        thumb_x,
+        cy + track_h / 2.0,
+        track_h / 2.0,
+    );
+    scene.fill(
+        Fill::NonZero,
+        transform,
+        Color::from_rgb8(222, 226, 230),
+        None,
+        &track,
+    );
+    scene.fill(Fill::NonZero, transform, accent, None, &filled);
+    scene.fill(
+        Fill::NonZero,
+        transform,
+        accent,
+        None,
+        &Circle::new(Point::new(thumb_x, cy), radius),
+    );
+}
