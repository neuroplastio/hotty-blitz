From 682d720828b0c48bdf9a2a7b49f47988e0f7eefd Mon Sep 17 00:00:00 2001
From: hotty Agent <hotty@neuroplast.io>
Date: Tue, 10 Nov 2026 14:07:27 +0100
Subject: [PATCH] blitz-dom: a textarea sized to its text does not follow its
 caret when it is laid out

Laying out a textarea with field-sizing: content clamped its scroll offset
with clamp_scroll_offset, which also scrolls the caret into view: an
unfocused textarea whose caret sat at the end of its text showed the end,
where a browser shows the top. Layout now only takes the offset back to
the most the new height allows.
---
 packages/blitz-dom/src/layout/mod.rs | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-dom/src/layout/mod.rs b/packages/blitz-dom/src/layout/mod.rs
index 8de6fe6c3..6951bc3dd 100644
--- a/packages/blitz-dom/src/layout/mod.rs
+++ b/packages/blitz-dom/src/layout/mod.rs
@@ -396,10 +396,13 @@ impl LayoutPassState<'_> {
                             );
                             if content_sized {
                                 // The box moved with the text: an offset kept
-                                // for the old height may leave a gap now.
+                                // for the old height may leave a gap now. Only
+                                // the gap goes: the caret is not followed here,
+                                // so an unfocused textarea stays at the top.
                                 let content_height =
                                     (output.size.height - pb.vertical_axis_sum()).max(0.0);
-                                input.clamp_scroll_offset(content_width, content_height);
+                                let max = input.max_scroll_offset(content_width, content_height);
+                                input.scroll_offset = input.scroll_offset.min(max);
                             }
                             if let Some(placeholder) = &mut input.placeholder {
                                 placeholder.editor.set_width(Some(content_width * scale));
-- 
