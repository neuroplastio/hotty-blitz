-    /// field, or one not laid out.
+    /// taller line) lays the field out again. For a multi-line field, only
+    /// one that [`sizes_to_text`](Self::sizes_to_text): the height of all
+    /// its lines. `None` for any other, or one not laid out.
     pub fn line_metrics(&self) -> Option<(f32, f32)> {
-        if self.is_multiline {
