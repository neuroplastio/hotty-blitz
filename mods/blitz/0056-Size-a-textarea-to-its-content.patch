 }
 
 /// A text field's `placeholder`, laid out in the field's `::placeholder`
@@ -164,6 +168,7 @@ impl TextInputData {
             content_box_subpixel_offset: taffy::Point::ZERO,
             password: None,
             placeholder: None,
+            sizes_to_text: false,
         }
     }
 
@@ -253,10 +258,11 @@ impl TextInputData {
     /// The height of a single-line field's text and the baseline of its
