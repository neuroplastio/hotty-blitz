+    /// SVGs that use a sprite containing `changed`; include targets below
+    /// `changed` when that whole subtree is about to be removed or replaced.
+    #[cfg(feature = "svg")]
+    pub fn external_svg_dependents(
+        &self,
+        changed: NodeId,
+        include_descendants: bool,
+    ) -> Vec<NodeId> {
+        let is_under = |mut node: NodeId, ancestor: NodeId| loop {
+            if node == ancestor {
+                return true;
+            }
+            let Some(parent) = self.nodes.get(node).and_then(|n| n.parent) else {
+                return false;
+            };
+            node = parent;
+        };
+        self.external_svg_targets
+            .iter()
+            .filter_map(|(&consumer, targets)| {
+                self.nodes
+                    .get(consumer)
+                    .filter(|n| n.flags.is_in_document())?;
+                targets
+                    .values()
+                    .flatten()
+                    .any(|&target| {
+                        is_under(changed, target)
+                            || (include_descendants && is_under(target, changed))
+                    })
+                    .then_some(consumer)
+            })
+            .collect()
+    }
+
+    /// SVGs whose referenced IDs now resolve to different nodes.
+    #[cfg(feature = "svg")]
+    pub fn external_svg_changed_bindings(&self) -> Vec<NodeId> {
+        self.external_svg_targets
+            .iter()
+            .filter_map(|(&consumer, targets)| {
+                self.nodes
+                    .get(consumer)
+                    .filter(|n| n.flags.is_in_document())?;
+                targets
+                    .iter()
+                    .any(|(id, old)| self.get_element_by_id(id) != *old)
+                    .then_some(consumer)
+            })
+            .collect()
+    }
+
+    /// Reconstruct an inline SVG whose external sprite changed.
+    #[cfg(feature = "svg")]
+    pub fn invalidate_external_svg(&mut self, consumer: NodeId) {
+        if let Some(node) = self.nodes.get_mut(consumer) {
+            node.insert_damage(ALL_DAMAGE);
+        }
+    }
+
     pub fn create_node(&mut self, node_data: NodeData) -> NodeId {
         let tree_ptr = self.nodes.as_mut() as *mut NodeTree;
         let guard = self.guard.clone();
@@ -1047,6 +1112,8 @@ impl BaseDocument {
