 pub(crate) struct ConstructionTask {
     pub(crate) node_id: NodeId,
@@ -456,7 +561,13 @@ fn collect_layout_children_with_wrap(
 
         #[cfg(feature = "svg")]
         if matches!(tag_name, "svg") {
-            let outer_html = doc.get_node(container_node_id).unwrap().svg_source();
+            let mut outer_html = doc.get_node(container_node_id).unwrap().svg_source();
+            let targets = inline_external_fragment_refs(doc, &mut outer_html);
+            if targets.is_empty() {
+                doc.external_svg_targets.remove(&container_node_id);
+            } else {
+                doc.external_svg_targets.insert(container_node_id, targets);
+            }
 
             // Remove contruction damage from subtree
             doc.iter_subtree_mut(container_node_id, |id: NodeId, doc: &mut BaseDocument| {
