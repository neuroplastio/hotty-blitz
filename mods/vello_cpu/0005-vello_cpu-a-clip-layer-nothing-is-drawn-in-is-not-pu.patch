+    /// Clip layers pushed and not drawn into yet, the first `pending_clips`
+    /// of these. Each goes to the dispatcher just before the first draw
+    /// inside it, and one popped before any is dropped: a clip layer with
+    /// nothing in it changes no pixel, and pushing one costs the clip
+    /// path's strips. The paths' buffers are kept between pushes.
+    pending: Vec<PendingClip>,
+    pending_clips: usize,
+}
+
+/// A clip layer not given to the dispatcher yet, as `push_layer` would give
+/// it.
+#[derive(Debug)]
+struct PendingClip {
+    path: BezPath,
+    fill_rule: Fill,
+    transform: Affine,
+    aliasing_threshold: Option<u8>,
 }
 
 /// Settings to apply to the render context.
@@ -259,6 +276,8 @@ impl RenderContext {
             temp_path,
             encoded_paints,
             filter: None,
+            pending: Vec::new(),
+            pending_clips: 0,
         }
     }
 
