+    /// The contexts the lazy clip layer tests run on: one drawing on the
+    /// calling thread and, with workers, one with two.
+    fn clip_test_contexts() -> vec::Vec<RenderContext> {
+        use crate::RenderSettings;
+
+        let mut contexts = vec![RenderContext::new_with(
+            16,
+            16,
+            RenderSettings {
+                num_threads: 0,
+                ..Default::default()
+            },
+        )];
+        #[cfg(feature = "multithreading")]
+        contexts.push(RenderContext::new_with(
+            16,
+            16,
+            RenderSettings {
+                num_threads: 2,
+                ..Default::default()
+            },
+        ));
+        contexts
+    }
+
+    #[test]
+    fn clip_layer_reaches_the_dispatcher_with_its_first_draw() {
+        use vello_common::kurbo::BezPath;
+
+        for mut ctx in clip_test_contexts() {
+            ctx.push_clip_layer(&Rect::new(0.0, 0.0, 8.0, 16.0).to_path(0.1));
+            ctx.push_clip_layer(&Rect::new(0.0, 0.0, 16.0, 8.0).to_path(0.1));
+            ctx.fill_path(&BezPath::new());
+            assert!(!ctx.dispatcher.has_layers(), "an empty path draws nothing");
+            ctx.pop_layer();
+            assert!(!ctx.dispatcher.has_layers());
+            ctx.set_paint(RED);
+            ctx.fill_rect(&Rect::new(0.0, 0.0, 16.0, 16.0));
+            assert!(ctx.dispatcher.has_layers());
+            ctx.pop_layer();
+            assert!(!ctx.dispatcher.has_layers());
+            ctx.flush();
+        }
+    }
+
+    #[test]
+    fn lazy_clip_layers_clip_what_is_drawn_in_them() {
+        for mut ctx in clip_test_contexts() {
+            // An empty clip layer inside one that is drawn into, and one
+            // nothing is drawn into after it.
+            ctx.push_clip_layer(&Rect::new(0.0, 0.0, 8.0, 16.0).to_path(0.1));
+            ctx.push_clip_layer(&Rect::new(0.0, 0.0, 16.0, 4.0).to_path(0.1));
+            ctx.pop_layer();
+            ctx.set_paint(RED);
+            ctx.fill_rect(&Rect::new(0.0, 0.0, 16.0, 16.0));
+            ctx.pop_layer();
+            ctx.push_clip_layer(&Rect::new(0.0, 0.0, 4.0, 4.0).to_path(0.1));
+            ctx.pop_layer();
+            ctx.set_paint(BLUE);
+            ctx.fill_rect(&Rect::new(12.0, 12.0, 16.0, 16.0));
+            ctx.flush();
+
+            let mut resources = Resources::new();
+            let mut pixmap = solid_pixmap(16, 16, GRAY);
+            ctx.render(&mut pixmap, &mut resources);
+            for y in 0..16 {
+                for x in 0..16 {
+                    let expected = if x < 8 {
+                        red_pixel()
+                    } else if x >= 12 && y >= 12 {
+                        blue_pixel()
+                    } else {
+                        transparent_pixel()
+                    };
+                    assert_eq!(pixmap.sample(x, y), expected, "pixel at ({x}, {y})");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn held_clip_layer_takes_the_clip_paths_it_was_pushed_under() {
+        for mut ctx in clip_test_contexts() {
+            // The layer is pushed under the clip path, which is popped before
+            // anything is drawn in it: the layer still clips to both.
+            ctx.push_clip_path(&Rect::new(0.0, 0.0, 8.0, 16.0).to_path(0.1));
+            ctx.push_clip_layer(&Rect::new(0.0, 0.0, 16.0, 8.0).to_path(0.1));
+            ctx.pop_clip_path();
+            ctx.set_paint(RED);
+            ctx.fill_rect(&Rect::new(0.0, 0.0, 16.0, 16.0));
+            ctx.pop_layer();
+            ctx.flush();
+
+            let mut resources = Resources::new();
+            let mut pixmap = solid_pixmap(16, 16, GRAY);
+            ctx.render(&mut pixmap, &mut resources);
+            for y in 0..16 {
+                for x in 0..16 {
+                    let expected = if x < 8 && y < 8 {
+                        red_pixel()
+                    } else {
+                        transparent_pixel()
+                    };
+                    assert_eq!(pixmap.sample(x, y), expected, "pixel at ({x}, {y})");
+                }
+            }
+        }
+    }
+
