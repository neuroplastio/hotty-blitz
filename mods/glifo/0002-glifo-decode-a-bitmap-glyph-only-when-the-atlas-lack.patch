             return None;
         }
-        let width = (f64::from(pixmap.width()) * a).round().max(1.0) as u16;
-        let height = (f64::from(pixmap.height()) * d).round().max(1.0) as u16;
+        let width = (f64::from(width) * a).round().max(1.0) as u16;
+        let height = (f64::from(height) * d).round().max(1.0) as u16;
         Some(Self {
             width,
             height,
