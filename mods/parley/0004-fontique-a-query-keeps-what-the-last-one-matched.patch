+/// The families a query matched and the fonts it loaded from them, kept for
+/// the next query, which matches again only what it asks for differently:
+/// other families, attributes or fallbacks. A text layout makes a query
+/// for its shaping and one for its line metrics, so the many small layouts
+/// of a document (inline blocks, table cells) each paid for the whole
+/// match.
 #[derive(Clone, Default)]
 pub(super) struct QueryState {
     families: Vec<CachedFamily>,
     fallback_families: Vec<CachedFamily>,
+    /// The attributes the kept fonts were loaded for.
+    attributes: Attributes,
+    /// The key `fallback_families` were listed for.
+    fallbacks: Option<FallbackKey>,
+    /// Whether the query under way has set its families and its fallbacks:
+    /// one that has not matches none.
+    families_set: bool,
+    fallbacks_set: bool,
+    /// The shared collection's version the state was made in.
+    version: CounterInt,
 }
 
 impl QueryState {
-    fn clear(&mut self) {
-        self.families.clear();
-        self.fallback_families.clear();
+    fn clear_fonts(&mut self) {
+        for family in &mut self.families {
+            family.clear_fonts();
+        }
+        for family in &mut self.fallback_families {
+            family.clear_fonts();
+        }
+    }
+
+    /// Forgets everything, after the collection changed.
+    pub(super) fn reset(&mut self) {
+        let version = self.version;
+        *self = Self {
+            version,
+            ..Self::default()
+        };
     }
 }
 
