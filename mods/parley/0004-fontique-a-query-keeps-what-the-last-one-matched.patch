+#[cfg(test)]
+mod tests {
+    use alloc::sync::Arc;
+    use alloc::vec::Vec;
+
+    use crate::{
+        Attributes, Blob, Collection, CollectionOptions, FamilyId, FontInfoOverride, FontWeight,
+        QueryFamily, SourceCache,
+    };
+
+    const ROBOTO: &[u8] =
+        include_bytes!("../../../parley_dev/assets/fonts/roboto_fonts/Roboto-Regular.ttf");
+    const ARIMO: &[u8] =
+        include_bytes!("../../../parley_dev/assets/fonts/arimo_fonts/Arimo-VariableFont_wght.ttf");
+
+    fn collection() -> Collection {
+        Collection::new(CollectionOptions {
+            shared: false,
+            system_fonts: false,
+        })
+    }
+
+    fn register(c: &mut Collection, data: &[u8], over: Option<FontInfoOverride<'_>>) -> FamilyId {
+        c.register_fonts(Blob::new(Arc::new(data.to_vec())), over)[0].0
+    }
+
+    /// The first font a query for `families` at `weight` yields: its family
+    /// and its index there.
+    fn first(
+        c: &mut Collection,
+        cache: &mut SourceCache,
+        families: &[&str],
+        weight: Option<FontWeight>,
+    ) -> Option<(FamilyId, usize)> {
+        let mut query = c.query(cache);
+        query.set_families(families.iter().copied().map(QueryFamily::Named));
+        if let Some(weight) = weight {
+            query.set_attributes(Attributes {
+                weight,
+                ..Attributes::default()
+            });
+        }
+        query.first_available_font().map(|font| font.family)
+    }
+
+    #[test]
+    fn a_query_matches_what_the_last_one_did_and_no_more() {
+        let mut c = collection();
+        let mut cache = SourceCache::default();
+        let roboto = register(&mut c, ROBOTO, None);
+        let found: Vec<_> = (0..3)
+            .map(|_| first(&mut c, &mut cache, &["Roboto"], None))
+            .collect();
+        assert_eq!(found, [Some((roboto, 0)); 3]);
+        let mut query = c.query(&mut cache);
+        assert!(
+            query.first_available_font().is_none(),
+            "a query that names no family matches none, whatever the last one did"
+        );
+    }
+
+    #[test]
+    fn a_query_matches_at_its_own_attributes() {
+        let mut c = collection();
+        let mut cache = SourceCache::default();
+        let roboto = register(&mut c, ROBOTO, None);
+        let bold = FontInfoOverride {
+            family_name: Some("Roboto"),
+            weight: Some(FontWeight::BOLD),
+            ..Default::default()
+        };
+        assert_eq!(register(&mut c, ARIMO, Some(bold)), roboto);
+        let bold = Some(FontWeight::BOLD);
+        assert_eq!(
+            first(&mut c, &mut cache, &["Roboto"], bold),
+            Some((roboto, 1))
+        );
+        assert_eq!(
+            first(&mut c, &mut cache, &["Roboto"], None),
+            Some((roboto, 0)),
+            "after a bold query, one at the default weight takes the regular face"
+        );
+        assert_eq!(
+            first(&mut c, &mut cache, &["Roboto"], bold),
+            Some((roboto, 1))
+        );
+    }
+
+    #[test]
+    fn a_font_registered_after_a_query_is_one_the_next_query_sees() {
+        let mut c = collection();
+        let mut cache = SourceCache::default();
+        let roboto = register(&mut c, ROBOTO, None);
+        let bold = Some(FontWeight::BOLD);
+        assert_eq!(
+            first(&mut c, &mut cache, &["Roboto"], bold),
+            Some((roboto, 0)),
+            "the regular face, made bold, while it is the only one"
+        );
+        let face = FontInfoOverride {
+            family_name: Some("Roboto"),
+            weight: Some(FontWeight::BOLD),
+            ..Default::default()
+        };
+        register(&mut c, ARIMO, Some(face));
+        assert_eq!(
+            first(&mut c, &mut cache, &["Roboto"], bold),
+            Some((roboto, 1))
+        );
+    }
+}
