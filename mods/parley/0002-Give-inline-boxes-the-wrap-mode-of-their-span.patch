+                    // There is a soft wrap opportunity on each side of an inline box. As with
+                    // text, the content before the box decides whether the line may break
+                    // before it, and the box's own span whether it may break after it, so the
+                    // boxes of a `nowrap` span stay together.
+                    let wrap_before = self.state.line.text_wrap_mode == TextWrapMode::Wrap;
+                    let wrap_after = text_wrap_mode == TextWrapMode::Wrap;
 
-                        // There is a soft wrap opportunity after an inline box, unless wrapping
-                        // is disabled
-                        if self.state.line.text_wrap_mode == TextWrapMode::Wrap {
+                    // If the box fits on the current line then simply move on to the next item
+                    if next_x <= max_advance {
+                        if wrap_before && self.state.line.x != 0.0 {
+                            self.state.mark_line_break_opportunity();
+                        }
+                        self.append_layout_inline_box(item.index, next_x);
+                        self.state.line.text_wrap_mode = text_wrap_mode;
+                        if wrap_after {
+                            self.state.mark_line_break_opportunity();
+                        }
+                    }
+                    // If we're at the start of the line, this box will never fit, so consume it and accept the overflow.
+                    else if self.state.line.x == 0.0 {
+                        self.append_layout_inline_box(item.index, next_x);
+                        self.state.line.text_wrap_mode = text_wrap_mode;
+                        if wrap_after {
+                            return self.start_new_line(
+                                BreakReason::Emergency,
