-        if wraps && followed_by_inline_content {
+        self.text_wrap_mode = text_wrap_mode;
+        if text_wrap_mode == TextWrapMode::Wrap && followed_by_inline_content {
             self.soft_break(true);
             // Nothing has been placed on the new line yet.
             self.line_has_content = false;
diff --git a/parley/src/layout/line_break.rs b/parley/src/layout/line_break.rs
