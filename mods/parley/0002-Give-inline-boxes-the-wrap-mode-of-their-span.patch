-    fn measure_inline_box(&mut self, inline_box: &InlineBox, followed_by_inline_content: bool) {
+    /// `text_wrap_mode` is the mode of the span containing the box. As with text, the content
+    /// before the box decides whether the line may break before it, and the box's own span
+    /// whether it may break after it: boxes in a `nowrap` span stay together, wherever the
+    /// paragraph's text sets the mode.
+    fn measure_inline_box(
+        &mut self,
+        inline_box: &InlineBox,
+        text_wrap_mode: TextWrapMode,
+        followed_by_inline_content: bool,
+    ) {
         // Inline boxes have soft wrap opportunities on both sides.
-        let wraps = self.text_wrap_mode == TextWrapMode::Wrap;
-        if wraps {
+        if self.text_wrap_mode == TextWrapMode::Wrap {
             self.soft_break(self.line_has_content);
         }
